+package torrstor
+
+import (
+	"errors"
+	"io"
+	"testing"
+
+	"github.com/anacrolix/torrent"
+	"github.com/anacrolix/torrent/metainfo"
+)
+
+const (
+	prefetchCapacityMiB = int64(1 << 20)
+	prefetchRequestA    = "11111111-1111-4111-8111-111111111111"
+	prefetchRequestB    = "22222222-2222-4222-8222-222222222222"
+	capacityReadStart   = 4*prefetchCapacityMiB + 128*(1<<10)
+	capacityReadEnd     = 12 * prefetchCapacityMiB
+)
+
+func capacityFixture(t *testing.T) (*torrent.File, *Cache, PlaybackWindow) {
+	t.Helper()
+	file, cache := playbackTestTorrent(t, 16*prefetchCapacityMiB, 4*prefetchCapacityMiB)
+	window := setWindow(t, cache, "capacity", 4*prefetchCapacityMiB, capacityReadStart, 16*prefetchCapacityMiB, 1)
+	if window.Upper != 8*prefetchCapacityMiB {
+		t.Fatalf("capacity fixture window %+v", window)
+	}
+	seedRetainedPayloads(t, cache, 4, 5, 6, 7)
+	return file, cache, window
+}
+
+func capacityReader(t *testing.T, file *torrent.File, cache *Cache, requestID string, start, end int64) *Reader {
+	t.Helper()
+	reader := cache.NewPrefetchReaderAt(file, "capacity", start)
+	t.Cleanup(func() { cache.CloseReader(reader) })
+	reader.SetPrefetchRequest(requestID, start, end)
+	if _, err := reader.Seek(start, io.SeekStart); err != nil {
+		t.Fatal(err)
+	}
+	return reader
+}
+
+// Read the exact resident allowance first. Only the following nonempty Read is
+// stopped by policy; reaching the same offset alone is not terminal proof.
+func reachCapacityEOF(t *testing.T, reader *Reader, start, upper int64) int64 {
+	t.Helper()
+	data := make([]byte, upper-start)
+	if n, err := io.ReadFull(reader, data); err != nil || int64(n) != upper-start {
+		t.Fatalf("resident quota read: n=%d err=%v", n, err)
+	}
+	if stop := reader.PrefetchCapacityStop(); stop != nil {
+		t.Fatalf("merely reaching the quota captured an unobserved EOF: %+v", stop)
+	}
+	reader.Read(nil)
+	if stop := reader.PrefetchCapacityStop(); stop != nil {
+		t.Fatalf("an empty read fabricated capacity EOF proof: %+v", stop)
+	}
+	if n, err := reader.Read(make([]byte, 1)); n != 0 || !errors.Is(err, io.EOF) {
+		t.Fatalf("actual capacity boundary: n=%d err=%v", n, err)
+	}
+	return upper - start
+}
+
+func TestPrefetchCapacityOtherConsumerShrinksQuotaWithoutOwnRevision(t *testing.T) {
+	const mib = prefetchCapacityMiB
+	file, cache := playbackTestTorrent(t, 32*mib, 8*mib)
+	initial := setWindow(t, cache, "capacity", 4*mib, capacityReadStart, 32*mib, 1)
+	if initial.Upper != 12*mib {
+		t.Fatalf("initial eight-piece window %+v", initial)
+	}
+	seedRetainedPayloads(t, cache, 4, 5, 6, 7, 8, 9, 10, 11)
+	const requestedEnd = 24 * mib
+	reader := capacityReader(t, file, cache, prefetchRequestA, capacityReadStart, requestedEnd)
+	first := make([]byte, 32<<10)
+	if n, err := reader.Read(first); err != nil || n != len(first) {
+		t.Fatalf("initial body prefix: n=%d err=%v", n, err)
+	}
+	setWindow(t, cache, "another-consumer", 20*mib, 20*mib, 32*mib, 1)
+	cache.muPolicy.Lock()
+	shrunk := cache.windows["capacity"].PlaybackWindow
+	cache.muPolicy.Unlock()
+	if shrunk.Upper >= initial.Upper || shrunk.Revision != initial.Revision {
+		t.Fatalf("fixture must reduce the quota without changing its owner's revision: before=%+v after=%+v", initial, shrunk)
+	}
+	// A subsequent finite suffix can have been planned from the old ACK at
+	// exactly the newly reduced frontier. It must report a real zero-byte
+	// quota EOF, even though this consumer's revision did not change. Do not
+	// drain toward a moving frontier here: active read-ahead itself changes
+	// the fair-share allocation and is exercised separately above.
+	reader.SetPrefetchRequest(prefetchRequestB, shrunk.Upper, requestedEnd)
+	if _, err := reader.Seek(shrunk.Upper, io.SeekStart); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := reader.Read(make([]byte, 1)); n != 0 || !errors.Is(err, io.EOF) {
+		t.Fatalf("newly reduced frontier: n=%d err=%v", n, err)
+	}
+	assertCapacityStop(t, reader.PrefetchCapacityStop(), prefetchRequestB, shrunk.Upper, requestedEnd, shrunk.Upper, 1)
+	if !cache.RecordPrefetchStop(reader, 0) {
+		t.Fatal("another consumer's quota reduction was not publishable as an actual capacity stop")
+	}
+	ack := setWindow(t, cache, "capacity", 4*mib, capacityReadStart, 32*mib, 2)
+	assertCapacityStop(t, ack.PrefetchStop, prefetchRequestB, shrunk.Upper, requestedEnd, shrunk.Upper, 1)
+}
+
+func assertCapacityStop(t *testing.T, stop *PlaybackPrefetchStop, requestID string, start, end, next int64, revision uint64) {
+	t.Helper()
+	if stop == nil || stop.Reason != "capacity" || stop.RequestID != requestID || stop.FileIndex != 1 ||
+		stop.RangeStart != start || stop.RangeEnd != end || stop.NextOffset != next || stop.Revision != revision {
+		t.Fatalf("capacity stop %+v; want id=%q file=1 range=[%d,%d) next=%d revision=%d", stop, requestID, start, end, next, revision)
+	}
+}
