+				t.Fatalf("settled ACK: %+v %v", settled, err)
+			}
+			if _, err := f.cache.BeginPlaybackSeek(1, 0, f.length, "capacity-http", 2); err == nil {
+				t.Fatal("late seek marker superseded settled window")
+			}
+			t.Logf("full=%d nearby_offline=true far_target=%d repeated_offline_reads=3 final_cache=%d cap=%d", f.quota, 160*piece, f.cache.GetState().Filled, f.quota)
