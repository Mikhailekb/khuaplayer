+func TestPlaybackManagedReaderSixtySecondParkingRetainsPausedPayloadWithoutDownloads(t *testing.T) {
+	const mib = 1 << 20
+	file, c := playbackTestTorrent(t, 64*mib, 12*mib)
+	const current = 24*mib + 7*mib/8
+	setWindow(t, c, "paused", current-2*mib, current, 64*mib, 1)
+	retained := seedRetainedPayloads(t, c, 24, 25, 29)
+	readers := []*Reader{c.NewPlaybackReader(file, "paused"), c.NewPlaybackReader(file, "paused")}
+	for _, reader := range readers {
+		if _, err := reader.Seek(current, io.SeekStart); err != nil {
+			t.Fatal(err)
+		}
+		reader.mu.Lock()
+		reader.lastAccess = time.Now().Add(-61 * time.Second).Unix()
+		reader.mu.Unlock()
+	}
+	// Exercise the actual 60-second idle path without a wall-clock minute.
+	c.cleanPiecesSync()
+	for _, reader := range readers {
+		if reader.active() {
+			t.Fatal("expired idle managed reader was not parked")
+		}
+	}
+	assertPausedWindow(t, c, "paused", 1)
+	assertRetainedPayloads(t, c, retained)
+	assertNoMissingPiecePriority(t, c)
+	// Parking must also preserve the next logical read position. In particular,
+	// parking at EOF cannot be fixed merely by changing the parking Seek target.
+	got := make([]byte, 64)
+	if n, err := readers[0].Read(got); err != nil || n != len(got) || !bytes.Equal(got, bytes.Repeat([]byte{25}, len(got))) {
+		t.Fatalf("parked managed reader did not resume at its retained payload: n=%d err=%v", n, err)
+	}
+	for _, reader := range readers {
+		c.CloseReader(reader)
+	}
+	c.cleanPiecesSync()
+	assertRetainedPayloads(t, c, retained)
+	assertNoMissingPiecePriority(t, c)
+}
