+	const m = int64(1 << 20)
+	length := 16*m + 100
+	info := metainfo.Info{Name: "aux-files", PieceLength: m, Pieces: make([]byte, 20*int((length+m-1)/m)), Files: []metainfo.FileInfo{{Length: 12*m + 100, Path: []string{"first.mp4"}}, {Length: 4 * m, Path: []string{"next.mp4"}}}}
+	files, c := playbackTestTorrentFiles(t, info, 16*m)
+	f := files[0]
+	if _, e := c.UpdatePlaybackWindow(1, f.Offset(), f.Length(), "main", 4*m, 4*m, 5*m, 1, false); e != nil {
+		t.Fatal(e)
+	}
+	r := c.NewPlaybackReaderAt(f, "main", f.Length()-2, f.Length())
+	r.beginRead(2)
+	seedRetainedPayloads(t, c, 12)
+	r.endIO()
+	readAuxiliary(t, r, 2)
+	c.CloseReader(r)
+	c.cleanPiecesSync()
+	if ids := auxiliaryIDs(c); len(ids) != 1 || ids[0] != 12 {
+		t.Fatalf("cross-file speculative pins %v", ids)
+	}
+	if p := c.torrent.PieceState(13).Priority; p != torrent.PiecePriorityNone {
+		t.Fatalf("prefetched next file %d", p)
+	}
+}
+func TestAuxiliaryFileChangeAndReleaseDropOwnerPins(t *testing.T) {
+	const m = int64(1 << 20)
+	info := metainfo.Info{Name: "aux-replace", PieceLength: m, Pieces: make([]byte, 20*128), Files: []metainfo.FileInfo{{Length: 64 * m, Path: []string{"a.mp4"}}, {Length: 64 * m, Path: []string{"b.mp4"}}}}
+	files, c := playbackTestTorrentFiles(t, info, 32*m)
+	f := files[0]
+	if _, e := c.UpdatePlaybackWindow(1, 0, f.Length(), "main", 32*m, 32*m, 64*m, 1, false); e != nil {
+		t.Fatal(e)
+	}
+	r := c.NewPlaybackReaderAt(f, "main", 4*m, 4*m+64)
+	r.beginRead(64)
+	seedRetainedPayloads(t, c, 4, 5)
+	r.endIO()
+	readAuxiliary(t, r, 64)
+	c.CloseReader(r)
+	f = files[1]
+	if _, e := c.UpdatePlaybackWindow(2, f.Offset(), f.Length(), "main", 16*m, 16*m, 64*m, 2, false); e != nil {
+		t.Fatal(e)
+	}
+	c.cleanPiecesSync()
+	if len(auxiliaryIDs(c)) != 0 || c.pieces[4].snapshot().size != 0 {
+		t.Fatal("old file's auxiliary payload remained pinned")
+	}
+	r = c.NewPlaybackReaderAt(f, "main", 4*m, 4*m+64)
+	r.beginRead(64)
+	seedRetainedPayloads(t, c, 68)
+	r.endIO()
+	readAuxiliary(t, r, 64)
+	c.CloseReader(r)
+	if _, e := c.UpdatePlaybackWindow(0, 0, 0, "main", 0, 0, 0, 3, true); e != nil {
+		t.Fatal(e)
+	}
+	c.cleanPiecesSync()
+	if len(auxiliaryIDs(c)) != 0 || c.pieces[68].snapshot().size != 0 {
+		t.Fatal("released consumer retained auxiliary payload")
+	}
+}
diff --git a/server/torr/storage/torrstor/playback_background.go b/server/torr/storage/torrstor/playback_background.go
new file mode 100644
--- /dev/null
+++ b/server/torr/storage/torrstor/playback_background.go
@@ -0,0 +1,318 @@
+package torrstor
+
+import (
+	"errors"
+	"sort"
+
+	"github.com/anacrolix/torrent"
+)
+
+var (
+	ErrInvalidBackgroundRequest   = errors.New("invalid background range")
+	ErrBackgroundOwnerUnavailable = errors.New("background playback owner unavailable")
+	ErrBackgroundRetired          = errors.New("background job has been released")
+	ErrBackgroundLimit            = errors.New("background job limit reached")
+)
+
+const maxBackgroundLanes = 8
+const maxBackgroundRetirements = 128
+const maxBackgroundReadBytes = int64(256 << 10)
+
+// Background lanes own no media-time window. Only bytes delivered by finite
+// requests establish a tiny working set for sparse subtitle/thumbnail reads.
+// The primary parent and its epoch own the lane; normal paused ACKs preserve it.
+// All lane state is protected by Cache.muPolicy.
+type backgroundLane struct {
+	parent                 string
+	epoch                  uint64
+	fileOffset, fileLength int64
+	pieces                 map[int]uint64
+}
+
+func validBackgroundToken(value string) bool {
+	if len(value) == 0 || len(value) > 128 {
+		return false
+	}
+	for _, b := range []byte(value) {
+		if !(b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9' || b == '_' || b == '-') {
+			return false
+		}
+	}
+	return true
+}
+
+func (c *Cache) backgroundParentLocked(parent string, fileOffset, fileLength int64) (*playbackWindow, bool) {
+	w, ok := c.windows[parent]
+	return w, ok && !w.Seeking && w.auxiliaryEpoch != 0 && w.fileOffset == fileOffset && w.fileLength == fileLength
+}
+
+// NewBackgroundPlaybackReaderAt never falls back to an unmanaged percentage-
+// readahead reader. It starts dormant at EOF and activates only the finite body.
+func (c *Cache) NewBackgroundPlaybackReaderAt(file *torrent.File, consumer, parent string, start, end int64) (*Reader, error) {
+	if c == nil || file == nil || !validBackgroundToken(consumer) || !validBackgroundToken(parent) || consumer == parent || start < 0 || end <= start || end > file.Length() || end-start > maxBackgroundReadBytes {
+		return nil, ErrInvalidBackgroundRequest
+	}
+	c.muPolicy.Lock()
+	_, owned := c.backgroundParentLocked(parent, file.Offset(), file.Length())
+	closed := c.isClosed.Load()
+	collision := c.windows[consumer] != nil
+	budget := c.backgroundBudgetLocked()
+	c.muPolicy.Unlock()
+	if closed {
+		return nil, ErrPlaybackCacheClosed
+	}
+	if !owned {
+		return nil, ErrBackgroundOwnerUnavailable
+	}
+	if collision {
+		return nil, ErrInvalidBackgroundRequest
+	}
+	if budget == 0 {
+		return nil, ErrBackgroundLimit
+	}
+	r := newReaderAt(file, c, consumer, start, end, false, true)
+	c.muPolicy.Lock()
+	r.mu.Lock()
+	w, owned := c.backgroundParentLocked(parent, file.Offset(), file.Length())
+	var err error
+	if c.isClosed.Load() {
+		err = ErrPlaybackCacheClosed
+	} else if !owned {
+		err = ErrBackgroundOwnerUnavailable
+	} else if c.windows[consumer] != nil {
+		err = ErrInvalidBackgroundRequest
+	} else if _, retired := c.backgroundRetired[consumer]; retired {
+		err = ErrBackgroundRetired
+	} else if old := c.backgrounds[consumer]; old != nil && (old.parent != parent || old.fileOffset != file.Offset() || old.fileLength != file.Length()) {
+		err = ErrInvalidBackgroundRequest
+	} else if c.backgrounds[consumer] == nil && len(c.backgrounds) >= maxBackgroundLanes {
+		err = ErrBackgroundLimit
+	} else if len(c.backgroundRetired)+len(c.backgrounds) >= maxBackgroundRetirements && c.backgrounds[consumer] == nil {
+		err = ErrBackgroundLimit
+	}
+	if err == nil {
+		if c.backgrounds == nil {
+			c.backgrounds = make(map[string]*backgroundLane)
+		}
+		lane := c.backgrounds[consumer]
+		if lane == nil || lane.epoch != w.auxiliaryEpoch {
+			lane = &backgroundLane{parent: parent, epoch: w.auxiliaryEpoch, fileOffset: file.Offset(), fileLength: file.Length(), pieces: make(map[int]uint64)}
+			c.backgrounds[consumer] = lane
+		}
+		r.backgroundParent = parent
+		r.backgroundEpoch = lane.epoch
+		r.readahead = 0
+		r.managed = true
+	}
+	r.mu.Unlock()
+	c.muPolicy.Unlock()
+	if err != nil {
+		c.CloseReader(r)
+		return nil, err
+	}
+	return r, nil
+}
+
+// Caller holds muPolicy and r.mu. A new GET can acquire a new seek epoch, but
+// an old in-flight response cannot recreate pins in the new parent's epoch.
+func (c *Cache) backgroundReaderValidLocked(r *Reader) bool {
+	if r.backgroundParent == "" {
+		return true
+	}
+	if c.isClosed.Load() || r.file == nil || r.isClosed {
+		return false
+	}
+	if c.windows[r.consumer] != nil {
+		return false
+	}
+	lane := c.backgrounds[r.consumer]
+	w, ok := c.backgroundParentLocked(r.backgroundParent, r.file.Offset(), r.file.Length())
+	return ok && lane != nil && lane.parent == r.backgroundParent && lane.epoch == r.backgroundEpoch && lane.epoch == w.auxiliaryEpoch
+}
+
+// A primary seek revokes optional pins, but does not turn a valid independent
+// whole-file producer's in-flight body into a transport failure. Native read
+// admission cancels/yields that body first; it may also finish under its bounded
+// current-reader protection. Source removal and explicit job release do cancel.
+func (c *Cache) backgroundReaderCanReadLocked(r *Reader) bool {
+	if r.backgroundParent == "" {
+		return true
+	}
+	if c.isClosed.Load() || r.file == nil || r.isClosed {
+		return false
+	}
+	if c.windows[r.consumer] != nil {
+		return false
+	}
+	if _, retired := c.backgroundRetired[r.consumer]; retired {
+		return false
+	}
+	w := c.windows[r.backgroundParent]
+	return w != nil && w.fileOffset == r.file.Offset() && w.fileLength == r.file.Length()
+}
+
+func (c *Cache) recordBackgroundReadLocked(r *Reader, first, end int64) bool {
+	if r.backgroundParent == "" || !r.finiteForeground || r.prefetch || first < 0 || end <= first || !c.backgroundReaderValidLocked(r) {
+		return false
+	}
+	lane := c.backgrounds[r.consumer]
+	c.backgroundClock++
+	touch := c.backgroundClock
+	changed := false
+	for id := r.getPieceNum(first); id <= r.getPieceNum(end-1); id++ {
+		if _, exists := lane.pieces[id]; !exists {
+			changed = true
+		}
+		lane.pieces[id] = touch
+	}
+	return changed
+}
+
+func (c *Cache) backgroundBudgetLocked() int64 {
+	if c.pieceLength <= 0 || c.capacity < c.pieceLength {
+		return 0
+	}
+	limit := min(c.capacity/16, int64(16<<20))
+	return min(c.capacity, max(c.pieceLength, limit/c.pieceLength*c.pieceLength))
+}
+
+// Run before the planner's empty-window early return too. No wall-clock expiry
+// is used: a user pause preserves an otherwise valid parent's small working set.
+func (c *Cache) pruneBackgroundsLocked() {
+	for consumer, lane := range c.backgrounds {
+		w, ok := c.backgroundParentLocked(lane.parent, lane.fileOffset, lane.fileLength)
+		if !ok || w.auxiliaryEpoch != lane.epoch || c.windows[consumer] != nil {
+			delete(c.backgrounds, consumer)
+		}
+	}
+	for consumer, parent := range c.backgroundRetired {
+		if c.windows[parent] == nil {
+			delete(c.backgroundRetired, consumer)
+		}
+	}
+	for _, r := range c.readersSnapshot() {
+		r.mu.Lock()
+		if r.backgroundParent != "" && !c.backgroundReaderCanReadLocked(r) && r.cancelRead != nil {
+			r.cancelRead()
+		}
+		r.mu.Unlock()
+	}
+}
+
+func (c *Cache) retainBackgroundLocked(kept map[int]bool, used *int64) {
+	type candidate struct {
+		id    int
+		touch uint64
+	}
+	newest := make(map[int]uint64)
+	for _, lane := range c.backgrounds {
+		ids := make([]int, 0, len(lane.pieces))
+		for id := range lane.pieces {
+			ids = append(ids, id)
+		}
+		sort.Slice(ids, func(i, j int) bool {
+			if lane.pieces[ids[i]] != lane.pieces[ids[j]] {
+				return lane.pieces[ids[i]] > lane.pieces[ids[j]]
+			}
+			return ids[i] < ids[j]
+		})
+		// No single producer can retain more than its two most recent pieces.
+		for n, id := range ids {
+			if n >= 2 {
+				delete(lane.pieces, id)
+				continue
+			}
+			newest[id] = max(newest[id], lane.pieces[id])
+		}
+	}
+	ordered := make([]candidate, 0, len(newest))
+	for id, touch := range newest {
+		ordered = append(ordered, candidate{id, touch})
+	}
+	sort.Slice(ordered, func(i, j int) bool {
+		if ordered[i].touch != ordered[j].touch {
+			return ordered[i].touch > ordered[j].touch
+		}
+		return ordered[i].id < ordered[j].id
+	})
+	allowed := make(map[int]bool)
+	remaining := c.backgroundBudgetLocked()
+	if *used <= c.capacity {
+		for _, item := range ordered {
+			cost := c.pieceBytes(item.id)
+			if cost <= 0 || cost > remaining || (!kept[item.id] && cost > c.capacity-*used) {
+				continue
+			}
+			remaining -= cost
+			allowed[item.id] = true
+			if !kept[item.id] {
+				kept[item.id] = true
+				*used += cost
+			}
+		}
+	}
+	for _, lane := range c.backgrounds {
+		for id := range lane.pieces {
+			if !allowed[id] {
+				delete(lane.pieces, id)
+			}
+		}
+	}
+}
+
+func (c *Cache) backgroundPieceIDsLocked() []int {
+	ids := make(map[int]bool)
+	for _, lane := range c.backgrounds {
+		for id := range lane.pieces {
+			ids[id] = true
+		}
+	}
+	ret := make([]int, 0, len(ids))
+	for id := range ids {
+		ret = append(ret, id)
+	}
+	sort.Ints(ret)
+	return ret
+}
+
+// Explicit job completion/cancellation retires the token until its parent closes.
+// Normal seek pauses should not call this; a subsequent GET can use the same
+// nonretired token to bind to the valid post-seek parent epoch.
+func (c *Cache) RemoveBackgroundLane(consumer, parent string) error {
+	if c == nil || !validBackgroundToken(consumer) || !validBackgroundToken(parent) || consumer == parent {
+		return ErrInvalidBackgroundRequest
+	}
+	c.muPolicy.Lock()
+	if c.windows[consumer] != nil {
+		c.muPolicy.Unlock()
+		return ErrInvalidBackgroundRequest
+	}
+	if lane := c.backgrounds[consumer]; lane != nil && lane.parent != parent {
+		c.muPolicy.Unlock()
+		return ErrInvalidBackgroundRequest
+	}
+	if retiredParent, exists := c.backgroundRetired[consumer]; exists && retiredParent != parent {
+		c.muPolicy.Unlock()
+		return ErrInvalidBackgroundRequest
+	}
+	if c.windows[parent] != nil {
+		if c.backgroundRetired == nil {
+			c.backgroundRetired = make(map[string]string)
+		}
+		// Each live lane reserves a future retirement slot. Even at the bound,
+		// finishing/cancelling an existing job must always release its pins.
+		_, alreadyRetired := c.backgroundRetired[consumer]
+		_, live := c.backgrounds[consumer]
+		if !alreadyRetired && !live && len(c.backgroundRetired)+len(c.backgrounds) >= maxBackgroundRetirements {
+			c.muPolicy.Unlock()
+			return ErrBackgroundLimit
+		}
+		c.backgroundRetired[consumer] = parent
+	}
+	delete(c.backgrounds, consumer)
+	c.pruneBackgroundsLocked()
+	c.replanWindowsLocked()
+	c.muPolicy.Unlock()
+	c.cleanPiecesSync()
+	return nil
+}
diff --git a/server/torr/storage/torrstor/playback_background_test.go b/server/torr/storage/torrstor/playback_background_test.go
new file mode 100644
--- /dev/null
+++ b/server/torr/storage/torrstor/playback_background_test.go
@@ -0,0 +1,297 @@
+package torrstor
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/anacrolix/torrent"
+)
+
+func TestBackgroundLegacyUnregisteredControlLosesBytes(t *testing.T) {
+	const m = int64(1 << 20)
+	f, c := playbackTestTorrent(t, 64*m, 16*m)
+	setWindow(t, c, "main", 32*m, 32*m, 64*m, 1)
+	seedRetainedPayloads(t, c, 2)
+	legacy := c.NewPlaybackReaderAt(f, "unregistered-old-producer", 2*m+64, 2*m+128)
+	readAuxiliary(t, legacy, 64)
+	c.CloseReader(legacy)
+	c.cleanPiecesSync()
+	if c.pieces[2].snapshot().size != 0 {
+		t.Fatal("old-control request unexpectedly retained out-of-window bytes")
+	}
+	legacy = c.NewPlaybackReaderAt(f, "unregistered-old-producer", 2*m+256, 2*m+320)
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	legacy.readContext = ctx
+	n, err := legacy.Read(make([]byte, 64))
+	c.CloseReader(legacy)
+	if n != 0 || err == nil {
+		t.Fatalf("old control no longer demonstrates required redownload: n%d %v", n, err)
+	}
+	t.Log("old unregistered managed lane evicts the first sparse response and cannot reread without a peer")
+}
+
+func backgroundIDs(c *Cache) []int {
+	c.muPolicy.Lock()
+	defer c.muPolicy.Unlock()
+	return c.backgroundPieceIDsLocked()
+}
+
+func newTestBackground(t *testing.T, c *Cache, f *torrent.File, job, parent string, first int64) *Reader {
+	t.Helper()
+	r, err := c.NewBackgroundPlaybackReaderAt(f, job, parent, first, first+64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r
+}
+
+func TestBackgroundFiniteReadRetainsSparseBytesAcrossPausedACKs(t *testing.T) {
+	const m = int64(1 << 20)
+	f, c := playbackTestTorrent(t, 64*m, 16*m)
+	setWindow(t, c, "main", 32*m, 32*m, 64*m, 1)
+	seedRetainedPayloads(t, c, 2)
+	r := newTestBackground(t, c, f, "subtitle-job", "main", 2*m+64)
+	if r.Readahead() != 0 {
+		t.Fatal("background requested percentage readahead")
+	}
+	if b := readAuxiliary(t, r, 64); !bytes.Equal(b, bytes.Repeat([]byte{3}, 64)) {
+		t.Fatal("wrong background bytes")
+	}
+	c.CloseReader(r)
+	c.cleanPiecesSync()
+	for rev := uint64(2); rev <= 5; rev++ {
+		setWindow(t, c, "main", 32*m, 32*m, 64*m, rev)
+		c.cleanPiecesSync()
+	}
+	if ids := backgroundIDs(c); len(ids) != 1 || ids[0] != 2 {
+		t.Fatalf("paused working set %v", ids)
+	}
+	r = newTestBackground(t, c, f, "subtitle-job", "main", 2*m+256)
+	readAuxiliary(t, r, 64) // No peers exist: this must use the retained piece.
+	c.CloseReader(r)
+	c.muPolicy.Lock()
+	w := c.windows["main"]
+	if len(c.windows) != 1 || w.Current != 32*m || w.requestedLower != 32*m || w.requestedUpper != 64*m || w.Revision != 5 {
+		t.Fatal("background mutated the parent's requested window")
+	}
+	c.muPolicy.Unlock()
+	if c.GetState().Filled > c.capacity {
+		t.Fatal("background exceeded global cache capacity")
+	}
+	t.Log("successive sparse requests and paused ACKs retain the same bytes without peers")
+}
+
+func TestBackgroundGlobalLRUAndPerLaneBound(t *testing.T) {
+	const m = int64(1 << 20)
+	f, c := playbackTestTorrent(t, 128*m, 32*m)
+	setWindow(t, c, "main", 64*m, 64*m, 128*m, 1)
+	for _, id := range []int{2, 3, 4} {
+		seedRetainedPayloads(t, c, id)
+		r := newTestBackground(t, c, f, "subtitles", "main", int64(id)*m+64)
+		readAuxiliary(t, r, 64)
+		c.CloseReader(r)
+		c.cleanPiecesSync()
+	}
+	ids := backgroundIDs(c)
+	if len(ids) != 2 || ids[0] != 3 || ids[1] != 4 {
+		t.Fatalf("per-lane LRU %v", ids)
+	}
+	seedRetainedPayloads(t, c, 8)
+	r := newTestBackground(t, c, f, "previews", "main", 8*m+64)
+	readAuxiliary(t, r, 64)
+	c.CloseReader(r)
+	c.cleanPiecesSync()
+	ids = backgroundIDs(c)
+	if len(ids) != 2 || ids[0] != 4 || ids[1] != 8 {
+		t.Fatalf("global budget was multiplied by producer count: %v", ids)
+	}
+	if c.pieces[3].snapshot().size != 0 {
+		t.Fatal("evicted background piece remained pinned")
+	}
+	if c.GetState().Filled > c.capacity {
+		t.Fatal("global allocation exceeds capacity")
+	}
+}
+
+func TestBackgroundSeekRevokesPinsButLetsValidBodyFinish(t *testing.T) {
+	const m = int64(1 << 20)
+	f, c := playbackTestTorrent(t, 64*m, 16*m)
+	setWindow(t, c, "main", 32*m, 32*m, 64*m, 1)
+	seedRetainedPayloads(t, c, 2)
+	r := newTestBackground(t, c, f, "job", "main", 2*m+64)
+	oldEpoch := r.backgroundEpoch
+	r.beginRead(64)
+	if _, e := c.BeginPlaybackSeek(1, 0, f.Length(), "main", 2); e != nil {
+		t.Fatal(e)
+	}
+	if _, e := c.NewBackgroundPlaybackReaderAt(f, "job", "main", 2*m+64, 2*m+128); !errors.Is(e, ErrBackgroundOwnerUnavailable) {
+		t.Fatalf("new GET while parent seeking: %v", e)
+	}
+	if n, e := io.ReadFull(r, make([]byte, 64)); e != nil || n != 64 {
+		t.Fatalf("main seek poisoned independent in-flight body: n=%d %v", n, e)
+	}
+	r.endIO()
+	if len(backgroundIDs(c)) != 0 {
+		t.Fatal("late pre-seek body recreated pins")
+	}
+	c.CloseReader(r)
+	setWindow(t, c, "main", 40*m, 40*m, 64*m, 3)
+	seedRetainedPayloads(t, c, 3)
+	next := newTestBackground(t, c, f, "job", "main", 3*m+64)
+	if next.backgroundEpoch == oldEpoch {
+		t.Fatal("post-seek GET did not acquire new epoch")
+	}
+	readAuxiliary(t, next, 64)
+	c.CloseReader(next)
+	c.cleanPiecesSync()
+	if ids := backgroundIDs(c); len(ids) != 1 || ids[0] != 3 {
+		t.Fatalf("post-seek working set %v", ids)
+	}
+}
+
+func TestBackgroundCleanupRetiresTokenAndParentRemovalReleasesPins(t *testing.T) {
+	const m = int64(1 << 20)
+	f, c := playbackTestTorrent(t, 64*m, 16*m)
+	setWindow(t, c, "main", 32*m, 32*m, 64*m, 1)
+	seedRetainedPayloads(t, c, 2)
+	r := newTestBackground(t, c, f, "job", "main", 2*m+64)
+	readAuxiliary(t, r, 64)
+	if e := c.RemoveBackgroundLane("job", "main"); e != nil {
+		t.Fatal(e)
+	}
+	c.CloseReader(r)
+	if len(backgroundIDs(c)) != 0 {
+		t.Fatal("released job retained raw data pins")
+	}
+	if _, e := c.NewBackgroundPlaybackReaderAt(f, "job", "main", 2*m, 2*m+64); !errors.Is(e, ErrBackgroundRetired) {
+		t.Fatalf("retired token recreated job: %v", e)
+	}
+	if e := c.RemoveBackgroundLane("job", "main"); e != nil {
+		t.Fatalf("cleanup not idempotent: %v", e)
+	}
+	seedRetainedPayloads(t, c, 3)
+	r = newTestBackground(t, c, f, "new-job", "main", 3*m+64)
+	readAuxiliary(t, r, 64)
+	c.CloseReader(r)
+	if _, e := c.UpdatePlaybackWindow(0, 0, 0, "main", 0, 0, 0, 2, true); e != nil {
+		t.Fatal(e)
+	}
+	if len(backgroundIDs(c)) != 0 {
+		t.Fatal("closed parent retained background")
+	}
+	if _, e := c.NewBackgroundPlaybackReaderAt(f, "late", "main", 0, 64); !errors.Is(e, ErrBackgroundOwnerUnavailable) {
+		t.Fatalf("removed parent accepted late read: %v", e)
+	}
+}
+
+func TestBackgroundValidationAndBoundedJobCount(t *testing.T) {
+	const m = int64(1 << 20)
+	f, c := playbackTestTorrent(t, 64*m, 16*m)
+	setWindow(t, c, "main", 32*m, 32*m, 64*m, 1)
+	setWindow(t, c, "other-primary", 48*m, 48*m, 64*m, 1)
+	for _, tt := range []struct {
+		job, parent string
+		first, end  int64
+	}{
+		{"", "main", 0, 64}, {"main", "main", 0, 64}, {"bad?token", "main", 0, 64},
+		{"other-primary", "main", 0, 64}, {"job", "main", -1, 64}, {"job", "main", 0, 0},
+		{"job", "main", 0, (256 << 10) + 1}, {"job", "main", f.Length() - 1, f.Length() + 1},
+	} {
+		if r, e := c.NewBackgroundPlaybackReaderAt(f, tt.job, tt.parent, tt.first, tt.end); !errors.Is(e, ErrInvalidBackgroundRequest) || r != nil {
+			t.Fatalf("accepted invalid request %+v: %v", tt, e)
+		}
+	}
+	for i := 0; i < maxBackgroundLanes; i++ {
+		r := newTestBackground(t, c, f, fmt.Sprintf("job-%d", i), "main", 0)
+		c.CloseReader(r)
+	}
+	if _, e := c.NewBackgroundPlaybackReaderAt(f, "overflow", "main", 0, 64); !errors.Is(e, ErrBackgroundLimit) {
+		t.Fatalf("unbounded job count: %v", e)
+	}
+	if e := c.RemoveBackgroundLane("job-0", "main"); e != nil {
+		t.Fatal(e)
+	}
+	r := newTestBackground(t, c, f, "replacement", "main", 0)
+	c.CloseReader(r)
+}
+
+func TestBackgroundPinsYieldToUnavoidableAllocationPressure(t *testing.T) {
+	c := policyCache(t, 20, 200, 10)
+	setWindow(t, c, "main", 100, 100, 200, 1)
+	c.muPolicy.Lock()
+	w := c.windows["main"]
+	c.backgrounds = map[string]*backgroundLane{"job": {parent: "main", epoch: w.auxiliaryEpoch, fileLength: 200, pieces: map[int]uint64{2: 1}}}
+	kept := map[int]bool{10: true, 11: true, 12: true}
+	used := int64(30)
+	c.retainBackgroundLocked(kept, &used)
+	if len(c.backgrounds["job"].pieces) != 0 || used != 30 {
+		t.Fatal("soft background pins survived hard oversubscription")
+	}
+	c.muPolicy.Unlock()
+}
+
+func TestBackgroundRetirementBoundReservesLiveCleanupSlots(t *testing.T) {
+	const m = int64(1 << 20)
+	f, c := playbackTestTorrent(t, 64*m, 16*m)
+	setWindow(t, c, "main", 32*m, 32*m, 64*m, 1)
+	for i := 0; i < 3; i++ {
+		r := newTestBackground(t, c, f, fmt.Sprintf("live-%d", i), "main", 0)
+		c.CloseReader(r)
+	}
+	c.muPolicy.Lock()
+	c.backgroundRetired = make(map[string]string)
+	for i := 0; i < maxBackgroundRetirements-3; i++ {
+		c.backgroundRetired[fmt.Sprintf("retired-%d", i)] = "main"
+	}
+	c.muPolicy.Unlock()
+	if e := c.RemoveBackgroundLane("never-started", "main"); !errors.Is(e, ErrBackgroundLimit) {
+		t.Fatalf("unknown token consumed a live cleanup slot: %v", e)
+	}
+	for i := 0; i < 3; i++ {
+		if e := c.RemoveBackgroundLane(fmt.Sprintf("live-%d", i), "main"); e != nil {
+			t.Fatalf("cannot retire live job at bound: %v", e)
+		}
+	}
+	c.muPolicy.Lock()
+	if len(c.backgroundRetired) != maxBackgroundRetirements || len(c.backgrounds) != 0 {
+		t.Fatal("retirement budget or live cleanup incorrect")
+	}
+	c.muPolicy.Unlock()
+}
+
+func TestBackgroundConcurrentACKAndCleanup(t *testing.T) {
+	const m = int64(1 << 20)
+	f, c := playbackTestTorrent(t, 64*m, 16*m)
+	setWindow(t, c, "main", 32*m, 32*m, 64*m, 1)
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for rev := uint64(2); rev < 30; rev++ {
+			_, _ = c.UpdatePlaybackWindow(1, 0, f.Length(), "main", 32*m, 32*m, f.Length(), rev, false)
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 24; i++ {
+			job := fmt.Sprintf("cancel-%d", i)
+			r, e := c.NewBackgroundPlaybackReaderAt(f, job, "main", 0, 64)
+			if e == nil {
+				c.CloseReader(r)
+			}
+			_ = c.RemoveBackgroundLane(job, "main")
+		}
+	}()
+	wg.Wait()
+	c.cleanPiecesSync()
+	if len(backgroundIDs(c)) != 0 {
+		t.Fatal("cancelled readers recreated pins")
+	}
+}
diff --git a/server/torr/storage/torrstor/playback_window.go b/server/torr/storage/torrstor/playback_window.go
new file mode 100644
--- /dev/null
+++ b/server/torr/storage/torrstor/playback_window.go
@@ -0,0 +1,550 @@
+package torrstor
+
+import (
+	"errors"
+	"sort"
+)
+
+var (
+	ErrStalePlaybackRevision = errors.New("playback window revision is stale")
+	ErrInvalidPlaybackWindow = errors.New("invalid playback window")
+	ErrPlaybackCacheClosed   = errors.New("playback cache is closed")
+)
+
+// PlaybackWindow offsets are file-relative bytes. Upper is exclusive. Pieces
+// overlapping current are indivisible: their necessary overhang is retained.
+type PlaybackWindow struct {
+	Lower        int64                 `json:"lower"`
+	Current      int64                 `json:"current"`
+	Upper        int64                 `json:"upper"`
+	PieceLength  int64                 `json:"piece_length"`
+	Revision     uint64                `json:"revision"`
+	Seeking      bool                  `json:"seeking,omitempty"`
+	PrefetchStop *PlaybackPrefetchStop `json:"prefetch_stop,omitempty"`
+}
+
+type playbackWindow struct {
+	PlaybackWindow
+	fileIndex                      int
+	fileOffset, fileLength         int64
+	requestedLower, requestedUpper int64
+	seekLower, seekUpper           int64
+	seekDemand                     bool
+	auxiliaryEpoch                 uint64
+	auxiliary                      map[int]auxiliaryPiece
+}
+
+// HasPlaybackWindows reports explicit playback-session ownership. A paused
+// session can have no HTTP readers while retaining its already cached window.
+// This ownership prevents idle expiry without requesting any missing pieces.
+func (c *Cache) HasPlaybackWindows() bool {
+	if c == nil {
+		return false
+	}
+	c.muPolicy.Lock()
+	defer c.muPolicy.Unlock()
+	return !c.isClosed.Load() && len(c.windows) > 0
+}
+
+// UpdatePlaybackWindow installs a consumer's requested range, returning the
+// authoritative, piece-rounded range after sharing the cache's forward budget.
+// Revisions remain in Storage after release/cache close, so late HTTP requests
+// cannot resurrect an older range. A higher revision may reuse a released token.
+func (c *Cache) UpdatePlaybackWindow(fileIndex int, fileOffset, fileLength int64, consumer string, lower, current, upper int64, revision uint64, remove bool) (PlaybackWindow, error) {
+	return c.updatePlaybackWindow(fileIndex, fileOffset, fileLength, consumer, lower, current, upper, revision, remove, false)
+}
+
+// BeginPlaybackSeek releases the previous hard reservation without throwing its
+// payload away. Only actual foreground reads establish provisional byte demand;
+// an estimated timestamp must never destroy an overlapping cached range.
+func (c *Cache) BeginPlaybackSeek(fileIndex int, fileOffset, fileLength int64, consumer string, revision uint64) (PlaybackWindow, error) {
+	return c.updatePlaybackWindow(fileIndex, fileOffset, fileLength, consumer, 0, 0, fileLength, revision, false, true)
+}
+
+func (c *Cache) updatePlaybackWindow(fileIndex int, fileOffset, fileLength int64, consumer string, lower, current, upper int64, revision uint64, remove, seeking bool) (PlaybackWindow, error) {
+	if consumer == "" || revision == 0 || (!remove && (fileIndex <= 0 || fileOffset < 0 || fileLength <= 0 || lower < 0 || lower > current || current < 0 || current >= fileLength || upper <= current || upper > fileLength)) {
+		return PlaybackWindow{}, ErrInvalidPlaybackWindow
+	}
+	c.muPolicy.Lock()
+	if c.isClosed.Load() {
+		c.muPolicy.Unlock()
+		return PlaybackWindow{}, ErrPlaybackCacheClosed
+	}
+	c.storage.muWindows.Lock()
+	revisions := c.storage.windowRevisions[c.hash]
+	if revisions == nil {
+		revisions = make(map[string]uint64)
+		c.storage.windowRevisions[c.hash] = revisions
+	}
+	if revision <= revisions[consumer] {
+		c.storage.muWindows.Unlock()
+		c.muPolicy.Unlock()
+		return PlaybackWindow{}, ErrStalePlaybackRevision
+	}
+	revisions[consumer] = revision
+	c.storage.muWindows.Unlock()
+	c.managedPolicy = true
+	if remove {
+		delete(c.prefetchStops, consumer)
+		delete(c.prefetchRequests, consumer)
+		delete(c.windows, consumer)
+	} else {
+		if old := c.windows[consumer]; old != nil && (old.fileIndex != fileIndex || old.fileOffset != fileOffset || old.fileLength != fileLength) {
+			delete(c.prefetchStops, consumer)
+			delete(c.prefetchRequests, consumer)
+		}
+		if seeking {
+			if old := c.windows[consumer]; old != nil && old.fileIndex == fileIndex && old.fileOffset == fileOffset && old.fileLength == fileLength {
+				lower, current, upper = old.Lower, old.Current, old.Upper
+			}
+			delete(c.prefetchStops, consumer)
+			delete(c.prefetchRequests, consumer)
+		}
+		next := &playbackWindow{PlaybackWindow: PlaybackWindow{Lower: lower, Current: current, Upper: upper, PieceLength: c.pieceLength, Revision: revision, Seeking: seeking}, fileIndex: fileIndex, fileOffset: fileOffset, fileLength: fileLength, requestedLower: lower, requestedUpper: upper, auxiliaryEpoch: revision}
+		if old := c.windows[consumer]; old != nil && old.fileIndex == fileIndex && old.fileOffset == fileOffset && old.fileLength == fileLength {
+			if !old.Seeking && !seeking {
+				next.auxiliaryEpoch = old.auxiliaryEpoch
+			}
+			next.auxiliary = old.auxiliary
+			if seeking {
+				// Preserve only already resident bytes for a nearby seek, without
+				// reviving old download demand or accepting its late completions.
+				for id, entry := range next.auxiliary {
+					if piece := c.getPieces()[id]; piece == nil || piece.snapshot().size == 0 {
+						delete(next.auxiliary, id)
+					} else {
+						entry.epoch = 0
+						next.auxiliary[id] = entry
+					}
+				}
+			}
+		}
+		c.windows[consumer] = next
+	}
+	c.replanWindowsLocked()
+	result := PlaybackWindow{PieceLength: c.pieceLength, Revision: revision}
+	if w := c.windows[consumer]; w != nil {
+		result = c.playbackWindowSnapshotLocked(consumer, w)
+	}
+	stalePrefetchReaders := make([]*Reader, 0)
+	if seeking {
+		for _, r := range c.readersSnapshot() {
+			r.mu.Lock()
+			stale := r.consumer == consumer && r.prefetch
+			r.mu.Unlock()
+			if stale {
+				stalePrefetchReaders = append(stalePrefetchReaders, r)
+			}
+		}
+	}
+	c.muPolicy.Unlock()
+	for _, r := range stalePrefetchReaders {
+		c.CloseReader(r)
+	}
+
+	c.applyReaderReadahead()
+	c.cleanPiecesSync()
+	c.muPolicy.Lock()
+	if w := c.windows[consumer]; w != nil && w.Revision == revision {
+		result = c.playbackWindowSnapshotLocked(consumer, w)
+	}
+	c.muPolicy.Unlock()
+	return result, nil
+}
+
+func (c *Cache) pieceBytes(id int) int64 {
+	length := c.pieceLength
+	if c.totalLength > 0 && int64(id+1)*length > c.totalLength {
+		length = c.totalLength - int64(id)*length
+	}
+	if length < 0 {
+		return 0
+	}
+	return length
+}
+
+func (w *playbackWindow) currentPiece(length int64) int {
+	return int((w.fileOffset + w.Current) / length)
+}
+func (w *playbackWindow) requestedLowerPiece(length int64) int {
+	lower := int((w.fileOffset + w.requestedLower + length - 1) / length)
+	if current := w.currentPiece(length); lower > current {
+		lower = current
+	}
+	return lower
+}
+func (w *playbackWindow) lowerPiece(length int64) int { return int((w.fileOffset + w.Lower) / length) }
+func (w *playbackWindow) endPiece(length int64) int {
+	return int((w.fileOffset + w.Upper - 1) / length)
+}
+
+// muPolicy serializes windows, reader I/O registration and eviction decisions.
+// Hard current/in-flight, unmanaged readers and incomplete pieces are never
+// sacrificed to a nominal capacity. History is shortened to fit. Remaining pieces are assigned forward
+// round-robin, counting pieces shared by several consumers only once.
+func (c *Cache) replanWindowsLocked() {
+	c.pruneBackgroundsLocked()
+	if c.pieceLength <= 0 || len(c.windows) == 0 {
+		c.configureManagedReadersLocked()
+		return
+	}
+	kept := make(map[int]bool)
+	add := func(start, end int) {
+		for id := start; id <= end && id < c.pieceCount; id++ {
+			if id >= 0 {
+				kept[id] = true
+			}
+		}
+	}
+	for _, r := range c.readersSnapshot() {
+		r.mu.Lock()
+		if !r.isClosed && r.isUse {
+			if r.consumer == "" {
+				rng := r.offsetRangeLocked()
+				add(r.getPieceNum(rng[0]), r.getPieceNum(rng[1]))
+				// Ordinary readers retain the legacy container head/tail protection.
+				head := int64(8 << 20)
+				if head < c.pieceLength {
+					head = c.pieceLength
+				}
+				add(r.getPieceNum(0), r.getPieceNum(min(head, r.file.Length())-1))
+				add(r.getPieceNum(max(0, r.file.Length()-head)), r.getPieceNum(r.file.Length()-1))
+			} else {
+				add(r.getPieceNum(r.offset), r.getPieceNum(r.offset))
+				if r.inFlight > 0 {
+					add(r.getPieceNum(r.readStart), r.getPieceNum(max(r.readStart, r.readEnd-1)))
+				}
+			}
+		}
+		r.mu.Unlock()
+	}
+	for id, p := range c.getPieces() {
+		s := p.snapshot()
+		if s.size > 0 && !s.complete {
+			kept[id] = true
+		}
+	}
+	for _, w := range c.windows {
+		if w.Seeking && w.seekDemand {
+			add(int((w.fileOffset+w.seekLower)/c.pieceLength), int((w.fileOffset+w.seekUpper-1)/c.pieceLength))
+		}
+	}
+	keys := make([]string, 0, len(c.windows))
+	for key, w := range c.windows {
+		if w.Seeking {
+			continue
+		}
+		keys = append(keys, key)
+		current := w.currentPiece(c.pieceLength)
+		add(current, current)
+		w.Lower = max(0, int64(current)*c.pieceLength-w.fileOffset)
+		w.Upper = min(w.fileLength, int64(current+1)*c.pieceLength-w.fileOffset)
+	}
+	sort.Strings(keys)
+	used := int64(0)
+	for id := range kept {
+		used += c.pieceBytes(id)
+	}
+	c.retainAuxiliaryLocked(kept, &used)
+	c.retainBackgroundLocked(kept, &used)
+	// A seek's old window is soft retention. The actual foreground frontier,
+	// including container/index probes, borrows only a bounded contiguous range.
+	// Count it before normal forward windows, never the entire gap from the old
+	// playhead to the new reader. Readers/export and other consumers remain hard.
+	seekingReaders := make([]*Reader, 0)
+	for _, r := range c.readersSnapshot() {
+		r.mu.Lock()
+		w, ok := c.readerWindowLocked(r)
+		if ok && w.Seeking && !r.prefetch && r.isUse && !r.isClosed {
+			r.minOffset = r.offset
+			last := r.offset
+			if r.inFlight > 0 {
+				last = max(last, r.readEnd-1)
+			}
+			r.maxOffset = min(r.file.Length(), int64(r.getPieceNum(last)+1)*c.pieceLength-r.file.Offset())
+			seekingReaders = append(seekingReaders, r)
+		}
+		r.mu.Unlock()
+	}
+	for {
+		progress := false
+		for _, r := range seekingReaders {
+			r.mu.Lock()
+			id := r.getPieceNum(max(r.offset, r.maxOffset-1)) + 1
+			limit := min(r.file.Length(), r.offset+min(r.readahead, int64(16<<20)))
+			if r.finiteForeground {
+				limit = min(limit, r.foregroundEnd)
+			}
+			end := min(r.file.Length(), int64(id+1)*c.pieceLength-r.file.Offset())
+			cost := c.pieceBytes(id)
+			if id < c.pieceCount && r.maxOffset < limit && end > r.maxOffset && (kept[id] || cost <= c.capacity-used) {
+				if !kept[id] {
+					kept[id] = true
+					used += cost
+				}
+				r.maxOffset = min(end, limit)
+				progress = true
+			}
+			r.mu.Unlock()
+		}
+		if !progress {
+			break
+		}
+	}
+	// Reserve useful forward data beyond the current demux/read frontier
+	// before optional history. Assign contiguous pieces so the returned upper
+	// cannot authorize gaps that were omitted from the union budget.
+	frontiers := make(map[string]int)
+	for _, key := range keys {
+		frontiers[key] = c.windows[key].currentPiece(c.pieceLength)
+	}
+	for _, r := range c.readersSnapshot() {
+		r.mu.Lock()
+		if w, ok := c.readerWindowLocked(r); ok && !w.Seeking && r.isUse && !r.isClosed {
+			at := r.offset
+			if r.inFlight > 0 {
+				at = max(at, r.readEnd-1)
+			}
+			frontiers[r.consumer] = max(frontiers[r.consumer], r.getPieceNum(at))
+		}
+		r.mu.Unlock()
+	}
+	for {
+		progress := false
+		for _, key := range keys {
+			w := c.windows[key]
+			id := w.endPiece(c.pieceLength) + 1
+			if id > frontiers[key]+1 {
+				continue
+			}
+			end := min(w.fileLength, int64(id+1)*c.pieceLength-w.fileOffset)
+			if id >= c.pieceCount || end > w.requestedUpper || end <= w.Upper {
+				continue
+			}
+			cost := c.pieceBytes(id)
+			if !kept[id] && cost > c.capacity-used {
+				continue
+			}
+			if !kept[id] {
+				kept[id] = true
+				used += cost
+			}
+			w.Upper = end
+			progress = true
+		}
+		if !progress {
+			break
+		}
+	}
+	// Retain at most the requested history: current/in-flight requirements
+	// come first, and older history is shortened when the budget is small.
+	for {
+		progress := false
+		for _, key := range keys {
+			w := c.windows[key]
+			id := w.lowerPiece(c.pieceLength) - 1
+			if id < w.requestedLowerPiece(c.pieceLength) {
+				continue
+			}
+			cost := c.pieceBytes(id)
+			if !kept[id] && cost > c.capacity-used {
+				continue
+			}
+			if !kept[id] {
+				kept[id] = true
+				used += cost
+			}
+			w.Lower = max(0, int64(id)*c.pieceLength-w.fileOffset)
+			progress = true
+		}
+		if !progress {
+			break
+		}
+	}
+	// Each pass allocates at most one next piece to each consumer. If capacity
+	// cannot cover even the required ranges, forward allocation stays at zero.
+	for {
+		progress := false
+		for _, key := range keys {
+			w := c.windows[key]
+			id := w.endPiece(c.pieceLength) + 1
+			end := int64(id+1)*c.pieceLength - w.fileOffset
+			if end > w.fileLength {
+				end = w.fileLength
+			}
+			if end > w.requestedUpper || end <= w.Upper || id >= c.pieceCount {
+				continue
+			}
+			cost := c.pieceBytes(id)
+			if !kept[id] && (cost > c.capacity-used) {
+				continue
+			}
+			if !kept[id] {
+				kept[id] = true
+				used += cost
+			}
+			w.Upper = end
+			progress = true
+		}
+		if !progress {
+			break
+		}
+	}
+	c.configureManagedReadersLocked()
+}
+
+// Caller holds muPolicy and r.mu.
+func (c *Cache) readerWindowLocked(r *Reader) (*playbackWindow, bool) {
+	w, ok := c.windows[r.consumer]
+	return w, ok && w.fileOffset == r.file.Offset() && w.fileLength == r.file.Length()
+}
+
+func (c *Cache) configureManagedReadersLocked() {
+	for _, r := range c.readersSnapshot() {
+		r.mu.Lock()
+		w, ok := c.readerWindowLocked(r)
+		r.managed = r.consumer != ""
+		if ok && w.Seeking {
+			if r.prefetch || !r.isUse {
+				r.minOffset = r.offset
+				r.maxOffset = r.offset
+			}
+		} else if ok {
+			r.minOffset = w.Lower
+			r.maxOffset = w.Upper
+		} else if r.managed {
+			r.minOffset = r.offset
+			r.maxOffset = r.offset
+		}
+		r.mu.Unlock()
+	}
+}
+
+func (c *Cache) applyReaderReadahead() {
+	for _, r := range c.readersSnapshot() {
+		r.applyReadahead()
+	}
+}
+
+// A managed reader pins its actual read, not a percentage of the cache behind
+// the demuxer's ahead-of-playback cursor. Windows themselves protect the media
+// history and budgeted forward interval.
+func (c *Cache) protectionRangesLocked() []Range {
+	ranges := make([]Range, 0)
+	for _, r := range c.readersSnapshot() {
+		r.mu.Lock()
+		if r.isUse && !r.isClosed {
+			if r.managed {
+				first, last := r.offset, r.offset
+				if r.inFlight > 0 {
+					first = min(first, r.readStart)
+					last = max(last, r.readEnd-1)
+				}
+				ranges = append(ranges, Range{r.getPieceNum(first), r.getPieceNum(last), nil})
+			} else {
+				offsets := r.offsetRangeLocked()
+				ranges = append(ranges, Range{r.getPieceNum(offsets[0]), r.getPieceNum(offsets[1]), r.file})
+			}
+		}
+		r.mu.Unlock()
+	}
+	for _, r := range c.readersSnapshot() {
+		r.mu.Lock()
+		w, ok := c.readerWindowLocked(r)
+		if ok && w.Seeking && r.isUse && !r.isClosed && !r.prefetch && r.maxOffset > r.offset {
+			ranges = append(ranges, Range{r.getPieceNum(r.offset), r.getPieceNum(r.maxOffset - 1), nil})
+		}
+		r.mu.Unlock()
+	}
+	for _, w := range c.windows {
+		if w.Seeking {
+			if w.seekDemand {
+				ranges = append(ranges, Range{int((w.fileOffset + w.seekLower) / c.pieceLength), int((w.fileOffset + w.seekUpper - 1) / c.pieceLength), nil})
+			}
+			continue
+		}
+		ranges = append(ranges, Range{w.lowerPiece(c.pieceLength), w.endPiece(c.pieceLength), nil})
+	}
+	for _, id := range c.auxiliaryPieceIDsLocked() {
+		ranges = append(ranges, Range{id, id, nil})
+	}
+	for _, id := range c.backgroundPieceIDsLocked() {
+		ranges = append(ranges, Range{id, id, nil})
+	}
+	return ranges
+}
+
+func (c *Cache) seekingLocked() bool {
+	for _, w := range c.windows {
+		if w.Seeking {
+			return true
+		}
+	}
+	return false
+}
+
+// Watched means wholly below every consumer cutoff touching this torrent
+// piece. Shared file-boundary pieces are retained if any consumer needs them.
+func (c *Cache) watchedPieceLocked(id int) bool {
+	matched := false
+	for _, w := range c.windows {
+		fileStart := int(w.fileOffset / c.pieceLength)
+		fileEnd := int((w.fileOffset + w.fileLength - 1) / c.pieceLength)
+		if id < fileStart || id > fileEnd {
+			continue
+		}
+		matched = true
+		if id >= w.lowerPiece(c.pieceLength) {
+			return false
+		}
+	}
+	return matched
+}
+
+// A stop is issued only for an identified finite prefetch request whose actual
+// read reached its current cache quota before the requested HTTP range ended.
+// The optional ACK proof is unrelated to generic connection or storage errors.
+type PlaybackPrefetchStop struct {
+	Reason     string `json:"reason"`
+	RequestID  string `json:"request_id"`
+	FileIndex  int    `json:"file_index"`
+	RangeStart int64  `json:"range_start"`
+	RangeEnd   int64  `json:"range_end"` // Exclusive.
+	NextOffset int64  `json:"next_offset"`
+	Revision   uint64 `json:"revision"`
+}
+
+func (c *Cache) playbackWindowSnapshotLocked(consumer string, w *playbackWindow) PlaybackWindow {
+	result := w.PlaybackWindow
+	if stop, ok := c.prefetchStops[consumer]; ok {
+		snapshot := stop
+		result.PrefetchStop = &snapshot
+	}
+	return result
+}
+
+// RecordPrefetchStop publishes a captured capacity stop after the HTTP handler
+// has successfully written exactly that validated prefix. The handler excludes
+// cancellation and writer errors. Only one terminal event is kept per consumer.
+func (c *Cache) RecordPrefetchStop(r *Reader, expectedPrefixBytes int64) bool {
+	if c == nil || r == nil || r.cache != c {
+		return false
+	}
+	c.muPolicy.Lock()
+	defer c.muPolicy.Unlock()
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if c.isClosed.Load() || r.isClosed || !r.prefetch || r.capacityStop == nil {
+		return false
+	}
+	stop := *r.capacityStop
+	w, ok := c.readerWindowLocked(r)
+	if !ok || w.fileIndex != stop.FileIndex || stop.Revision > w.Revision || c.prefetchRequests[r.consumer] != stop.RequestID || expectedPrefixBytes != stop.NextOffset-stop.RangeStart {
+		return false
+	}
+	if c.prefetchStops == nil {
+		c.prefetchStops = make(map[string]PlaybackPrefetchStop)
+	}
+	c.prefetchStops[r.consumer] = stop
+	return true
+}
