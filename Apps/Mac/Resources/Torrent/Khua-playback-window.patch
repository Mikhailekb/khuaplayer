+func TestPlaybackTinyBufferedSeekAtomicallyRetainsOverlappingPayload(t *testing.T) {
+	const mib = 1 << 20
+	file, c := playbackTestTorrent(t, 64*mib, 12*mib)
+	const initialCurrent = 24*mib + 7*mib/8
+	initial := setWindow(t, c, "paused", initialCurrent-2*mib, initialCurrent, 64*mib, 100)
+	retained := seedRetainedPayloads(t, c, 24, 25, 29)
+	assertNoMissingPiecePriority(t, c)
+
+	// Observe the same state a concurrent cleanup sees while the consumer
+	// repeatedly crosses a piece boundary by only a quarter MiB, then returns.
+	ready, stop := make(chan struct{}), make(chan struct{})
+	observations := make(chan error, 1)
+	observerDone := make(chan struct{})
+	var stopObserver sync.Once
+	defer func() { stopObserver.Do(func() { close(stop) }); <-observerDone }()
+	go func() {
+		defer close(observerDone)
+		first := true
+		for {
+			select {
+			case <-stop:
+				observations <- nil
+				return
+			default:
+			}
+			c.muPolicy.Lock()
+			w := c.windows["paused"]
+			var err error
+			if w == nil || w.Lower > w.Current || w.Current >= w.Upper {
+				err = errors.New("replacement exposed an empty consumer/window interval")
+			}
+			if err == nil {
+				err = retainedPayloadError(c, retained)
+			}
+			c.muPolicy.Unlock()
+			if first {
+				close(ready)
+				first = false
+			}
+			if err != nil {
+				observations <- err
+				return
+			}
+			runtime.Gosched()
+		}
+	}()
+	<-ready
+	for revision := uint64(101); revision <= 140; revision++ {
+		current := int64(initialCurrent)
+		if revision%2 == 1 {
+			current += mib / 4
+		}
+		next := setWindow(t, c, "paused", current-2*mib, current, 64*mib, revision)
+		if max(initial.Lower, next.Lower) >= min(initial.Upper, next.Upper) {
+			t.Fatal("test seek unexpectedly left the cached window")
+		}
+		assertPausedWindow(t, c, "paused", revision)
+		assertRetainedPayloads(t, c, retained)
+		assertNoMissingPiecePriority(t, c)
+	}
+	stopObserver.Do(func() { close(stop) })
+	if err := <-observations; err != nil {
+		t.Fatal(err)
+	}
+
+	// Read through the real patched torrent Reader, not only storage metadata.
+	// Network discovery is disabled, so retained data cannot be silently refilled.
+	reader := file.NewReader()
+	reader.SetReadahead(0)
+	defer reader.Close()
+	if _, err := reader.Seek(25*mib+127, io.SeekStart); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	got := make([]byte, 128)
+	if n, err := reader.ReadContext(ctx, got); err != nil || n != len(got) || !bytes.Equal(got, retained[25].bytes[127:255]) {
+		t.Fatalf("buffered seek lost real readable payload: n=%d err=%v", n, err)
+	}
+}
