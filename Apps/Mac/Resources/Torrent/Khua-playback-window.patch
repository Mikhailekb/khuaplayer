+package torrstor
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"runtime"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/anacrolix/torrent"
+	"github.com/anacrolix/torrent/bencode"
+	"github.com/anacrolix/torrent/metainfo"
+)
+
+func policyCache(t *testing.T, capacity, length, piece int64) *Cache {
+	t.Helper()
+	initTestSettings(t)
+	c := NewCache(capacity, NewStorage(capacity))
+	c.pieceLength = piece
+	c.pieceCount = int((length + piece - 1) / piece)
+	c.totalLength = length
+	for id := 0; id < c.pieceCount; id++ {
+		c.pieces[id] = NewPiece(id, c)
+	}
+	return c
+}
+func putPolicyPiece(c *Cache, id int, complete bool) {
+	p := c.pieces[id]
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.Size = c.pieceBytes(id)
+	p.Complete = complete
+	p.mPiece.buffer = bytes.Repeat([]byte{byte(id + 1)}, int(c.pieceLength))
+}
+func setWindow(t *testing.T, c *Cache, key string, lower, current, upper int64, revision uint64) PlaybackWindow {
+	t.Helper()
+	w, err := c.UpdatePlaybackWindow(1, 0, c.totalLength, key, lower, current, upper, revision, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return w
+}
+func TestPlaybackWindowEvictsWatchedBelowCapacityAndRoundsUp(t *testing.T) {
+	c := policyCache(t, 100, 100, 10)
+	for id := 0; id < 8; id++ {
+		putPolicyPiece(c, id, true)
+	}
+	w := setWindow(t, c, "main", 23, 55, 100, 1)
+	if w.Lower != 30 || w.Current != 55 || w.Upper != 100 || w.PieceLength != 10 {
+		t.Fatalf("window %+v", w)
+	}
+	for id := 0; id < 8; id++ {
+		got := c.pieces[id].snapshot().size
+		if (id < 3) != (got == 0) {
+			t.Fatalf("piece %d size %d, lower boundary piece must be dropped", id, got)
+		}
+	}
+}
+func TestPlaybackWindowCurrentPieceOverhang(t *testing.T) {
+	c := policyCache(t, 20, 100, 10)
+	putPolicyPiece(c, 2, true)
+	w := setWindow(t, c, "main", 23, 25, 26, 1)
+	if w.Lower != 20 || w.Upper != 30 || c.pieces[2].snapshot().size == 0 {
+		t.Fatalf("current piece lost: %+v", w)
+	}
+}
+func TestPlaybackWindowNeverDiscardsIncompleteBytes(t *testing.T) {
+	c := policyCache(t, 10, 100, 10)
+	putPolicyPiece(c, 0, false)
+	putPolicyPiece(c, 1, true)
+	setWindow(t, c, "main", 25, 45, 100, 1)
+	if c.pieces[0].snapshot().size != 10 || c.pieces[0].snapshot().complete {
+		t.Fatal("incomplete piece lost or marked complete")
+	}
+	data := make([]byte, 10)
+	if _, err := c.pieces[0].ReadAt(data, 0); err != nil || !bytes.Equal(data, bytes.Repeat([]byte{1}, 10)) {
+		t.Fatalf("partial data changed %v %v", data, err)
+	}
+	if c.pieces[1].snapshot().size != 0 {
+		t.Fatal("old complete piece was retained")
+	}
+}
+func TestPlaybackWindowUnionBudgetAndReleaseRevision(t *testing.T) {
+	c := policyCache(t, 60, 200, 10)
+	setWindow(t, c, "a", 20, 35, 200, 1)
+	setWindow(t, c, "b", 90, 105, 200, 1)
+	c.muPolicy.Lock()
+	a, b := *c.windows["a"], *c.windows["b"]
+	ranges := c.protectionRangesLocked()
+	c.muPolicy.Unlock()
+	union := map[int]bool{}
+	for _, r := range ranges {
+		for id := r.Start; id <= r.End; id++ {
+			union[id] = true
+		}
+	}
+	if len(union) != 6 || a.Upper != 50 || b.Upper != 120 {
+		t.Fatalf("union=%v a=%+v b=%+v", union, a, b)
+	}
+	for id := 2; id < 12; id++ {
+		putPolicyPiece(c, id, true)
+	}
+	c.cleanPieces()
+	if c.pieces[2].snapshot().size == 0 || c.pieces[9].snapshot().size == 0 {
+		t.Fatal("one consumer evicted another consumer's range")
