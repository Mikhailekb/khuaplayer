+		t.Fatal(err)
+	}
+	wrapped := &Torrent{Torrent: backend, TorrentSpec: spec, Stat: state.TorrentWorking,
+		cache: cache, closed: backend.Closed(), Timestamp: time.Now().Unix()}
+	var connections atomic.Int32
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		if err := wrapped.Stream(1, req, w); err != nil {
+			t.Errorf("Stream: %v", err)
+		}
+	}))
