@@ -0,0 +1,38 @@
+package torrstor
+
+import (
+	"context"
+	"io"
+	"testing"
+	"time"
+)
+
+// Uses only the pre-existing public-to-this-package worker7 fixture/API so the
+// identical test can execute against the actual previous cache implementation.
+func TestSelectedSubtitleRetentionRegression(t *testing.T) {
+	const m = int64(1 << 20)
+	f, c := playbackTestTorrent(t, 128*m, 32*m)
+	setWindow(t, c, "main", 64*m, 64*m, 128*m, 1)
+	r := c.NewPlaybackReaderAt(f, "main", 4*m+64, 4*m+128)
+	r.beginRead(64)
+	retained := seedRetainedPayloads(t, c, 4)
+	r.endIO()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	r.readContext = ctx
+	if n, e := io.ReadFull(r, make([]byte, 64)); e != nil || n != 64 {
+		t.Fatalf("initial subtitle bytes %d %v", n, e)
+	}
+	c.CloseReader(r)
+	setWindow(t, c, "main", 64*m, 64*m, 128*m, 2)
+	c.cleanPiecesSync()
+	assertRetainedPayloads(t, c, retained)
+	// The peer-disabled source cannot fetch a single replacement byte. A second
+	// finite read must use the retained allocation, not merely trust counters.
+	r = c.NewPlaybackReaderAt(f, "main", 4*m+64, 4*m+128)
+	r.readContext = ctx
+	if n, e := io.ReadFull(r, make([]byte, 64)); e != nil || n != 64 {
+		t.Fatalf("retained subtitle reread %d %v", n, e)
+	}
+	c.CloseReader(r)
+}
