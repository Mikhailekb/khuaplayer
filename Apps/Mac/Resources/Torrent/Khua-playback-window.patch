+		data := payload[i*pieceLength : (i+1)*pieceLength]
+		if n, err := cache.Piece(info.Piece(i)).WriteAt(data, 0); err != nil || n != len(data) {
+			t.Fatalf("seed piece %d: n=%d err=%v", i, n, err)
+		}
+		backend.Piece(i).VerifyData()
