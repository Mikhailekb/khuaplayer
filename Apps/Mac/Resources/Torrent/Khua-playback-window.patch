+	r.Seek(0, io.SeekEnd)
+	r.Seek(2*m, io.SeekStart)
+	c.cleanPiecesSync()
+	if len(auxiliaryIDs(c)) != 0 {
+		t.Fatal("probe admitted auxiliary demand")
+	}
+	seedRetainedPayloads(t, c, 2)
+	readAuxiliary(t, r, 64)
+	c.CloseReader(r)
+	c.cleanPiecesSync()
+	if g := auxiliaryIDs(c); len(g) != 1 || g[0] != 2 {
+		t.Fatalf("one-piece budget spent on neighbor: %v", g)
+	}
+	if c.torrent.PieceState(3).Priority != torrent.PiecePriorityNone {
+		t.Fatal("one-piece budget requested neighbor")
+	}
+}
+func TestAuxiliaryFuturePriorityWithPrimaryPrefetch(t *testing.T) {
+	const m = int64(1 << 20)
