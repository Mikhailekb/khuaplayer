+			if err != nil || !ack.Seeking || ack.Revision != 2 {
+				t.Fatalf("seek marker: %+v %v", ack, err)
+			}
+			after := f.cache.GetState()
+			if after.Filled != original.Filled {
+				t.Fatal("seek marker discarded cached payload")
+			}
+			for id, old := range original.Pieces {
+				if now, ok := after.Pieces[id]; !ok || now.Size != old.Size || !now.Completed {
+					t.Fatalf("seek marker changed resident piece%d", id)
