+++ b/server/torr/background_stream.go
@@ -0,0 +1,35 @@
+package torr
+
+import (
+	"github.com/anacrolix/torrent"
+	"github.com/anacrolix/torrent/metainfo"
+	"server/torr/state"
+	"server/torr/storage/torrstor"
+)
+
+func (t *Torrent) newBackgroundStreamReader(file *torrent.File, consumer, parent string, start, end int64) (*torrstor.Reader, error) {
+	t.muTorrent.Lock()
+	stat, cache := t.Stat, t.cache
+	t.muTorrent.Unlock()
+	if stat == state.TorrentClosed || cache == nil {
+		return nil, torrstor.ErrPlaybackCacheClosed
+	}
+	return cache.NewBackgroundPlaybackReaderAt(file, consumer, parent, start, end)
+}
+
+// Cleanup observes only an active torrent. It cannot reopen a saved torrent or
+// create a new reader merely because a late producer cancellation arrived.
+func RemovePlaybackBackground(hash, consumer, parent string) error {
+	if bts == nil {
+		return nil
+	}
+	t := bts.GetTorrent(metainfo.NewHashFromHex(hash))
+	if t == nil {
+		return nil
+	}
+	cache := t.GetCache()
+	if cache == nil {
+		return nil
+	}
+	return cache.RemoveBackgroundLane(consumer, parent)
+}
diff --git a/server/torr/background_stream_test.go b/server/torr/background_stream_test.go
new file mode 100644
--- /dev/null
+++ b/server/torr/background_stream_test.go
@@ -0,0 +1,175 @@
+package torr
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"os/exec"
+	"regexp"
+	"testing"
+	"time"
+
+	"server/settings"
+)
+
+func isolatedBackgroundHTTP(t *testing.T) bool {
+	t.Helper()
+	const key = "KINOLET_BACKGROUND_HTTP_TEST"
+	if os.Getenv(key) != t.Name() {
+		ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+		defer cancel()
+		cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^"+regexp.QuoteMeta(t.Name())+"$", "-test.v")
+		cmd.Env = append(os.Environ(), key+"="+t.Name())
+		out, e := cmd.CombinedOutput()
+		if e != nil {
+			t.Fatalf("isolated background HTTP: %v\n%s", e, out)
+		}
+		t.Logf("isolated background HTTP:\n%s", out)
+		return false
+	}
+	settings.Path = t.TempDir()
+	settings.Args = &settings.ExecArgs{}
+	if e := settings.InitSets(false, false); e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(settings.CloseDB)
+	settings.BTsets.UseDisk = false
+	settings.BTsets.ResponsiveMode = true
+	settings.BTsets.ReaderReadAHead = 95
+	settings.BTsets.ConnectionsLimit = 25
+	settings.BTsets.TorrentDisconnectTimeout = 30
+	return true
+}
+
+func backgroundHTTPRequest(t *testing.T, base string, first, end int64) *http.Request {
+	t.Helper()
+	q := url.Values{"playback_consumer": {"background-job"}, "playback_parent": {"capacity-http"}, "playback_background": {"1"}}
+	r, e := http.NewRequest("GET", base+"/stream/capacity.mkv?"+q.Encode(), nil)
+	if e != nil {
+		t.Fatal(e)
+	}
+	r.Header.Set("Range", fmt.Sprintf("bytes=%d-%d", first, end-1))
+	return r
+}
+
+func TestBackgroundHTTPRejectsFallbacksAndValidators(t *testing.T) {
+	if !isolatedBackgroundHTTP(t) {
+		return
+	}
+	f := newCapacityHTTPFixtureAt(t, 4<<20, 512<<10, 2<<20)
+	for _, tt := range []struct {
+		name   string
+		change func(*http.Request)
+		want   int
+	}{
+		{"missing range", func(q *http.Request) { q.Header.Del("Range") }, 400},
+		{"open ended range", func(q *http.Request) { q.Header.Set("Range", "bytes=1-") }, 400},
+		{"oversized", func(q *http.Request) { q.Header.Set("Range", "bytes=0-262144") }, 400},
+		{"invalid role", func(q *http.Request) {
+			x := q.URL.Query()
+			x.Set("playback_background", "2")
+			q.URL.RawQuery = x.Encode()
+		}, 400},
+		{"missing parent", func(q *http.Request) { x := q.URL.Query(); x.Del("playback_parent"); q.URL.RawQuery = x.Encode() }, 400},
+		{"parent missing", func(q *http.Request) {
+			x := q.URL.Query()
+			x.Set("playback_parent", "missing")
+			q.URL.RawQuery = x.Encode()
+		}, 409},
+		{"same primary token", func(q *http.Request) {
+			x := q.URL.Query()
+			x.Set("playback_consumer", "capacity-http")
+			q.URL.RawQuery = x.Encode()
+		}, 400},
+		{"prefetch overlap", func(q *http.Request) {
+			x := q.URL.Query()
+			x.Set("playback_prefetch", "1")
+			q.URL.RawQuery = x.Encode()
+		}, 400},
+		{"HEAD body", func(q *http.Request) { q.Method = "HEAD" }, 400},
+		{"entity changed", func(q *http.Request) { q.Header.Set("If-Range", `"other-entity"`) }, 412},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			q := backgroundHTTPRequest(t, "http://owned.invalid", 64<<10, (64<<10)+64)
+			tt.change(q)
+			w := httptest.NewRecorder()
+			_ = f.torrent.Stream(1, q, w)
+			if w.Code != tt.want {
+				t.Fatalf("status%d want%d", w.Code, tt.want)
+			}
+			if f.cache.GetUseReaders() != 0 {
+				t.Fatal("rejected request created active reader")
+			}
+		})
+	}
+}
+
+func TestBackgroundHTTPFiniteRangeRetainsDataWithoutAdvancingPrimary(t *testing.T) {
+	if !isolatedBackgroundHTTP(t) {
+		return
+	}
+	const piece = int64(64 << 10)
+	f := newCapacityHTTPFixtureAt(t, 4<<20, 512<<10, 2<<20)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { _ = f.torrent.Stream(1, r, w) }))
+	defer server.Close()
+	client := &http.Client{Timeout: 3 * time.Second, Transport: &http.Transport{Proxy: nil}}
+	defer client.CloseIdleConnections()
+	type response struct {
+		status int
+		data   []byte
+		err    error
+	}
+	result := make(chan response, 1)
+	go func() {
+		q := backgroundHTTPRequest(t, server.URL, piece+64, piece+128)
+		resp, e := client.Do(q)
+		if e != nil {
+			result <- response{err: e}
+			return
+		}
+		defer resp.Body.Close()
+		b, e := io.ReadAll(resp.Body)
+		result <- response{resp.StatusCode, b, e}
+	}()
+	deadline := time.Now().Add(time.Second)
+	for f.cache.GetUseReaders() == 0 && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if f.cache.GetUseReaders() == 0 {
+		t.Fatal("background body never activated")
+	}
+	info := f.torrent.Info()
+	payload := f.payload[piece : 2*piece]
+	if n, e := f.cache.Piece(info.Piece(1)).WriteAt(payload, 0); e != nil || n != len(payload) {
+		t.Fatalf("supply actual demanded piece n%d err%v", n, e)
+	}
+	f.torrent.Piece(1).VerifyData()
+	x := <-result
+	if x.err != nil || x.status != 206 || !bytes.Equal(x.data, f.payload[piece+64:piece+128]) {
+		t.Fatalf("first background%d %d %v", x.status, len(x.data), x.err)
+	}
+	ack := f.ack(t)
+	if ack.Current != 2<<20 || ack.Revision != 2 {
+		t.Fatal("background advanced primary window")
+	}
+	// No peer/tracker exists. Successful second sparse read is independent proof
+	// that closing the first finite HTTP response retained its body source bytes.
+	q := backgroundHTTPRequest(t, server.URL, piece+256, piece+320)
+	resp, e := client.Do(q)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer resp.Body.Close()
+	b, e := io.ReadAll(resp.Body)
+	if e != nil || resp.StatusCode != 206 || !bytes.Equal(b, f.payload[piece+256:piece+320]) {
+		t.Fatalf("second sparse read%d %v", resp.StatusCode, e)
+	}
+	if f.cache.GetState().Filled > f.quota {
+		t.Fatal("background retained bytes exceeded shared capacity")
+	}
+}
diff --git a/server/torr/cache_ranges.go b/server/torr/cache_ranges.go
new file mode 100644
--- /dev/null
+++ b/server/torr/cache_ranges.go
@@ -0,0 +1,43 @@
+package torr
+
+import (
+	"errors"
+	"github.com/anacrolix/torrent"
+	"github.com/anacrolix/torrent/metainfo"
+	"server/torr/state"
+	"server/torr/storage/torrstor"
+	utils2 "server/utils"
+	"sort"
+)
+
+var ErrCachedTorrentNotFound = errors.New("active cached torrent file not found")
+
+// SnapshotFileCache observes an already active torrent. GetTorrent deliberately
+// cannot be used here: it renews expiry and may reopen a stored torrent.
+func SnapshotFileCache(hashHex string, fileIndex int) (torrstor.FileCacheSnapshot, error) {
+	if bts == nil {
+		return torrstor.FileCacheSnapshot{}, ErrCachedTorrentNotFound
+	}
+	tor := bts.GetTorrent(metainfo.NewHashFromHex(hashHex))
+	if tor == nil {
+		return torrstor.FileCacheSnapshot{}, ErrCachedTorrentNotFound
+	}
+	return tor.snapshotFileCache(fileIndex)
+}
+
+func (t *Torrent) snapshotFileCache(fileIndex int) (torrstor.FileCacheSnapshot, error) {
+	t.muTorrent.Lock()
+	defer t.muTorrent.Unlock()
+	if t.Stat == state.TorrentClosed || t.Torrent == nil || t.Torrent.Info() == nil || t.cache == nil {
+		return torrstor.FileCacheSnapshot{}, ErrCachedTorrentNotFound
+	}
+	// Preserve the same natural sorted IDs as Status, but retain each actual
+	// metainfo offset; sorted file lengths are not the torrent's byte layout.
+	files := append([]*torrent.File(nil), t.Torrent.Files()...)
+	sort.Slice(files, func(i, j int) bool { return utils2.CompareStrings(files[i].Path(), files[j].Path()) })
+	if fileIndex <= 0 || fileIndex > len(files) {
+		return torrstor.FileCacheSnapshot{}, ErrCachedTorrentNotFound
+	}
+	file := files[fileIndex-1]
+	return t.cache.FileCacheSnapshot(fileIndex, file.Offset(), file.Length())
+}
