+func auxiliaryIDs(c *Cache) []int {
+	c.muPolicy.Lock()
+	defer c.muPolicy.Unlock()
+	return c.auxiliaryPieceIDsLocked()
+}
+func readAuxiliary(t *testing.T, r *Reader, count int) []byte {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	r.readContext = ctx
+	b := make([]byte, count)
+	if n, e := io.ReadFull(r, b); e != nil || n != count {
+		t.Fatalf("auxiliary read n=%d err=%v", n, e)
+	}
+	return b
+}
+func TestAuxiliaryForegroundSurvivesFiniteEOFACKAndPause(t *testing.T) {
+	const m = int64(1 << 20)
+	f, c := playbackTestTorrent(t, 128*m, 32*m)
+	setWindow(t, c, "main", 64*m, 64*m, 128*m, 1)
+	retained := seedRetainedPayloads(t, c, 4, 5)
+	r := c.NewPlaybackReaderAt(f, "main", 4*m+64, 4*m+128)
+	if b := readAuxiliary(t, r, 64); !bytes.Equal(b, bytes.Repeat([]byte{5}, 64)) {
+		t.Fatal("wrong payload")
+	}
+	c.CloseReader(r)
+	c.cleanPiecesSync()
+	for rev := uint64(2); rev < 7; rev++ {
+		setWindow(t, c, "main", 64*m, 64*m, 128*m, rev)
+		c.cleanPiecesSync()
+		assertRetainedPayloads(t, c, retained)
+	}
+	if g := auxiliaryIDs(c); len(g) != 2 || g[0] != 4 || g[1] != 5 {
+		t.Fatalf("auxiliary working set %v", g)
+	}
+	r = c.NewPlaybackReaderAt(f, "main", 4*m+64, 4*m+128)
+	readAuxiliary(t, r, 64)
+	c.CloseReader(r)
+	if c.GetState().Filled > c.capacity {
+		t.Fatal("auxiliary exceeded global capacity")
+	}
+	t.Log("actual finite body remains readable without peers after EOF/Close and paused ACKs")
+}
+func TestAuxiliaryOnePieceBudgetNoMetadataDemand(t *testing.T) {
