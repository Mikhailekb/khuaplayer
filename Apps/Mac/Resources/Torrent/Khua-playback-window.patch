+
+// Request cancellation can race the end of ServeContent. Cancel exactly when
+// Stream checks the context after the complete quota prefix and capacity EOF,
+// before it can publish the otherwise-valid proof. Done/Err remain consistent.
+type capacityHTTPPublicationCancelContext struct {
+	context.Context
+	cancel context.CancelFunc
+	calls  int
+}
+
+func (c *capacityHTTPPublicationCancelContext) Err() error {
+	c.calls++
+	c.cancel()
+	return c.Context.Err()
+}
+
+func TestPrefetchCapacityResponseWriterCountsActualPrefix(t *testing.T) {
+	for _, mode := range []string{"writer-error", "short-write", "writer-error-after-all-bytes"} {
+		t.Run(mode, func(t *testing.T) {
+			fault := &capacityHTTPFaultWriter{ResponseRecorder: httptest.NewRecorder(), mode: mode}
+			writer := &prefetchResponseWriter{ResponseWriter: fault, status: http.StatusOK}
+			writer.WriteHeader(http.StatusPartialContent)
+			data := bytes.Repeat([]byte{23}, 32)
+			n, err := writer.Write(data)
+			want := len(data) / 2
+			if mode == "writer-error-after-all-bytes" {
+				want = len(data)
+			}
+			if n != want || writer.written != int64(want) || !writer.failed || writer.status != http.StatusPartialContent {
+				t.Fatalf("mode=%s n=%d count=%d failed=%v status=%d", mode, n, writer.written, writer.failed, writer.status)
+			}
+			if (mode != "short-write") != errors.Is(err, io.ErrClosedPipe) {
+				t.Fatalf("mode=%s err=%v", mode, err)
+			}
+		})
+	}
+	t.Run("successful-prefix", func(t *testing.T) {
+		writer := &prefetchResponseWriter{ResponseWriter: httptest.NewRecorder(), status: http.StatusOK}
+		writer.WriteHeader(http.StatusPartialContent)
+		if n, err := writer.Write([]byte("actual prefix")); n != 13 || err != nil || writer.written != 13 || writer.failed {
+			t.Fatalf("n=%d err=%v count=%d failed=%v", n, err, writer.written, writer.failed)
+		}
+	})
+}
+
+// Flush a real TCP response prefix and hold the handler until the remote client
+// cancels. This makes disconnect ordering deterministic even with a RAM source.
+type capacityHTTPDisconnectWriter struct {
+	http.ResponseWriter
+	context      context.Context
+	disconnected chan<- struct{}
+}
+
+func (w *capacityHTTPDisconnectWriter) Write(p []byte) (int, error) {
+	n, err := w.ResponseWriter.Write(p)
+	if err != nil {
+		return n, err
+	}
+	w.ResponseWriter.(http.Flusher).Flush()
+	select {
+	case <-w.context.Done():
+		w.disconnected <- struct{}{}
+		return n, w.context.Err()
+	case <-time.After(3 * time.Second):
+		return n, errors.New("client did not disconnect")
+	}
+}
+
+// Force HTTP write and cancellation failures after a real source read. The
+// worker's buffered source may already have advanced farther than these writes.
+type capacityHTTPFaultWriter struct {
+	*httptest.ResponseRecorder
+	mode   string
+	cancel context.CancelFunc
+	calls  int
+}
+
+func (w *capacityHTTPFaultWriter) Write(p []byte) (int, error) {
+	w.calls++
+	switch w.mode {
+	case "writer-error":
+		n, _ := w.ResponseRecorder.Write(p[:len(p)/2])
+		return n, io.ErrClosedPipe
+	case "writer-error-after-all-bytes":
+		n, _ := w.ResponseRecorder.Write(p)
+		return n, io.ErrClosedPipe
+	case "short-write":
+		return w.ResponseRecorder.Write(p[:len(p)/2])
+	case "context-canceled":
+		n, err := w.ResponseRecorder.Write(p)
+		w.cancel()
+		return n, err
+	default:
+		panic("unknown fault mode")
+	}
+}
