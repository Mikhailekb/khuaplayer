+func policyCache(t *testing.T, capacity, length, piece int64) *Cache {
+	t.Helper()
+	initTestSettings(t)
+	c := NewCache(capacity, NewStorage(capacity))
+	c.pieceLength = piece
+	c.pieceCount = int((length + piece - 1) / piece)
