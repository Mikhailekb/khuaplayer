+func capacityReader(t *testing.T, file *torrent.File, cache *Cache, requestID string, start, end int64) *Reader {
+	t.Helper()
+	reader := cache.NewPrefetchReaderAt(file, "capacity", start)
+	t.Cleanup(func() { cache.CloseReader(reader) })
+	reader.SetPrefetchRequest(requestID, start, end)
+	if _, err := reader.Seek(start, io.SeekStart); err != nil {
+		t.Fatal(err)
+	}
+	return reader
+}
+
+// Read the exact resident allowance first. Only the following nonempty Read is
+// stopped by policy; reaching the same offset alone is not terminal proof.
+func reachCapacityEOF(t *testing.T, reader *Reader, start, upper int64) int64 {
+	t.Helper()
+	data := make([]byte, upper-start)
+	if n, err := io.ReadFull(reader, data); err != nil || int64(n) != upper-start {
+		t.Fatalf("resident quota read: n=%d err=%v", n, err)
+	}
+	if stop := reader.PrefetchCapacityStop(); stop != nil {
+		t.Fatalf("merely reaching the quota captured an unobserved EOF: %+v", stop)
+	}
+	reader.Read(nil)
+	if stop := reader.PrefetchCapacityStop(); stop != nil {
+		t.Fatalf("an empty read fabricated capacity EOF proof: %+v", stop)
+	}
+	if n, err := reader.Read(make([]byte, 1)); n != 0 || !errors.Is(err, io.EOF) {
+		t.Fatalf("actual capacity boundary: n=%d err=%v", n, err)
+	}
+	return upper - start
+}
+
+func TestPrefetchCapacityOtherConsumerShrinksQuotaWithoutOwnRevision(t *testing.T) {
+	const mib = prefetchCapacityMiB
+	file, cache := playbackTestTorrent(t, 32*mib, 8*mib)
+	initial := setWindow(t, cache, "capacity", 4*mib, capacityReadStart, 32*mib, 1)
+	if initial.Upper != 12*mib {
+		t.Fatalf("initial eight-piece window %+v", initial)
+	}
+	seedRetainedPayloads(t, cache, 4, 5, 6, 7, 8, 9, 10, 11)
+	const requestedEnd = 24 * mib
+	reader := capacityReader(t, file, cache, prefetchRequestA, capacityReadStart, requestedEnd)
+	first := make([]byte, 32<<10)
+	if n, err := reader.Read(first); err != nil || n != len(first) {
+		t.Fatalf("initial body prefix: n=%d err=%v", n, err)
+	}
+	setWindow(t, cache, "another-consumer", 20*mib, 20*mib, 32*mib, 1)
+	cache.muPolicy.Lock()
+	shrunk := cache.windows["capacity"].PlaybackWindow
+	cache.muPolicy.Unlock()
+	if shrunk.Upper >= initial.Upper || shrunk.Revision != initial.Revision {
+		t.Fatalf("fixture must reduce the quota without changing its owner's revision: before=%+v after=%+v", initial, shrunk)
+	}
+	// A subsequent finite suffix can have been planned from the old ACK at
+	// exactly the newly reduced frontier. It must report a real zero-byte
+	// quota EOF, even though this consumer's revision did not change. Do not
+	// drain toward a moving frontier here: active read-ahead itself changes
+	// the fair-share allocation and is exercised separately above.
+	reader.SetPrefetchRequest(prefetchRequestB, shrunk.Upper, requestedEnd)
+	if _, err := reader.Seek(shrunk.Upper, io.SeekStart); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := reader.Read(make([]byte, 1)); n != 0 || !errors.Is(err, io.EOF) {
+		t.Fatalf("newly reduced frontier: n=%d err=%v", n, err)
+	}
+	assertCapacityStop(t, reader.PrefetchCapacityStop(), prefetchRequestB, shrunk.Upper, requestedEnd, shrunk.Upper, 1)
+	if !cache.RecordPrefetchStop(reader, 0) {
+		t.Fatal("another consumer's quota reduction was not publishable as an actual capacity stop")
+	}
+	ack := setWindow(t, cache, "capacity", 4*mib, capacityReadStart, 32*mib, 2)
+	assertCapacityStop(t, ack.PrefetchStop, prefetchRequestB, shrunk.Upper, requestedEnd, shrunk.Upper, 1)
+}
+
+func assertCapacityStop(t *testing.T, stop *PlaybackPrefetchStop, requestID string, start, end, next int64, revision uint64) {
+	t.Helper()
+	if stop == nil || stop.Reason != "capacity" || stop.RequestID != requestID || stop.FileIndex != 1 ||
+		stop.RangeStart != start || stop.RangeEnd != end || stop.NextOffset != next || stop.Revision != revision {
+		t.Fatalf("capacity stop %+v; want id=%q file=1 range=[%d,%d) next=%d revision=%d", stop, requestID, start, end, next, revision)
+	}
+}
+
+func TestPrefetchCapacityStopPublishesBeforeOrAfterWindowACK(t *testing.T) {
+	for _, ackBeforeRecord := range []bool{false, true} {
+		name := "terminal-before-ack"
+		if ackBeforeRecord {
+			name = "ack-before-terminal"
+		}
+		t.Run(name, func(t *testing.T) {
+			file, cache, initial := capacityFixture(t)
+			reader := capacityReader(t, file, cache, prefetchRequestA, capacityReadStart, capacityReadEnd)
+			if cache.RecordPrefetchStop(reader, 0) || reader.PrefetchCapacityStop() != nil {
+				t.Fatal("an active request published capacity without observing a quota EOF")
+			}
+			prefix := reachCapacityEOF(t, reader, capacityReadStart, initial.Upper)
+			assertCapacityStop(t, reader.PrefetchCapacityStop(), prefetchRequestA, capacityReadStart, capacityReadEnd, initial.Upper, 1)
+			if cache.RecordPrefetchStop(reader, prefix-1) || cache.RecordPrefetchStop(reader, prefix+1) {
+				t.Fatal("a delivered prefix differing from the captured read frontier published capacity")
+			}
+			revision := uint64(2)
+			if ackBeforeRecord {
+				ack := setWindow(t, cache, "capacity", 4*prefetchCapacityMiB, capacityReadStart, 16*prefetchCapacityMiB, revision)
+				if ack.PrefetchStop != nil {
+					t.Fatal("an ACK preceding terminal publication fabricated a stop")
+				}
+				revision++
+			}
+			if !cache.RecordPrefetchStop(reader, prefix) {
+				t.Fatal("an exact, still-owned capacity EOF was not published")
+			}
+			if initial.PrefetchStop != nil {
+				t.Fatal("publishing rewrote an already returned ACK")
+			}
+			ack := setWindow(t, cache, "capacity", 4*prefetchCapacityMiB, capacityReadStart, 16*prefetchCapacityMiB, revision)
+			assertCapacityStop(t, ack.PrefetchStop, prefetchRequestA, capacityReadStart, capacityReadEnd, initial.Upper, 1)
+			// Exported pointers are value snapshots, never writable references into
+			// live reader/window state.
+			readerCopy := reader.PrefetchCapacityStop()
+			readerCopy.RequestID = "outside-mutation"
+			ack.PrefetchStop.NextOffset = -1
+			assertCapacityStop(t, reader.PrefetchCapacityStop(), prefetchRequestA, capacityReadStart, capacityReadEnd, initial.Upper, 1)
+			refreshed := setWindow(t, cache, "capacity", 4*prefetchCapacityMiB, capacityReadStart, 16*prefetchCapacityMiB, revision+1)
+			assertCapacityStop(t, refreshed.PrefetchStop, prefetchRequestA, capacityReadStart, capacityReadEnd, initial.Upper, 1)
+		})
+	}
+}
+
+func TestPrefetchCapacityNewestRequestOwnsPublication(t *testing.T) {
+	file, cache, initial := capacityFixture(t)
+	old := capacityReader(t, file, cache, prefetchRequestA, capacityReadStart, capacityReadEnd)
+	prefix := reachCapacityEOF(t, old, capacityReadStart, initial.Upper)
+	if !cache.RecordPrefetchStop(old, prefix) {
+		t.Fatal("first request did not publish its capacity stop")
+	}
+	newer := capacityReader(t, file, cache, prefetchRequestB, capacityReadStart, capacityReadEnd)
+	if cache.RecordPrefetchStop(old, prefix) {
+		t.Fatal("a late old request published after a newer nonce took ownership")
+	}
+	ack := setWindow(t, cache, "capacity", 4*prefetchCapacityMiB, capacityReadStart, 16*prefetchCapacityMiB, 2)
+	if ack.PrefetchStop != nil {
+		t.Fatal("a new request inherited the previous nonce's terminal event")
+	}
+	newPrefix := reachCapacityEOF(t, newer, capacityReadStart, initial.Upper)
+	if !cache.RecordPrefetchStop(newer, newPrefix) {
+		t.Fatal("the latest request could not publish its own capacity EOF")
+	}
+	if cache.RecordPrefetchStop(old, prefix) {
+		t.Fatal("a late old terminal overwrote the newest request's event")
+	}
+	ack = setWindow(t, cache, "capacity", 4*prefetchCapacityMiB, capacityReadStart, 16*prefetchCapacityMiB, 3)
+	assertCapacityStop(t, ack.PrefetchStop, prefetchRequestB, capacityReadStart, capacityReadEnd, initial.Upper, 2)
+}
+
+func TestPrefetchCapacityReleaseInvalidatesProofAndLateReader(t *testing.T) {
+	file, cache, initial := capacityFixture(t)
+	reader := capacityReader(t, file, cache, prefetchRequestA, capacityReadStart, capacityReadEnd)
+	prefix := reachCapacityEOF(t, reader, capacityReadStart, initial.Upper)
+	if !cache.RecordPrefetchStop(reader, prefix) {
+		t.Fatal("capacity stop was not initially published")
+	}
+	removed, err := cache.UpdatePlaybackWindow(0, 0, 0, "capacity", 0, 0, 0, 2, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if removed.PrefetchStop != nil || cache.RecordPrefetchStop(reader, prefix) {
+		t.Fatal("released consumer retained or republished its terminal proof")
+	}
+	ack := setWindow(t, cache, "capacity", 4*prefetchCapacityMiB, capacityReadStart, 16*prefetchCapacityMiB, 3)
+	if ack.PrefetchStop != nil || cache.RecordPrefetchStop(reader, prefix) {
+		t.Fatal("recreating a consumer resurrected an old request's stop")
+	}
+}
+
+func TestPrefetchCapacityFileSwitchInvalidatesProof(t *testing.T) {
+	const mib = prefetchCapacityMiB
+	info := metainfo.Info{Name: "files", PieceLength: mib, Files: []metainfo.FileInfo{
+		{Path: []string{"A.mkv"}, Length: 16 * mib},
+		{Path: []string{"B.mkv"}, Length: 8 * mib},
+	}, Pieces: make([]byte, 24*20)}
+	files, cache := playbackTestTorrentFiles(t, info, 4*mib)
+	initial, err := cache.UpdatePlaybackWindow(1, files[0].Offset(), files[0].Length(), "capacity", 4*mib, capacityReadStart, files[0].Length(), 1, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seedRetainedPayloads(t, cache, 4, 5, 6, 7)
+	reader := capacityReader(t, files[0], cache, prefetchRequestA, capacityReadStart, capacityReadEnd)
+	prefix := reachCapacityEOF(t, reader, capacityReadStart, initial.Upper)
+	if !cache.RecordPrefetchStop(reader, prefix) {
+		t.Fatal("file A capacity stop did not publish")
+	}
+	switched, err := cache.UpdatePlaybackWindow(2, files[1].Offset(), files[1].Length(), "capacity", 0, 0, files[1].Length(), 2, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if switched.PrefetchStop != nil || cache.RecordPrefetchStop(reader, prefix) {
+		t.Fatal("file B inherited or republished file A's terminal proof")
+	}
+}
+
+func TestPrefetchCapacityRequiresRealQuotaEOF(t *testing.T) {
+	t.Run("closed", func(t *testing.T) {
+		file, cache, _ := capacityFixture(t)
+		reader := capacityReader(t, file, cache, prefetchRequestA, capacityReadStart, capacityReadEnd)
+		reader.Close()
+		if n, err := reader.Read(make([]byte, 1)); n != 0 || !errors.Is(err, io.EOF) {
+			t.Fatalf("closed read: n=%d err=%v", n, err)
+		}
+		if reader.PrefetchCapacityStop() != nil || cache.RecordPrefetchStop(reader, 0) {
+			t.Fatal("closed reader was mislabeled as capacity")
+		}
+	})
+	t.Run("requested-range-complete", func(t *testing.T) {
+		file, cache, initial := capacityFixture(t)
+		reader := capacityReader(t, file, cache, prefetchRequestA, capacityReadStart, initial.Upper)
+		data := make([]byte, initial.Upper-capacityReadStart)
+		if _, err := io.ReadFull(reader, data); err != nil {
+			t.Fatal(err)
+		}
+		if n, err := reader.Read(make([]byte, 1)); n != 0 || !errors.Is(err, io.EOF) {
+			t.Fatalf("complete range: n=%d err=%v", n, err)
+		}
+		if reader.PrefetchCapacityStop() != nil || cache.RecordPrefetchStop(reader, int64(len(data))) {
+			t.Fatal("fully delivered requested range was mislabeled as capacity")
+		}
+	})
+	t.Run("file-eof", func(t *testing.T) {
+		const length = 2 * prefetchCapacityMiB
+		file, cache := playbackTestTorrent(t, length, 4*prefetchCapacityMiB)
+		setWindow(t, cache, "capacity", 0, 0, length, 1)
+		seedRetainedPayloads(t, cache, 0, 1)
+		reader := capacityReader(t, file, cache, prefetchRequestA, 0, length)
+		n, err := io.Copy(io.Discard, reader)
+		if err != nil || n != length {
+			t.Fatalf("file EOF: n=%d err=%v", n, err)
+		}
+		if reader.PrefetchCapacityStop() != nil || cache.RecordPrefetchStop(reader, n) {
+			t.Fatal("file EOF was mislabeled as capacity")
+		}
+	})
+	t.Run("missing-window", func(t *testing.T) {
+		file, cache := playbackTestTorrent(t, 16*prefetchCapacityMiB, 4*prefetchCapacityMiB)
+		reader := capacityReader(t, file, cache, prefetchRequestA, capacityReadStart, capacityReadEnd)
+		if n, err := reader.Read(make([]byte, 1)); n != 0 || !errors.Is(err, io.EOF) {
+			t.Fatalf("missing window: n=%d err=%v", n, err)
+		}
+		if reader.PrefetchCapacityStop() != nil || cache.RecordPrefetchStop(reader, 0) {
+			t.Fatal("an absent window was mislabeled as capacity")
+		}
+	})
+}
