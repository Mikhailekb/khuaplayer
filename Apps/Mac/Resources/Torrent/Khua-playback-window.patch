new file mode 100644
--- /dev/null
+++ b/server/torr/storage/torrstor/playback_window.go
@@ -0,0 +1,404 @@
+package torrstor
+
+import (
+	"errors"
+	"sort"
+)
+
+var (
+	ErrStalePlaybackRevision = errors.New("playback window revision is stale")
+	ErrInvalidPlaybackWindow = errors.New("invalid playback window")
+	ErrPlaybackCacheClosed   = errors.New("playback cache is closed")
+)
+
+// PlaybackWindow offsets are file-relative bytes. Upper is exclusive. Pieces
+// overlapping current are indivisible: their necessary overhang is retained.
+type PlaybackWindow struct {
+	Lower        int64                 `json:"lower"`
+	Current      int64                 `json:"current"`
+	Upper        int64                 `json:"upper"`
+	PieceLength  int64                 `json:"piece_length"`
+	Revision     uint64                `json:"revision"`
+	PrefetchStop *PlaybackPrefetchStop `json:"prefetch_stop,omitempty"`
+}
+
+type playbackWindow struct {
+	PlaybackWindow
+	fileIndex                      int
+	fileOffset, fileLength         int64
+	requestedLower, requestedUpper int64
+}
+
+// HasPlaybackWindows reports explicit playback-session ownership. A paused
+// session can have no HTTP readers while retaining its already cached window.
+// This ownership prevents idle expiry without requesting any missing pieces.
+func (c *Cache) HasPlaybackWindows() bool {
+	if c == nil {
+		return false
+	}
+	c.muPolicy.Lock()
+	defer c.muPolicy.Unlock()
+	return !c.isClosed.Load() && len(c.windows) > 0
+}
+
+// UpdatePlaybackWindow installs a consumer's requested range, returning the
+// authoritative, piece-rounded range after sharing the cache's forward budget.
+// Revisions remain in Storage after release/cache close, so late HTTP requests
+// cannot resurrect an older range. A higher revision may reuse a released token.
+func (c *Cache) UpdatePlaybackWindow(fileIndex int, fileOffset, fileLength int64, consumer string, lower, current, upper int64, revision uint64, remove bool) (PlaybackWindow, error) {
+	if consumer == "" || revision == 0 || (!remove && (fileIndex <= 0 || fileOffset < 0 || fileLength <= 0 || lower < 0 || lower > current || current < 0 || current >= fileLength || upper <= current || upper > fileLength)) {
+		return PlaybackWindow{}, ErrInvalidPlaybackWindow
+	}
+	c.muPolicy.Lock()
+	if c.isClosed.Load() {
+		c.muPolicy.Unlock()
+		return PlaybackWindow{}, ErrPlaybackCacheClosed
+	}
+	c.storage.muWindows.Lock()
+	revisions := c.storage.windowRevisions[c.hash]
+	if revisions == nil {
+		revisions = make(map[string]uint64)
+		c.storage.windowRevisions[c.hash] = revisions
+	}
+	if revision <= revisions[consumer] {
+		c.storage.muWindows.Unlock()
+		c.muPolicy.Unlock()
+		return PlaybackWindow{}, ErrStalePlaybackRevision
+	}
+	revisions[consumer] = revision
+	c.storage.muWindows.Unlock()
+	c.managedPolicy = true
+	if remove {
+		delete(c.prefetchStops, consumer)
+		delete(c.prefetchRequests, consumer)
+		delete(c.windows, consumer)
+	} else {
+		if old := c.windows[consumer]; old != nil && (old.fileIndex != fileIndex || old.fileOffset != fileOffset || old.fileLength != fileLength) {
+			delete(c.prefetchStops, consumer)
+			delete(c.prefetchRequests, consumer)
+		}
+		c.windows[consumer] = &playbackWindow{PlaybackWindow: PlaybackWindow{Lower: lower, Current: current, Upper: upper, PieceLength: c.pieceLength, Revision: revision}, fileIndex: fileIndex, fileOffset: fileOffset, fileLength: fileLength, requestedLower: lower, requestedUpper: upper}
+	}
+	c.replanWindowsLocked()
+	result := PlaybackWindow{PieceLength: c.pieceLength, Revision: revision}
+	if w := c.windows[consumer]; w != nil {
+		result = c.playbackWindowSnapshotLocked(consumer, w)
+	}
+	c.muPolicy.Unlock()
+	c.applyReaderReadahead()
+	c.cleanPiecesSync()
+	c.muPolicy.Lock()
+	if w := c.windows[consumer]; w != nil && w.Revision == revision {
+		result = c.playbackWindowSnapshotLocked(consumer, w)
+	}
+	c.muPolicy.Unlock()
+	return result, nil
+}
+
+func (c *Cache) pieceBytes(id int) int64 {
+	length := c.pieceLength
+	if c.totalLength > 0 && int64(id+1)*length > c.totalLength {
+		length = c.totalLength - int64(id)*length
+	}
+	if length < 0 {
+		return 0
+	}
+	return length
+}
+
+func (w *playbackWindow) currentPiece(length int64) int {
+	return int((w.fileOffset + w.Current) / length)
+}
+func (w *playbackWindow) requestedLowerPiece(length int64) int {
+	lower := int((w.fileOffset + w.requestedLower + length - 1) / length)
+	if current := w.currentPiece(length); lower > current {
+		lower = current
+	}
+	return lower
+}
+func (w *playbackWindow) lowerPiece(length int64) int { return int((w.fileOffset + w.Lower) / length) }
+func (w *playbackWindow) endPiece(length int64) int {
+	return int((w.fileOffset + w.Upper - 1) / length)
+}
+
+// muPolicy serializes windows, reader I/O registration and eviction decisions.
+// Hard current/in-flight, unmanaged readers and incomplete pieces are never
+// sacrificed to a nominal capacity. History is shortened to fit. Remaining pieces are assigned forward
+// round-robin, counting pieces shared by several consumers only once.
+func (c *Cache) replanWindowsLocked() {
+	if c.pieceLength <= 0 || len(c.windows) == 0 {
+		c.configureManagedReadersLocked()
+		return
+	}
+	kept := make(map[int]bool)
+	add := func(start, end int) {
+		for id := start; id <= end && id < c.pieceCount; id++ {
+			if id >= 0 {
+				kept[id] = true
+			}
+		}
+	}
+	for _, r := range c.readersSnapshot() {
+		r.mu.Lock()
+		if !r.isClosed && r.isUse {
+			if r.consumer == "" {
+				rng := r.offsetRangeLocked()
+				add(r.getPieceNum(rng[0]), r.getPieceNum(rng[1]))
+				// Ordinary readers retain the legacy container head/tail protection.
+				head := int64(8 << 20)
+				if head < c.pieceLength {
+					head = c.pieceLength
+				}
+				add(r.getPieceNum(0), r.getPieceNum(min(head, r.file.Length())-1))
+				add(r.getPieceNum(max(0, r.file.Length()-head)), r.getPieceNum(r.file.Length()-1))
+			} else {
+				add(r.getPieceNum(r.offset), r.getPieceNum(r.offset))
+				if r.inFlight > 0 {
+					add(r.getPieceNum(r.readStart), r.getPieceNum(max(r.readStart, r.readEnd-1)))
+				}
+			}
+		}
+		r.mu.Unlock()
+	}
+	for id, p := range c.getPieces() {
+		s := p.snapshot()
+		if s.size > 0 && !s.complete {
+			kept[id] = true
+		}
+	}
+	keys := make([]string, 0, len(c.windows))
+	for key, w := range c.windows {
+		keys = append(keys, key)
+		current := w.currentPiece(c.pieceLength)
+		add(current, current)
+		w.Lower = max(0, int64(current)*c.pieceLength-w.fileOffset)
+		w.Upper = min(w.fileLength, int64(current+1)*c.pieceLength-w.fileOffset)
+	}
+	sort.Strings(keys)
+	used := int64(0)
+	for id := range kept {
+		used += c.pieceBytes(id)
+	}
+	// Reserve useful forward data beyond the current demux/read frontier
+	// before optional history. Assign contiguous pieces so the returned upper
+	// cannot authorize gaps that were omitted from the union budget.
+	frontiers := make(map[string]int)
+	for _, key := range keys {
+		frontiers[key] = c.windows[key].currentPiece(c.pieceLength)
+	}
+	for _, r := range c.readersSnapshot() {
+		r.mu.Lock()
+		if _, ok := c.readerWindowLocked(r); ok && r.isUse && !r.isClosed {
+			at := r.offset
+			if r.inFlight > 0 {
+				at = max(at, r.readEnd-1)
+			}
+			frontiers[r.consumer] = max(frontiers[r.consumer], r.getPieceNum(at))
+		}
+		r.mu.Unlock()
+	}
+	for {
+		progress := false
+		for _, key := range keys {
+			w := c.windows[key]
+			id := w.endPiece(c.pieceLength) + 1
+			if id > frontiers[key]+1 {
+				continue
+			}
+			end := min(w.fileLength, int64(id+1)*c.pieceLength-w.fileOffset)
+			if id >= c.pieceCount || end > w.requestedUpper || end <= w.Upper {
+				continue
+			}
+			cost := c.pieceBytes(id)
+			if !kept[id] && cost > c.capacity-used {
+				continue
+			}
+			if !kept[id] {
+				kept[id] = true
+				used += cost
+			}
+			w.Upper = end
+			progress = true
+		}
+		if !progress {
+			break
+		}
+	}
+	// Retain at most the requested history: current/in-flight requirements
+	// come first, and older history is shortened when the budget is small.
+	for {
+		progress := false
+		for _, key := range keys {
+			w := c.windows[key]
+			id := w.lowerPiece(c.pieceLength) - 1
+			if id < w.requestedLowerPiece(c.pieceLength) {
+				continue
+			}
+			cost := c.pieceBytes(id)
+			if !kept[id] && cost > c.capacity-used {
+				continue
+			}
+			if !kept[id] {
+				kept[id] = true
+				used += cost
+			}
+			w.Lower = max(0, int64(id)*c.pieceLength-w.fileOffset)
+			progress = true
+		}
+		if !progress {
+			break
+		}
+	}
+	// Each pass allocates at most one next piece to each consumer. If capacity
+	// cannot cover even the required ranges, forward allocation stays at zero.
+	for {
+		progress := false
+		for _, key := range keys {
+			w := c.windows[key]
+			id := w.endPiece(c.pieceLength) + 1
+			end := int64(id+1)*c.pieceLength - w.fileOffset
+			if end > w.fileLength {
+				end = w.fileLength
+			}
+			if end > w.requestedUpper || end <= w.Upper || id >= c.pieceCount {
+				continue
+			}
+			cost := c.pieceBytes(id)
+			if !kept[id] && (cost > c.capacity-used) {
+				continue
+			}
+			if !kept[id] {
+				kept[id] = true
+				used += cost
+			}
+			w.Upper = end
+			progress = true
+		}
+		if !progress {
+			break
+		}
+	}
+	c.configureManagedReadersLocked()
+}
+
+// Caller holds muPolicy and r.mu.
+func (c *Cache) readerWindowLocked(r *Reader) (*playbackWindow, bool) {
+	w, ok := c.windows[r.consumer]
+	return w, ok && w.fileOffset == r.file.Offset() && w.fileLength == r.file.Length()
+}
+
+func (c *Cache) configureManagedReadersLocked() {
+	for _, r := range c.readersSnapshot() {
+		r.mu.Lock()
+		w, ok := c.readerWindowLocked(r)
+		r.managed = r.consumer != ""
+		if ok {
+			r.minOffset = w.Lower
+			r.maxOffset = w.Upper
+		} else if r.managed {
+			r.minOffset = r.offset
+			r.maxOffset = r.offset
+		}
+		r.mu.Unlock()
+	}
+}
+
+func (c *Cache) applyReaderReadahead() {
+	for _, r := range c.readersSnapshot() {
+		r.applyReadahead()
+	}
+}
+
+// A managed reader pins its actual read, not a percentage of the cache behind
+// the demuxer's ahead-of-playback cursor. Windows themselves protect the media
+// history and budgeted forward interval.
+func (c *Cache) protectionRangesLocked() []Range {
+	ranges := make([]Range, 0)
+	for _, r := range c.readersSnapshot() {
+		r.mu.Lock()
+		if r.isUse && !r.isClosed {
+			if r.managed {
+				first, last := r.offset, r.offset
+				if r.inFlight > 0 {
+					first = min(first, r.readStart)
+					last = max(last, r.readEnd-1)
+				}
+				ranges = append(ranges, Range{r.getPieceNum(first), r.getPieceNum(last), nil})
+			} else {
+				offsets := r.offsetRangeLocked()
+				ranges = append(ranges, Range{r.getPieceNum(offsets[0]), r.getPieceNum(offsets[1]), r.file})
+			}
+		}
+		r.mu.Unlock()
+	}
+	for _, w := range c.windows {
+		ranges = append(ranges, Range{w.lowerPiece(c.pieceLength), w.endPiece(c.pieceLength), nil})
+	}
+	return ranges
+}
+
+// Watched means wholly below every consumer cutoff touching this torrent
+// piece. Shared file-boundary pieces are retained if any consumer needs them.
+func (c *Cache) watchedPieceLocked(id int) bool {
+	matched := false
+	for _, w := range c.windows {
+		fileStart := int(w.fileOffset / c.pieceLength)
+		fileEnd := int((w.fileOffset + w.fileLength - 1) / c.pieceLength)
+		if id < fileStart || id > fileEnd {
+			continue
+		}
+		matched = true
+		if id >= w.lowerPiece(c.pieceLength) {
+			return false
+		}
+	}
+	return matched
+}
+
+// A stop is issued only for an identified finite prefetch request whose actual
+// read reached its current cache quota before the requested HTTP range ended.
+// The optional ACK proof is unrelated to generic connection or storage errors.
+type PlaybackPrefetchStop struct {
+	Reason     string `json:"reason"`
+	RequestID  string `json:"request_id"`
+	FileIndex  int    `json:"file_index"`
+	RangeStart int64  `json:"range_start"`
+	RangeEnd   int64  `json:"range_end"` // Exclusive.
+	NextOffset int64  `json:"next_offset"`
+	Revision   uint64 `json:"revision"`
+}
+
+func (c *Cache) playbackWindowSnapshotLocked(consumer string, w *playbackWindow) PlaybackWindow {
+	result := w.PlaybackWindow
+	if stop, ok := c.prefetchStops[consumer]; ok {
+		snapshot := stop
+		result.PrefetchStop = &snapshot
+	}
+	return result
+}
+
+// RecordPrefetchStop publishes a captured capacity stop after the HTTP handler
+// has successfully written exactly that validated prefix. The handler excludes
+// cancellation and writer errors. Only one terminal event is kept per consumer.
+func (c *Cache) RecordPrefetchStop(r *Reader, expectedPrefixBytes int64) bool {
+	if c == nil || r == nil || r.cache != c {
+		return false
+	}
+	c.muPolicy.Lock()
+	defer c.muPolicy.Unlock()
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if c.isClosed.Load() || r.isClosed || !r.prefetch || r.capacityStop == nil {
+		return false
+	}
+	stop := *r.capacityStop
+	w, ok := c.readerWindowLocked(r)
+	if !ok || w.fileIndex != stop.FileIndex || stop.Revision > w.Revision || c.prefetchRequests[r.consumer] != stop.RequestID || expectedPrefixBytes != stop.NextOffset-stop.RangeStart {
+		return false
+	}
+	if c.prefetchStops == nil {
+		c.prefetchStops = make(map[string]PlaybackPrefetchStop)
+	}
+	c.prefetchStops[r.consumer] = stop
+	return true
+}
