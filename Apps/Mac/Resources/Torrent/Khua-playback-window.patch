+func RemovePlaybackWindow(hash metainfo.Hash, consumer string, revision uint64) (torrstor.PlaybackWindow, error) {
+	if bts == nil {
+		return torrstor.PlaybackWindow{}, torrstor.ErrPlaybackCacheClosed
+	}
+	bts.mu.RLock()
+	storage := bts.storage
+	bts.mu.RUnlock()
+	if storage == nil {
+		return torrstor.PlaybackWindow{}, torrstor.ErrPlaybackCacheClosed
+	}
+	return storage.RemovePlaybackWindow(hash, consumer, revision)
+}
diff --git a/server/torr/playback_lifetime_test.go b/server/torr/playback_lifetime_test.go
new file mode 100644
--- /dev/null
+++ b/server/torr/playback_lifetime_test.go
@@ -0,0 +1,50 @@
+package torr
+
+import (
+	"testing"
+	"time"
+)
+
+// A playback window is explicit ownership of a paused session, independent of
+// short-lived HTTP range readers. Simulate a pause longer than the timeout
+// without status polling or a download reader keeping the torrent alive.
+func TestPlaybackWindowOwnsTorrentAcrossDisconnectTimeout(t *testing.T) {
+	_, tor := newSeasonTorrent(t)
+	cache := tor.GetCache()
+	file := tor.Files()[0]
+	if cache.Readers() != 0 {
+		t.Fatal("fixture unexpectedly owns an HTTP reader")
+	}
+	tor.muTorrent.Lock()
+	tor.expiredTime = time.Now().Add(-time.Hour)
+	tor.muTorrent.Unlock()
+	if !tor.expired() {
+		t.Fatal("unowned idle torrent must remain eligible for expiry")
+	}
+	for _, consumer := range []string{"paused-a", "paused-b"} {
+		if _, err := cache.UpdatePlaybackWindow(1, file.Offset(), file.Length(), consumer, 0, 1, file.Length(), 1, false); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if tor.expired() {
+		t.Fatal("paused session expired despite retained playback windows")
+	}
+	// The production watchdog must not drop the cache even with no readers and
+	// an arbitrarily old deadline. It must still retire after final release.
+	tor.progressEvent()
+	if tor.GetCache() != cache || tor.Torrent == nil {
+		t.Fatal("watchdog dropped the paused cache")
+	}
+	if _, err := cache.UpdatePlaybackWindow(0, 0, 0, "paused-a", 0, 0, 0, 2, true); err != nil {
+		t.Fatal(err)
+	}
+	if tor.expired() {
+		t.Fatal("one session released another paused session")
+	}
+	if _, err := cache.UpdatePlaybackWindow(0, 0, 0, "paused-b", 0, 0, 0, 2, true); err != nil {
+		t.Fatal(err)
+	}
+	if !tor.expired() {
+		t.Fatal("final release kept an otherwise idle torrent alive")
+	}
+}
diff --git a/server/torr/prefetch_capacity_http_test.go b/server/torr/prefetch_capacity_http_test.go
new file mode 100644
--- /dev/null
+++ b/server/torr/prefetch_capacity_http_test.go
@@ -0,0 +1,549 @@
+package torr
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha1"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"os/exec"
+	"testing"
+	"time"
+
+	"github.com/anacrolix/torrent"
+	"github.com/anacrolix/torrent/bencode"
+	"github.com/anacrolix/torrent/metainfo"
+	"server/settings"
+	"server/torr/state"
+	"server/torr/storage/torrstor"
+)
+
+const capacityHTTPNonce = "0ab12cd3-4567-489a-bcde-0123456789ab"
+
+type capacityHTTPFixture struct {
+	torrent *Torrent
+	cache   *torrstor.Cache
+	payload []byte
+	quota   int64
+	length  int64
+	window  torrstor.PlaybackWindow
+}
+
+// This fixture uses real library piece verification and worker storage. Only
+// the retained window is populated; no tracker or peer can fill missing data.
+func newCapacityHTTPFixture(t *testing.T, length, quota int64) *capacityHTTPFixture {
+	t.Helper()
+	return newCapacityHTTPFixtureAt(t, length, quota, 0)
+}
+
+func newCapacityHTTPFixtureAt(t *testing.T, length, quota, current int64) *capacityHTTPFixture {
+	t.Helper()
+	const pieceLength = 64 << 10
+	payload := make([]byte, length)
+	for i := range payload {
+		payload[i] = byte(i*31 + i/251)
+	}
+	info := metainfo.Info{Name: "capacity.mkv", Length: length, PieceLength: pieceLength}
+	for offset := int64(0); offset < length; offset += pieceLength {
+		hash := sha1.Sum(payload[offset:min(offset+pieceLength, length)])
+		info.Pieces = append(info.Pieces, hash[:]...)
+	}
+	mi := metainfo.MetaInfo{InfoBytes: bencode.MustMarshal(info)}
+	spec := &torrent.TorrentSpec{InfoHash: mi.HashInfoBytes(), InfoBytes: mi.InfoBytes, DisplayName: info.Name}
+	store := torrstor.NewStorage(quota)
+	config := torrent.NewDefaultClientConfig()
+	config.DefaultStorage = store
+	config.DataDir = t.TempDir()
+	config.DisableTCP = true
+	config.DisableUTP = true
+	config.NoDHT = true
+	config.DisableTrackers = true
+	config.DisablePEX = true
+	config.NoDefaultPortForwarding = true
+	client, err := torrent.NewClient(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { client.Close() })
+	backend, _, err := client.AddTorrentSpec(spec)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cache := store.GetCache(spec.InfoHash)
+	if cache == nil {
+		t.Fatal("known metainfo did not create storage")
+	}
+	cache.SetTorrent(backend)
+	window, err := cache.UpdatePlaybackWindow(1, 0, length, "capacity-http", current, current, length, 1, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if window.Lower != current || window.Current != current || window.Upper != min(current+quota, length) {
+		t.Fatalf("expected physical quota %d at %d, got %+v", quota, current, window)
+	}
+	for i := int(current / pieceLength); int64(i)*pieceLength < window.Upper; i++ {
+		start := int64(i) * pieceLength
+		data := payload[start:min(start+pieceLength, length)]
+		if n, err := cache.Piece(info.Piece(i)).WriteAt(data, 0); n != len(data) || err != nil {
+			t.Fatalf("seed piece %d: n=%d err=%v", i, n, err)
+		}
+		backend.Piece(i).VerifyData()
+		if !backend.PieceState(i).Complete {
+			t.Fatalf("seeded piece %d failed SHA1 verification", i)
+		}
+	}
+	return &capacityHTTPFixture{
+		torrent: &Torrent{Torrent: backend, TorrentSpec: spec, Stat: state.TorrentWorking,
+			cache: cache, closed: backend.Closed(), Timestamp: time.Now().Unix()},
+		cache: cache, payload: payload, length: length, quota: quota, window: window,
+	}
+}
+
+func (f *capacityHTTPFixture) ack(t *testing.T) torrstor.PlaybackWindow {
+	t.Helper()
+	ack, err := f.cache.UpdatePlaybackWindow(1, 0, f.length, "capacity-http", f.window.Lower, f.window.Current, f.length, f.window.Revision+1, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.window = ack
+	return ack
+}
+
+func capacityHTTPRequest(t *testing.T, base, consumer, nonce string, start, end int64) *http.Request {
+	t.Helper()
+	query := url.Values{"playback_consumer": {consumer}, "playback_prefetch": {"1"}, "playback_prefetch_request": {nonce}}
+	req, err := http.NewRequest(http.MethodGet, base+"/stream/capacity.mkv?"+query.Encode(), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Header.Set("Range", fmt.Sprintf("bytes=%d-%d", start, end-1))
+	return req
+}
+
+func (f *capacityHTTPFixture) get(t *testing.T, consumer, nonce string, start, end int64) (*http.Response, []byte, error) {
+	t.Helper()
+	handlerDone := make(chan error, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		handlerDone <- f.torrent.Stream(1, req, w)
+	}))
+	defer server.Close()
+	client := &http.Client{Transport: &http.Transport{Proxy: nil, DisableKeepAlives: true}, Timeout: 3 * time.Second}
+	defer client.CloseIdleConnections()
+	response, err := client.Do(capacityHTTPRequest(t, server.URL, consumer, nonce, start, end))
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, readErr := io.ReadAll(response.Body)
+	response.Body.Close()
+	if err := <-handlerDone; err != nil {
+		t.Fatalf("Stream: %v", err)
+	}
+	if f.cache.Readers() != 0 || GetActiveStreams() != 0 {
+		t.Fatal("Stream returned without releasing its HTTP reader")
+	}
+	return response, data, readErr
+}
+
+func assertNoCapacityHTTPProof(t *testing.T, f *capacityHTTPFixture) {
+	t.Helper()
+	assertNoCapacityHTTPACK(t, f.ack(t))
+}
+
+func assertNoCapacityHTTPACK(t *testing.T, ack torrstor.PlaybackWindow) {
+	t.Helper()
+	if ack.PrefetchStop != nil {
+		t.Fatalf("non-capacity termination produced a stop: %+v", ack.PrefetchStop)
+	}
+	encoded, err := json.Marshal(ack)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(encoded, []byte(`"prefetch_stop"`)) {
+		t.Fatalf("absent proof leaked into ACK JSON: %s", encoded)
+	}
+}
+
+// Stream writes the process-wide Viewed database. Its settings and background
+// cache goroutines must live in a separate process from other package tests.
+func TestStreamPrefetchCapacityProof(t *testing.T) {
+	const childKey = "KHUA_STREAM_CAPACITY_HTTP_TEST_CHILD"
+	if os.Getenv(childKey) != "1" {
+		ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+		defer cancel()
+		cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestStreamPrefetchCapacityProof$", "-test.v")
+		cmd.Env = append(os.Environ(), childKey+"=1")
+		output, err := cmd.CombinedOutput()
+		if err != nil {
+			t.Fatalf("isolated capacity HTTP test: %v\n%s", err, output)
+		}
+		t.Logf("isolated capacity HTTP test:\n%s", output)
+		return
+	}
+	settings.Path = t.TempDir()
+	settings.Args = &settings.ExecArgs{}
+	if err := settings.InitSets(false, false); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(settings.CloseDB)
+	settings.BTsets.ReaderReadAHead = 95
+	settings.BTsets.TorrentDisconnectTimeout = 30
+	settings.BTsets.ConnectionsLimit = 25
+	settings.BTsets.UseDisk = false
+	settings.BTsets.ResponsiveMode = true
+	settings.BTsets.TrackTimecode = false
+	const length, quota = int64(512 << 10), int64(256 << 10)
+	const start, end = int64(32<<10 + 17), int64(448<<10 + 31)
+
+	t.Run("paused-midfile-repeated-suffix-keeps-final-piece-credit", func(t *testing.T) {
+		const piece = int64(64 << 10)
+		const lower, upper = 4 * piece, 12 * piece
+		f := newCapacityHTTPFixtureAt(t, 16*piece, 8*piece, lower)
+		if f.cache.GetState().Filled != 8*piece {
+			t.Fatal("paused midfile window was not fully resident")
+		}
+		for retry := 0; retry < 4; retry++ {
+			nonce := fmt.Sprintf("0ab12cd3-4567-489a-bcde-%012x", retry+1)
+			// The paused ACK grants exactly this last piece of credit. Creating
+			// a fresh HTTP reader must not charge a phantom piece at offset zero.
+			response, data, err := f.get(t, "capacity-http", nonce, 11*piece, upper)
+			if response.StatusCode != http.StatusPartialContent || response.ContentLength != piece || err != nil || !bytes.Equal(data, f.payload[11*piece:upper]) {
+				t.Fatalf("suffix retry %d: status=%d promised=%d actual=%d err=%v; paused ACK=%+v", retry, response.StatusCode, response.ContentLength, len(data), err, f.window)
+			}
+			ack := f.ack(t)
+			if ack.Lower != lower || ack.Current != lower || ack.Upper != upper || ack.Revision != uint64(retry+2) {
+				t.Fatalf("suffix retry %d changed the paused window: %+v", retry, ack)
+			}
+			assertNoCapacityHTTPACK(t, ack)
+			if resident := f.cache.GetState(); resident.Filled != 8*piece {
+				t.Fatalf("suffix retry %d lost retained paused bytes: filled=%d pieces=%+v", retry, resident.Filled, resident.Pieces)
+			}
+			t.Logf("suffix retry=%d full_bytes=%d paused_window=[%d,%d) revision=%d no_capacity_stop", retry, len(data), ack.Lower, ack.Upper, ack.Revision)
+		}
+	})
+
+	t.Run("foreground-resume-serves-whole-paused-window-without-peers", func(t *testing.T) {
+		const piece = int64(64 << 10)
+		const lower, upper = 4 * piece, 12 * piece
+		f := newCapacityHTTPFixtureAt(t, 16*piece, 8*piece, lower)
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+			if err := f.torrent.Stream(1, req, w); err != nil {
+				t.Errorf("foreground Stream: %v", err)
+			}
+		}))
+		defer server.Close()
+		transport := &http.Transport{Proxy: nil}
+		defer transport.CloseIdleConnections()
+		client := &http.Client{Transport: transport, Timeout: 3 * time.Second}
+		for retry := 0; retry < 3; retry++ {
+			req, err := http.NewRequest(http.MethodGet, server.URL+"/stream/capacity.mkv?playback_consumer=capacity-http", nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			req.Header.Set("Range", fmt.Sprintf("bytes=%d-%d", lower, upper-1))
+			response, err := client.Do(req)
+			if err != nil {
+				t.Fatal(err)
+			}
+			data, readErr := io.ReadAll(response.Body)
+			response.Body.Close()
+			if response.StatusCode != http.StatusPartialContent || readErr != nil || !bytes.Equal(data, f.payload[lower:upper]) {
+				t.Fatalf("resumed foreground retry%d: status%d bytes%d err%v", retry, response.StatusCode, len(data), readErr)
+			}
+			deadline := time.Now().Add(time.Second)
+			for (f.cache.Readers() != 0 || GetActiveStreams() != 0) && time.Now().Before(deadline) {
+				time.Sleep(time.Millisecond)
+			}
+			if f.cache.Readers() != 0 || GetActiveStreams() != 0 {
+				t.Fatal("foreground response did not release its reader")
+			}
+			ack := f.ack(t)
+			if ack.Lower != lower || ack.Current != lower || ack.Upper != upper || f.cache.GetState().Filled != 8*piece {
+				t.Fatalf("foreground response changed resident paused coverage: %+v resident=%d", ack, f.cache.GetState().Filled)
+			}
+			t.Logf("foreground retry%d exact_cached_body%d resident%d no_peers=true", retry, len(data), f.cache.GetState().Filled)
+		}
+	})
+
+	t.Run("foreground-if-range-mismatch-keeps-whole-body", func(t *testing.T) {
+		// If-Range may make ServeContent ignore a finite Range and return 200.
+		// Such conditional requests retain the legacy unbounded reader path.
+		f := newCapacityHTTPFixture(t, 512<<10, 512<<10)
+		req := httptest.NewRequest(http.MethodGet, "/stream/capacity.mkv?playback_consumer=capacity-http", nil)
+		req.Header.Set("Range", "bytes=65536-131071")
+		req.Header.Set("If-Range", `"different-version"`)
+		w := httptest.NewRecorder()
+		if err := f.torrent.Stream(1, req, w); err != nil {
+			t.Fatal(err)
+		}
+		if w.Code != http.StatusOK || !bytes.Equal(w.Body.Bytes(), f.payload) {
+			t.Fatalf("conditional foreground response: status=%d bytes=%d want=%d", w.Code, w.Body.Len(), len(f.payload))
+		}
+		if f.cache.Readers() != 0 || GetActiveStreams() != 0 {
+			t.Fatal("conditional response did not release its reader")
+		}
+	})
+
+	t.Run("quota-short-206-publishes-exact-proof", func(t *testing.T) {
+		f := newCapacityHTTPFixture(t, length, quota)
+		response, data, err := f.get(t, "capacity-http", capacityHTTPNonce, start, end)
+		wantRange := fmt.Sprintf("bytes %d-%d/%d", start, end-1, length)
+		if response.StatusCode != http.StatusPartialContent || response.ContentLength != end-start || response.Header.Get("Content-Range") != wantRange {
+			t.Fatalf("HTTP status=%d length=%d range=%q", response.StatusCode, response.ContentLength, response.Header.Get("Content-Range"))
+		}
+		if !errors.Is(err, io.ErrUnexpectedEOF) || !bytes.Equal(data, f.payload[start:quota]) {
+			t.Fatalf("quota response: bytes=%d want=%d readErr=%v", len(data), quota-start, err)
+		}
+		ack := f.ack(t)
+		want := torrstor.PlaybackPrefetchStop{Reason: "capacity", RequestID: capacityHTTPNonce,
+			FileIndex: 1, RangeStart: start, RangeEnd: end, NextOffset: quota, Revision: 1}
+		if ack.Revision != 2 || ack.PrefetchStop == nil || *ack.PrefetchStop != want {
+			t.Fatalf("next ACK: %+v, stop=%+v want=%+v", ack, ack.PrefetchStop, want)
+		}
+		encoded, err := json.Marshal(ack)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var wire struct {
+			Stop struct {
+				Reason   string `json:"reason"`
+				Request  string `json:"request_id"`
+				File     int    `json:"file_index"`
+				Start    int64  `json:"range_start"`
+				End      int64  `json:"range_end"`
+				Next     int64  `json:"next_offset"`
+				Revision uint64 `json:"revision"`
+			} `json:"prefetch_stop"`
+		}
+		if err := json.Unmarshal(encoded, &wire); err != nil {
+			t.Fatal(err)
+		}
+		if wire.Stop.Reason != "capacity" || wire.Stop.Request != capacityHTTPNonce || wire.Stop.File != 1 || wire.Stop.Start != start || wire.Stop.End != end || wire.Stop.Next != start+int64(len(data)) || wire.Stop.Revision != 1 {
+			t.Fatalf("incorrect wire proof: %s", encoded)
+		}
+		t.Logf("HTTP206 promised=%d actual=%d error=%v ACK=%s", response.ContentLength, len(data), err, encoded)
+	})
+
+	t.Run("generic-missing-window-short-response", func(t *testing.T) {
+		f := newCapacityHTTPFixture(t, length, quota)
+		response, data, err := f.get(t, "unmatched-consumer", capacityHTTPNonce, start, end)
+		if response.StatusCode != http.StatusPartialContent || len(data) != 0 || !errors.Is(err, io.ErrUnexpectedEOF) {
+			t.Fatalf("generic short response: status=%d bytes=%d err=%v", response.StatusCode, len(data), err)
+		}
+		ack, updateErr := f.cache.UpdatePlaybackWindow(1, 0, length, "unmatched-consumer", 0, 0, length, 2, false)
+		if updateErr != nil {
+			t.Fatal(updateErr)
+		}
+		assertNoCapacityHTTPACK(t, ack)
+	})
+
+	t.Run("completed-requested-range", func(t *testing.T) {
+		f := newCapacityHTTPFixture(t, length, quota)
+		response, data, err := f.get(t, "capacity-http", capacityHTTPNonce, start, quota)
+		if response.StatusCode != http.StatusPartialContent || err != nil || !bytes.Equal(data, f.payload[start:quota]) {
+			t.Fatalf("complete response: status=%d bytes=%d err=%v", response.StatusCode, len(data), err)
+		}
+		assertNoCapacityHTTPProof(t, f)
+	})
+
+	t.Run("file-eof", func(t *testing.T) {
+		f := newCapacityHTTPFixture(t, quota, quota)
+		response, data, err := f.get(t, "capacity-http", capacityHTTPNonce, start, end)
+		if response.StatusCode != http.StatusPartialContent || response.ContentLength != quota-start || err != nil || !bytes.Equal(data, f.payload[start:quota]) {
+			t.Fatalf("file EOF response: status=%d length=%d bytes=%d err=%v", response.StatusCode, response.ContentLength, len(data), err)
+		}
+		assertNoCapacityHTTPProof(t, f)
+	})
+
+	for _, invalid := range []string{"", "not-a-uuid", "0ab12cd3-4567-489a-bcde-0123456789ag"} {
+		t.Run("invalid-request-id/"+invalid, func(t *testing.T) {
+			f := newCapacityHTTPFixture(t, length, quota)
+			response, data, err := f.get(t, "capacity-http", invalid, start, end)
+			if response.StatusCode != http.StatusPartialContent || !errors.Is(err, io.ErrUnexpectedEOF) || !bytes.Equal(data, f.payload[start:quota]) {
+				t.Fatalf("unidentified response: status=%d bytes=%d err=%v", response.StatusCode, len(data), err)
+			}
+			assertNoCapacityHTTPProof(t, f)
+		})
+	}
+
+	for _, mode := range []string{"writer-error", "short-write", "context-canceled"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newCapacityHTTPFixture(t, length, quota)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			req := capacityHTTPRequest(t, "http://localhost", "capacity-http", capacityHTTPNonce, start, end).WithContext(ctx)
+			writer := &capacityHTTPFaultWriter{ResponseRecorder: httptest.NewRecorder(), mode: mode, cancel: cancel}
+			if err := f.torrent.Stream(1, req, writer); err != nil {
+				t.Fatal(err)
+			}
+			if writer.Code != http.StatusPartialContent || writer.calls == 0 {
+				t.Fatalf("fault path not exercised: status=%d calls=%d", writer.Code, writer.calls)
+			}
+			if mode == "context-canceled" && !errors.Is(req.Context().Err(), context.Canceled) {
+				t.Fatal("request was not canceled")
+			}
+			assertNoCapacityHTTPProof(t, f)
+		})
+	}
+
+	t.Run("cancel-after-capacity-source-eof", func(t *testing.T) {
+		f := newCapacityHTTPFixture(t, length, quota)
+		base, cancel := context.WithCancel(context.Background())
+		defer cancel()
+		ctx := &capacityHTTPPublicationCancelContext{Context: base, cancel: cancel}
+		req := capacityHTTPRequest(t, "http://localhost", "capacity-http", capacityHTTPNonce, start, end).WithContext(ctx)
+		writer := httptest.NewRecorder()
+		if err := f.torrent.Stream(1, req, writer); err != nil {
+			t.Fatal(err)
+		}
+		if writer.Code != http.StatusPartialContent || !bytes.Equal(writer.Body.Bytes(), f.payload[start:quota]) {
+			t.Fatalf("late cancel did not follow the full quota prefix: status=%d bytes=%d", writer.Code, writer.Body.Len())
+		}
+		if ctx.calls != 1 || !errors.Is(base.Err(), context.Canceled) {
+			t.Fatalf("publication boundary was not canceled: checks=%d err=%v", ctx.calls, base.Err())
+		}
+		assertNoCapacityHTTPProof(t, f)
+	})
+
+	t.Run("actual-http-client-disconnect", func(t *testing.T) {
+		f := newCapacityHTTPFixture(t, length, quota)
+		handlerDone := make(chan error, 1)
+		disconnected := make(chan struct{}, 1)
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+			writer := &capacityHTTPDisconnectWriter{ResponseWriter: w, context: req.Context(), disconnected: disconnected}
+			handlerDone <- f.torrent.Stream(1, req, writer)
+		}))
+		defer server.Close()
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		req := capacityHTTPRequest(t, server.URL, "capacity-http", capacityHTTPNonce, start, end).WithContext(ctx)
+		client := &http.Client{Transport: &http.Transport{Proxy: nil, DisableKeepAlives: true}}
+		defer client.CloseIdleConnections()
+		response, err := client.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer response.Body.Close()
+		first := make([]byte, 1)
+		if response.StatusCode != http.StatusPartialContent {
+			t.Fatalf("disconnect response status=%d", response.StatusCode)
+		}
+		if _, err := io.ReadFull(response.Body, first); err != nil || first[0] != f.payload[start] {
+			t.Fatalf("disconnect before actual payload: first=%v err=%v", first, err)
+		}
+		cancel()
+		select {
+		case <-disconnected:
+		case <-time.After(3 * time.Second):
+			t.Fatal("server did not observe the real client's disconnect")
