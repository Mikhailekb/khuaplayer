diff --git a/server/torr/storage/torrstor/cache_ranges.go b/server/torr/storage/torrstor/cache_ranges.go
new file mode 100644
--- /dev/null
+++ b/server/torr/storage/torrstor/cache_ranges.go
@@ -0,0 +1,76 @@
+package torrstor
+
+import (
+	"errors"
+	"math"
+)
+
+// Each extent is a file-relative half-open interval backed by a complete RAM
+// payload, not a future retention window or the torrent library's progress bit.
+type CachedByteRange [2]int64
+
+type FileCacheSnapshot struct {
+	Hash          string            `json:"hash"`
+	FileIndex     int               `json:"file_index"`
+	FileOffset    int64             `json:"file_offset"`
+	FileLength    int64             `json:"file_length"`
+	PieceLength   int64             `json:"piece_length"`
+	ResidentBytes int64             `json:"resident_bytes"`
+	Ranges        []CachedByteRange `json:"ranges"`
+}
+
+const MaxCachedFileRanges = 32768
+
+var ErrCacheSnapshotTooFragmented = errors.New("resident cache snapshot is too fragmented")
+
+// FileCacheSnapshot only observes existing allocations. It never creates a
+// torrent reader, changes policy, touches access times or requests missing data.
+func (c *Cache) FileCacheSnapshot(fileIndex int, fileOffset, fileLength int64) (FileCacheSnapshot, error) {
+	if c == nil {
+		return FileCacheSnapshot{}, ErrPlaybackCacheClosed
+	}
+	c.muPolicy.Lock()
+	defer c.muPolicy.Unlock()
+	if c.isClosed.Load() {
+		return FileCacheSnapshot{}, ErrPlaybackCacheClosed
+	}
+	if fileIndex <= 0 || fileOffset < 0 || fileLength <= 0 || fileOffset > math.MaxInt64-fileLength || c.pieceLength <= 0 || fileOffset+fileLength > c.totalLength {
+		return FileCacheSnapshot{}, ErrInvalidPlaybackWindow
+	}
+	result := FileCacheSnapshot{Hash: c.hash.HexString(), FileIndex: fileIndex, FileOffset: fileOffset, FileLength: fileLength, PieceLength: c.pieceLength, Ranges: make([]CachedByteRange, 0)}
+	first, last := int(fileOffset/c.pieceLength), int((fileOffset+fileLength-1)/c.pieceLength)
+	pieces := c.getPieces()
+	for id := first; id <= last; id++ {
+		p := pieces[id]
+		if p == nil {
+			continue
+		}
+		expected := c.pieceBytes(id)
+		p.mu.Lock()
+		resident := expected > 0 && p.Complete && p.Size >= expected && p.mPiece != nil && int64(len(p.mPiece.buffer)) >= expected
+		p.mu.Unlock()
+		if !resident {
+			continue
+		}
+		start := int64(id) * c.pieceLength
+		end := start + expected
+		lower, upper := max(start, fileOffset)-fileOffset, min(end, fileOffset+fileLength)-fileOffset
+		if upper <= lower {
+			continue
+		}
+		result.ResidentBytes += upper - lower
+		count := len(result.Ranges)
+		if count > 0 && result.Ranges[count-1][1] == lower {
+			result.Ranges[count-1][1] = upper
+		} else {
+			if count >= MaxCachedFileRanges {
+				return FileCacheSnapshot{}, ErrCacheSnapshotTooFragmented
+			}
+			result.Ranges = append(result.Ranges, CachedByteRange{lower, upper})
+		}
+	}
+	if c.isClosed.Load() {
+		return FileCacheSnapshot{}, ErrPlaybackCacheClosed
+	}
+	return result, nil
+}
diff --git a/server/torr/storage/torrstor/cache_ranges_test.go b/server/torr/storage/torrstor/cache_ranges_test.go
new file mode 100644
