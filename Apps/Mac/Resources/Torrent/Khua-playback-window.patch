+package api
+
+import (
+	"encoding/hex"
+	"errors"
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+	"server/torr"
+	"server/torr/storage/torrstor"
+)
+
+type playbackBackgroundRequest struct {
+	Hash     string `json:"hash"`
+	Consumer string `json:"consumer"`
+	Parent   string `json:"parent"`
+	Remove   bool   `json:"remove"`
+}
+
+func playbackBackground(c *gin.Context) {
+	handlePlaybackBackground(c, func(req playbackBackgroundRequest) error {
+		return torr.RemovePlaybackBackground(req.Hash, req.Consumer, req.Parent)
+	})
+}
+
+func handlePlaybackBackground(c *gin.Context, remove func(playbackBackgroundRequest) error) {
+	var req playbackBackgroundRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid background cleanup JSON"})
+		return
+	}
+	hash, err := hex.DecodeString(req.Hash)
+	if err != nil || len(hash) != 20 || !req.Remove || !playbackConsumerPattern.MatchString(req.Consumer) || !playbackConsumerPattern.MatchString(req.Parent) || req.Consumer == req.Parent {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid background cleanup"})
+		return
+	}
+	if err := remove(req); err != nil {
+		status := http.StatusBadRequest
+		if errors.Is(err, torrstor.ErrBackgroundLimit) {
+			status = http.StatusTooManyRequests
+		}
+		c.JSON(status, gin.H{"error": err.Error()})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"removed": true})
+}
