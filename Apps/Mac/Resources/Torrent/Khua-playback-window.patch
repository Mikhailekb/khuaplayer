+func TestPlaybackFileSwitchAllowsCoreReadButPrefetchWaitsForMatchingWindow(t *testing.T) {
+	const mib = 1 << 20
+	info := metainfo.Info{Name: "episodes", PieceLength: mib, Files: []metainfo.FileInfo{
+		{Path: []string{"A.mkv"}, Length: 32 * mib},
+		{Path: []string{"B.mkv"}, Length: 16 * mib},
+	}, Pieces: make([]byte, 48*20)}
+	files, c := playbackTestTorrentFiles(t, info, 8*mib)
+	fileA, fileB := files[0], files[1]
+	if fileA.Offset() == fileB.Offset() || fileA.Length() == fileB.Length() {
+		t.Fatal("fixture must distinguish both the file offset and length")
+	}
+	if _, err := c.UpdatePlaybackWindow(1, fileA.Offset(), fileA.Length(), "same-consumer", 8*mib, 10*mib, 32*mib, 1, false); err != nil {
+		t.Fatal(err)
+	}
+	aRetained := seedRetainedPayloads(t, c, 10, 11)
+
+	reader := c.NewPlaybackReader(fileB, "same-consumer")
+	defer c.CloseReader(reader)
+	bPiece := int(fileB.Offset() / mib)
+	bRetained := seedRetainedPayloads(t, c, bPiece)
+	reader.mu.Lock()
+	managed, maxOffset := reader.managed, reader.maxOffset
+	reader.mu.Unlock()
+	if !managed || maxOffset != 0 {
+		t.Fatalf("new file unexpectedly inherited old file's window bound: managed=%v maxOffset=%d", managed, maxOffset)
+	}
+
+	// The decoder needs ordinary metadata/media reads before it can submit a
+	// coherent packet-derived window for B. A's retained window must not clip it.
+	got := make([]byte, 64)
+	if n, err := reader.Read(got); err != nil || n != len(got) || !bytes.Equal(got, bRetained[bPiece].bytes[:len(got)]) {
+		t.Fatalf("Core read of B was clipped by retained A window: n=%d err=%v", n, err)
+	}
+	assertRetainedPayloads(t, c, aRetained)
+	assertPausedWindow(t, c, "same-consumer", 1)
+
+	reader.SetPlaybackPrefetch(true)
+	before := reader.Offset()
+	if n, err := reader.Read(make([]byte, 64)); n != 0 || !errors.Is(err, io.EOF) {
+		t.Fatalf("B prefetch ran before matching ACK: n=%d err=%v", n, err)
+	}
+	if reader.Offset() != before {
+		t.Fatal("rejected prefetch advanced the decoder's file position")
+	}
+	assertRetainedPayloads(t, c, aRetained)
+	assertNoMissingPiecePriority(t, c)
+
+	// A higher revision switches ownership atomically to B. The same prefetch
+	// reader can then continue at its original B offset without being recreated.
+	ack, err := c.UpdatePlaybackWindow(2, fileB.Offset(), fileB.Length(), "same-consumer", 0, before, fileB.Length(), 2, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ack.Upper <= before {
+		t.Fatalf("matching B ACK did not authorize forward reads: %+v", ack)
+	}
+	got = make([]byte, 64)
+	if n, err := reader.Read(got); err != nil || n != len(got) || !bytes.Equal(got, bRetained[bPiece].bytes[before:before+int64(len(got))]) {
+		t.Fatalf("prefetch did not resume after matching B ACK: n=%d err=%v", n, err)
+	}
+	assertPausedWindow(t, c, "same-consumer", 2)
+	assertRetainedPayloads(t, c, bRetained)
+}
+
+type playbackRangeObservationWriter struct {
+	http.ResponseWriter
+	once    sync.Once
+	observe func()
+}
+
+func (w *playbackRangeObservationWriter) Write(p []byte) (int, error) {
+	w.once.Do(w.observe)
+	return w.ResponseWriter.Write(p)
+}
+
+// This short request has no Torrent.progressEvent timer: a real HTTP Range
+// must expose useful bounded lookahead before the first response body write.
+func TestPlaybackShortHTTPRangeImmediatelySchedulesOnlyWindowLookahead(t *testing.T) {
+	const mib = 1 << 20
+	file, c := playbackTestTorrent(t, 64*mib, 4*mib)
+	const current = 32*mib + 128*(1<<10)
+	window := setWindow(t, c, "range", 32*mib, current, 64*mib, 1)
+	if window.Upper != 36*mib {
+		t.Fatalf("window %+v", window)
+	}
+	seedRetainedPayloads(t, c, 32)
+	type observation struct {
+		future      bool
+		outOfBounds []int
+		premature   []int
+	}
+	observed := make(chan observation, 1)
+	done := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		reader := c.NewPlaybackReader(file, "range")
+		reader.SetResponsive()
+		defer func() { c.CloseReader(reader); close(done) }()
+		initial := []int{}
+		// Byte zero is the library's necessary initial cursor. An initial lookahead
+		// must not request old missing pieces before ServeContent seeks the range.
+		for id := 1; id < 32; id++ {
+			if c.torrent.PieceState(id).Priority != torrent.PiecePriorityNone {
+				initial = append(initial, id)
+			}
+		}
+		wrapped := &playbackRangeObservationWriter{ResponseWriter: w, observe: func() {
+			got := observation{future: c.torrent.PieceState(33).Priority != torrent.PiecePriorityNone, premature: initial}
+			for id := 0; id < c.pieceCount; id++ {
+				if (id < 32 || id >= 36) && c.torrent.PieceState(id).Priority != torrent.PiecePriorityNone {
+					got.outOfBounds = append(got.outOfBounds, id)
+				}
+			}
+			observed <- got
+		}}
+		w.Header().Set("Content-Type", "video/x-matroska")
+		http.ServeContent(wrapped, req, file.Path(), time.Time{}, reader)
+	}))
+	defer server.Close()
+	req, err := http.NewRequest(http.MethodGet, server.URL, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Header.Set("Range", fmt.Sprintf("bytes=%d-%d", current, current+(256<<10)-1))
+	client := server.Client()
+	client.Timeout = 5 * time.Second
+	response, err := client.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := io.ReadAll(response.Body)
+	response.Body.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	<-done
+	if response.StatusCode != http.StatusPartialContent || len(data) != 256<<10 || !bytes.Equal(data, bytes.Repeat([]byte{33}, 256<<10)) {
+		t.Fatalf("range payload: status%d len%d", response.StatusCode, len(data))
+	}
+	got := <-observed
+	if len(got.premature) > 0 || len(got.outOfBounds) > 0 {
+		t.Fatalf("lookahead outside applied window: before seek=%v while reading=%v", got.premature, got.outOfBounds)
+	}
+	if !got.future {
+		t.Fatal("short HTTP range scheduled only its current piece until the one-second progress tick")
+	}
+	c.cleanPiecesSync()
+	c.clearPriority()
+	assertNoMissingPiecePriority(t, c)
+}
+
+// Piece-state publication preserves transient changes, unlike checking only
+// after Read returned. The sentinel flushes all preceding state publications.
+func TestPlaybackReadAdvanceDoesNotExtendRelativeLookaheadPastUpper(t *testing.T) {
+	const mib = 1 << 20
+	file, c := playbackTestTorrent(t, 64*mib, 4*mib)
+	const current = 32*mib + 128*(1<<10)
+	setWindow(t, c, "advance", 32*mib, current, 64*mib, 1)
+	seedRetainedPayloads(t, c, 32)
+	reader := c.NewPlaybackReader(file, "advance")
+	defer c.CloseReader(reader)
+	reader.SetResponsive()
+	if _, err := reader.Seek(current, io.SeekStart); err != nil {
+		t.Fatal(err)
+	}
+	sub := c.torrent.SubscribePieceStateChanges()
+	defer sub.Close()
+	result := make(chan []int, 1)
+	go func() {
+		outside := []int{}
+		for value := range sub.Values {
+			change := value.(torrent.PieceStateChange)
+			if change.Index == 63 && change.Priority == torrent.PiecePriorityHigh {
+				result <- outside
+				return
+			}
+			if change.Index >= 36 && change.Priority != torrent.PiecePriorityNone {
+				outside = append(outside, change.Index)
+			}
+		}
+	}()
+	data := make([]byte, 256<<10)
+	if n, err := reader.Read(data); err != nil || n != len(data) {
+		t.Fatalf("Read %d %v", n, err)
+	}
+	c.torrent.Piece(63).SetPriority(torrent.PiecePriorityHigh)
+	outside := <-result
+	c.torrent.Piece(63).SetPriority(torrent.PiecePriorityNone)
+	if len(outside) > 0 {
+		t.Fatalf("relative lookahead transiently prioritized outside upper: %v", outside)
+	}
+}
+
+func TestPlaybackPrefetchAtUpperParksAndResumesOnlyAfterExpansion(t *testing.T) {
+	const mib = 1 << 20
+	file, c := playbackTestTorrent(t, 64*mib, 4*mib)
+	setWindow(t, c, "end", 3*mib, 3*mib+3*mib/4, 64*mib, 1)
+	// Capacity bounds this window to piece 3 plus three future pieces; request a
+	// deliberately smaller upper so this read finishes at an exact boundary.
+	if _, err := c.UpdatePlaybackWindow(1, 0, 64*mib, "end", 3*mib, 3*mib+3*mib/4, 4*mib, 2, false); err != nil {
+		t.Fatal(err)
+	}
+	seedRetainedPayloads(t, c, 3)
+	reader := c.NewPlaybackReader(file, "end")
+	defer c.CloseReader(reader)
+	reader.SetResponsive()
+	reader.SetPlaybackPrefetch(true)
+	if _, err := reader.Seek(3*mib+3*mib/4, io.SeekStart); err != nil {
+		t.Fatal(err)
+	}
+	data := make([]byte, 256<<10)
+	if n, err := reader.Read(data); err != nil || n != len(data) {
+		t.Fatalf("bounded read %d %v", n, err)
+	}
+	if reader.Offset() != 4*mib || reader.active() {
+		t.Fatalf("fill did not park at logical upper: offset%d active%v", reader.Offset(), reader.active())
+	}
+	if pos, err := reader.Reader.Seek(0, io.SeekCurrent); err != nil || pos != file.Length() {
+		t.Fatalf("underlying reader not parked at EOF: %d %v", pos, err)
+	}
+	c.clearPriority()
+	assertNoMissingPiecePriority(t, c)
+	if n, err := reader.Read(data); n != 0 || err != io.EOF {
+		t.Fatalf("read past upper %d %v", n, err)
+	}
+	if _, err := c.UpdatePlaybackWindow(1, 0, 64*mib, "end", 3*mib, 3*mib+3*mib/4, 8*mib, 3, false); err != nil {
+		t.Fatal(err)
+	}
+	seedRetainedPayloads(t, c, 4)
+	if n, err := reader.Read(data[:64]); err != nil || n != 64 || !bytes.Equal(data[:64], bytes.Repeat([]byte{5}, 64)) {
+		t.Fatalf("expanded reader failed logical resume: %d %v", n, err)
+	}
+}
