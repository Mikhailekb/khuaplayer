+func TestFileCacheSnapshotActualHTTPUsesMetainfoOffsetsAndResidentPayload(t *testing.T) {
+	const child = "KINOLET_CACHE_SNAPSHOT_HTTP"
+	if os.Getenv(child) != "1" {
+		ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+		defer cancel()
+		cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestFileCacheSnapshotActualHTTPUsesMetainfoOffsetsAndResidentPayload$", "-test.v")
+		cmd.Env = append(os.Environ(), child+"=1")
+		out, err := cmd.CombinedOutput()
+		if err != nil {
+			t.Fatalf("isolatedsnapshotHTTP:%v\n%s", err, out)
+		}
+		t.Logf("%s", out)
+		return
+	}
+	gin.SetMode(gin.TestMode)
+	config.Path = t.TempDir()
+	config.Args = &config.ExecArgs{}
+	const piece = int64(64 << 10)
+	config.BTsets = &config.BTSets{CacheSize: 8 * piece, TorrentDisconnectTimeout: 30, DisableTCP: true, DisableUTP: true, DisableDHT: true, DisablePEX: true, DisableUPNP: true, DisableUpload: true, ConnectionsLimit: 1}
+	config.PubIPv4 = "203.0.113.1"
+	config.HttpAuth = true
+	trackerList := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("udp://127.0.0.1:1/announce\n")) }))
+	defer trackerList.Close()
+	config.BTsets.TrackersListURL = trackerList.URL
+	bt := torr.NewBTS()
+	if err := bt.Connect(); err != nil {
+		t.Fatal(err)
+	}
+	defer bt.Disconnect()
+	// Natural order is A,B but the real torrent byte order is B,A.
+	info := metainfo.Info{Name: "Show", PieceLength: piece, Files: []metainfo.FileInfo{{Length: piece + 13, Path: []string{"B.mkv"}}, {Length: 2*piece + 198, Path: []string{"A.mkv"}}}}
+	payload := make([]byte, info.TotalLength())
+	for i := range payload {
+		payload[i] = byte(i*31 + i/17)
+	}
+	for offset := int64(0); offset < int64(len(payload)); offset += piece {
+		sum := sha1.Sum(payload[offset:min(int64(len(payload)), offset+piece)])
+		info.Pieces = append(info.Pieces, sum[:]...)
+	}
+	mi := metainfo.MetaInfo{InfoBytes: bencode.MustMarshal(info)}
+	tor, err := torr.NewTorrent(&torrent.TorrentSpec{InfoHash: mi.HashInfoBytes(), InfoBytes: mi.InfoBytes}, bt)
+	if err != nil || !tor.GotInfo() {
+		t.Fatalf("newtorrent:%v", err)
+	}
+	cache := tor.GetCache()
+	r := gin.New()
+	r.Use(auth.BasicAuth(gin.Accounts{"test": "private"}))
+	SetupRoute(r)
+	server := httptest.NewServer(r)
+	defer server.Close()
+	client := server.Client()
+	client.Timeout = 3 * time.Second
+	snapshot := func(index, status int) torrstor.FileCacheSnapshot {
+		t.Helper()
+		body := fmt.Sprintf(`{"hash":%q,"file_index":%d}`, mi.HashInfoBytes().HexString(), index)
+		req, _ := http.NewRequest("POST", server.URL+"/playback/cache", strings.NewReader(body))
+		req.Header.Set("Content-Type", "application/json")
+		req.SetBasicAuth("test", "private")
+		resp, err := client.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer resp.Body.Close()
+		if resp.StatusCode != status {
+			data, _ := io.ReadAll(resp.Body)
+			t.Fatalf("status%d want%d %s", resp.StatusCode, status, data)
+		}
+		var s torrstor.FileCacheSnapshot
+		if status == 200 {
+			if err := json.NewDecoder(resp.Body).Decode(&s); err != nil {
+				t.Fatal(err)
+			}
+		}
+		return s
+	}
+	empty := snapshot(1, 200)
+	if empty.ResidentBytes != 0 || len(empty.Ranges) != 0 || empty.Ranges == nil {
+		t.Fatalf("emptycurrentfile%+v", empty)
+	}
+	for _, id := range []int{0, 1, 3} {
+		start := int64(id) * piece
+		data := payload[start:min(int64(len(payload)), start+piece)]
+		if n, err := cache.Piece(info.Piece(id)).WriteAt(data, 0); err != nil || n != len(data) {
+			t.Fatal("write")
+		}
+		tor.Torrent.Piece(id).VerifyData()
+		if !tor.Torrent.PieceState(id).Complete {
+			t.Fatal("SHA1failed")
+		}
+	}
+	cache.Piece(info.Piece(2)).WriteAt(payload[2*piece:2*piece+128], 0)
+	before := cache.GetState()
+	if before.Filled <= 2*piece {
+		t.Fatal("globalcounterisnotlarge")
+	}
+	a := snapshot(1, 200)
+	want := []torrstor.CachedByteRange{{0, piece - 13}, {2*piece - 13, 2*piece + 198}}
+	if a.FileOffset != piece+13 || a.FileLength != 2*piece+198 || !reflect.DeepEqual(a.Ranges, want) || a.ResidentBytes != piece-13+211 {
+		t.Fatalf("Aactualoffsetorholeswrong:%+v", a)
+	}
+	b := snapshot(2, 200)
+	if b.FileOffset != 0 || b.ResidentBytes != piece+13 || !reflect.DeepEqual(b.Ranges, []torrstor.CachedByteRange{{0, piece + 13}}) {
+		t.Fatalf("Bactualoffset%+v", b)
+	}
+	after := cache.GetState()
+	if before.Filled != after.Filled || cache.Readers() != 0 {
+		t.Fatal("snapshotchangedcache/readers")
+	}
+	for id := 0; id < info.NumPieces(); id++ {
+		if tor.Torrent.PieceState(id).Priority != torrent.PiecePriorityNone {
+			t.Fatalf("snapshotcreatedpiecepriority%d", id)
+		}
+	}
+	if _, err := cache.UpdatePlaybackWindow(1, piece+13, 2*piece+198, "active", 2*piece-13, 2*piece-13, 2*piece+198, 1, false); err != nil {
+		t.Fatal(err)
+	}
+	evicted := snapshot(1, 200)
+	if evicted.ResidentBytes != 211 || !reflect.DeepEqual(evicted.Ranges, []torrstor.CachedByteRange{{2*piece - 13, 2*piece + 198}}) {
+		t.Fatalf("evictedbytesstillcolored%+v", evicted)
+	}
+	snapshot(99, 404)
+	t.Logf("legacy_global_resident=%d selected_A_complete=%d file_offset=%d holes=%v post_eviction=%d readers=%d no_external_peers=true", before.Filled, a.ResidentBytes, a.FileOffset, a.Ranges, evicted.ResidentBytes, cache.Readers())
+	var wg sync.WaitGroup
+	started := make(chan struct{})
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		close(started)
+		for n := 0; n < 50; n++ {
+			_, err := torr.SnapshotFileCache(mi.HashInfoBytes().HexString(), 1)
+			if err != nil && err != torr.ErrCachedTorrentNotFound {
+				t.Errorf("close observation %v", err)
+				return
+			}
+		}
+	}()
+	<-started
+	tor.Close()
+	wg.Wait()
+	snapshot(1, 404)
+	if bt.GetTorrent(mi.HashInfoBytes()) != nil {
+		t.Fatal("closedobservationresurrectedtorrent")
+	}
+}
