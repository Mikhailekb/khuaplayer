+package torrstor
+
+import (
+	"errors"
+	"io"
+	"sync"
+	"testing"
+)
+
+func TestPlaybackSeekHandoverOwnershipAndRevision(t *testing.T) {
+	const mib = int64(1 << 20)
+	file, c := playbackTestTorrent(t, 64*mib, 12*mib)
+	marker, err := c.BeginPlaybackSeek(1, 0, 64*mib, "new", 1)
+	if err != nil || !marker.Seeking || !c.HasPlaybackWindows() {
+		t.Fatalf("seek before window %+v %v", marker, err)
+	}
+	assertNoMissingPiecePriority(t, c)
+	retained := seedRetainedPayloads(t, c, 24, 25, 26, 27)
+	for rev := uint64(2); rev < 5; rev++ {
+		if _, err := c.BeginPlaybackSeek(1, 0, 64*mib, "new", rev); err != nil {
+			t.Fatal(err)
+		}
+	}
+	assertRetainedPayloads(t, c, retained)
+	r := c.NewPlaybackReaderAt(file, "new", 24*mib, 25*mib)
+	defer c.CloseReader(r)
+	if _, err := io.ReadFull(r, make([]byte, 128)); err != nil {
+		t.Fatal(err)
+	}
+	if !c.windows["new"].Seeking {
+		t.Fatal("finite body restored old reservation")
+	}
+	if _, err := c.UpdatePlaybackWindow(1, 0, 64*mib, "new", 24*mib, 25*mib, 64*mib, 5, false); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.BeginPlaybackSeek(1, 0, 64*mib, "new", 4); !errors.Is(err, ErrStalePlaybackRevision) {
+		t.Fatalf("late marker accepted: %v", err)
+	}
+	if c.windows["new"].Seeking {
+		t.Fatal("normal window did not end handover")
+	}
+}
+
+func TestPlaybackSeekHandoverPreservesForeignConsumerAndSave(t *testing.T) {
+	const mib = int64(1 << 20)
+	file, c := playbackTestTorrent(t, 64*mib, 16*mib)
+	setWindow(t, c, "seek", 24*mib, 24*mib, 64*mib, 1)
+	setWindow(t, c, "other", 40*mib, 40*mib, 64*mib, 1)
+	save := c.NewReader(file)
+	defer c.CloseReader(save)
+	if _, err := save.Seek(8*mib, io.SeekStart); err != nil {
+		t.Fatal(err)
+	}
+	retained := seedRetainedPayloads(t, c, 0, 8, 40)
+	if _, err := c.BeginPlaybackSeek(1, 0, 64*mib, "seek", 2); err != nil {
+		t.Fatal(err)
+	}
+	c.cleanPiecesSync()
+	assertRetainedPayloads(t, c, retained)
+}
+
+func TestPlaybackSeekHandoverConcurrentUpdatesAndReads(t *testing.T) {
+	const mib = int64(1 << 20)
+	file, c := playbackTestTorrent(t, 64*mib, 8*mib)
+	setWindow(t, c, "seek", 20*mib, 20*mib, 64*mib, 1)
+	seedRetainedPayloads(t, c, 20, 21, 22, 23)
+	var wg sync.WaitGroup
+	wg.Add(3)
+	go func() {
+		defer wg.Done()
+		for rev := uint64(2); rev < 60; rev++ {
+			if rev%2 == 0 {
+				c.BeginPlaybackSeek(1, 0, 64*mib, "seek", rev)
+			} else {
+				c.UpdatePlaybackWindow(1, 0, 64*mib, "seek", 20*mib, 20*mib, 64*mib, rev, false)
+			}
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for n := 0; n < 50; n++ {
+			r := c.NewPlaybackReaderAt(file, "seek", 20*mib, 20*mib+64)
+			io.ReadFull(r, make([]byte, 64))
+			c.CloseReader(r)
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for n := 0; n < 50; n++ {
+			c.cleanPiecesSync()
+			c.GetState()
+		}
+	}()
+	wg.Wait()
+}
+
+func TestPlaybackSeekHandoverRejectsLateOldPrefetch(t *testing.T) {
+	const mib = int64(1 << 20)
+	file, c := playbackTestTorrent(t, 64*mib, 8*mib)
+	setWindow(t, c, "main", 40*mib, 40*mib, 64*mib, 3)
+	c.prefetchRequests = map[string]string{"main": "fresh-request"}
+	old := c.NewPrefetchReaderAt(file, "main", 24*mib)
+	defer c.CloseReader(old)
+	old.SetPrefetchRequest("late-old-request", 24*mib, 28*mib)
+	if _, err := old.Seek(24*mib, io.SeekStart); err != nil {
+		t.Fatal(err)
+	}
+	if pos, err := old.Reader.Seek(0, io.SeekCurrent); err != nil || pos != file.Length() {
+		t.Fatalf("stale dormant backend pos%d %v", pos, err)
+	}
+	if n, err := old.Read(make([]byte, 64)); n != 0 || err != io.EOF {
+		t.Fatalf("stale range read %d %v", n, err)
+	}
+	if c.prefetchRequests["main"] != "fresh-request" || old.PrefetchCapacityStop() != nil {
+		t.Fatal("late old prefetch replaced nonce or issued a capacity stop")
+	}
+	if old.active() {
+		t.Fatal("late old prefetch became active")
+	}
+	assertNoMissingPiecePriority(t, c)
+}
