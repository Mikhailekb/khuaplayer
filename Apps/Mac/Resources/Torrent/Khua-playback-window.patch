+		}
+	}
+	server.Start()
+	t.Cleanup(server.Close)
+	transport := &http.Transport{Proxy: nil, MaxIdleConnsPerHost: 1}
+	t.Cleanup(transport.CloseIdleConnections)
+	httpClient := &http.Client{Transport: transport, Timeout: 3 * time.Second}
+	getRange := func(start, end int, closeRequest bool) bool {
+		t.Helper()
+		req, err := http.NewRequest(http.MethodGet, server.URL+"/stream/movie.mkv?playback_consumer=core-test", nil)
