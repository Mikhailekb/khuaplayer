+	if c.pieces[0].snapshot().size == 0 || !c.retryQueued.Load() {
+		t.Fatal("busy orphan was evicted or no cleanup retry was queued")
+	}
+	if _, err := c.UpdatePlaybackWindow(0, 0, 0, "main", 0, 0, 0, 2, true); err != nil {
+		t.Fatal(err)
+	}
+	busy.Close()
+	deadline := time.After(2 * time.Second)
+	tick := time.NewTicker(10 * time.Millisecond)
+	defer tick.Stop()
+	for c.pieces[0].snapshot().size > 0 {
+		select {
+		case <-tick.C:
+		case <-deadline:
+			t.Fatal("orphan was retained with no active wrapper readers after library guard settled")
+		}
+	}
+	if c.pieces[0].snapshot().complete {
+		t.Fatal("discarded orphan was marked complete")
+	}
+}
