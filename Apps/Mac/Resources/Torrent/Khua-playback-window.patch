+// RemovePlaybackWindow records releases even after the last torrent reader/cache
+// has closed. The revision tombstone is scoped to this worker's storage/hash.
+func (s *Storage) RemovePlaybackWindow(hash metainfo.Hash, consumer string, revision uint64) (PlaybackWindow, error) {
+	if consumer == "" || revision == 0 {
+		return PlaybackWindow{}, ErrInvalidPlaybackWindow
+	}
+	if c := s.GetCache(hash); c != nil && !c.isClosed.Load() {
+		result, err := c.UpdatePlaybackWindow(0, 0, 0, consumer, 0, 0, 0, revision, true)
+		if err != ErrPlaybackCacheClosed {
+			return result, err
+		}
+	}
+	s.muWindows.Lock()
+	defer s.muWindows.Unlock()
+	revisions := s.windowRevisions[hash]
+	if revisions == nil {
+		revisions = make(map[string]uint64)
+		s.windowRevisions[hash] = revisions
+	}
+	if revision <= revisions[consumer] {
+		return PlaybackWindow{}, ErrStalePlaybackRevision
+	}
+	revisions[consumer] = revision
+	return PlaybackWindow{Revision: revision}, nil
+}
