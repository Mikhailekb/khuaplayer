+					defer resp.Body.Close()
+					data, err := io.ReadAll(resp.Body)
+					if resp.StatusCode != 206 {
+						err = fmt.Errorf("status%d", resp.StatusCode)
+					}
+					result <- struct {
+						data []byte
+						err  error
+					}{data, err}
+				}()
