new file mode 100644
--- /dev/null
+++ b/server/torr/storage/torrstor/playback_auxiliary.go
@@ -0,0 +1,174 @@
+package torrstor
+
+import "sort"
+
+// Some containers store selected subtitles, dependent video or indices far from
+// the selected A/V byte window. A small working set follows actual foreground
+// reads in those regions; it never turns the gap between them into a reservation.
+// All accesses below are serialized by muPolicy.
+type auxiliaryPiece struct {
+	touch   uint64
+	forward bool
+	epoch   uint64
+}
+
+func (c *Cache) auxiliaryBudgetLocked() int64 {
+	if c.pieceLength <= 0 {
+		return 0
+	}
+	limit := min(c.capacity/8, int64(32<<20))
+	return max(c.pieceLength, limit/c.pieceLength*c.pieceLength)
+}
+
+// Caller holds muPolicy and r.mu. Only bytes successfully delivered by a real
+// finite foreground request establish this demand. Seeks/length probes, exports,
+// failed reads, prefetch and late completions from an earlier seek cannot do so.
+func (c *Cache) recordAuxiliaryReadLocked(r *Reader, first, end int64) bool {
+	w, ok := c.readerWindowLocked(r)
+	if c.isClosed.Load() || !ok || w.Seeking || r.isClosed || r.prefetch || r.backgroundParent != "" || !r.finiteForeground ||
+		r.auxiliaryEpoch == 0 || r.auxiliaryEpoch != w.auxiliaryEpoch || first < 0 || end <= first {
+		return false
+	}
+	c.auxiliaryClock++
+	touch := c.auxiliaryClock
+	changed := false
+	if w.auxiliary == nil {
+		w.auxiliary = make(map[int]auxiliaryPiece)
+	}
+	lastFilePiece := int((w.fileOffset + w.fileLength - 1) / c.pieceLength)
+	admit := func(id int, forward bool) {
+		if id < 0 || id >= c.pieceCount || id > lastFilePiece ||
+			(id >= w.lowerPiece(c.pieceLength) && id <= w.endPiece(c.pieceLength)) {
+			return
+		}
+		if old, exists := w.auxiliary[id]; !exists || old.epoch != w.auxiliaryEpoch {
+			changed = true
+		}
+		w.auxiliary[id] = auxiliaryPiece{touch: touch, forward: forward, epoch: w.auxiliaryEpoch}
+	}
+	firstID, lastID := r.getPieceNum(first), r.getPieceNum(end-1)
+	for id := firstID; id <= lastID; id++ {
+		admit(id, false)
+	}
+	// Completing one adjacent piece makes sparse tiny subtitle samples warm
+	// across their next piece boundary, including while playback is paused.
+	// A one-piece budget spends everything on the demanded piece instead.
+	if c.auxiliaryBudgetLocked() >= 2*c.pieceLength {
+		admit(lastID+1, true)
+	}
+	return changed
+}
+
+// The auxiliary budget is shared by every playback consumer of this torrent.
+// Count indivisible piece allocations, not the bytes that happened to arrive,
+// and deduplicate them against all existing hard reservations.
+func (c *Cache) retainAuxiliaryLocked(kept map[int]bool, used *int64) {
+	candidates := make(map[int]auxiliaryPiece)
+	for _, w := range c.windows {
+		for id, entry := range w.auxiliary {
+			// Once a region is ordinary selected A/V history/current, its normal
+			// twenty-second policy takes over. Auxiliary pins cannot extend it.
+			if !w.Seeking && (id >= w.requestedLowerPiece(c.pieceLength) && id <= w.currentPiece(c.pieceLength)) {
+				delete(w.auxiliary, id)
+				continue
+			}
+			previous, exists := candidates[id]
+			if !exists || entry.touch > previous.touch ||
+				(entry.touch == previous.touch && previous.forward && !entry.forward) {
+				candidates[id] = entry
+			}
+		}
+	}
+	ids := make([]int, 0, len(candidates))
+	for id := range candidates {
+		ids = append(ids, id)
+	}
+	sort.Slice(ids, func(i, j int) bool {
+		a, b := candidates[ids[i]], candidates[ids[j]]
+		if a.touch != b.touch {
+			return a.touch > b.touch
+		}
+		if a.forward != b.forward {
+			return !a.forward
+		}
+		return ids[i] < ids[j]
+	})
+	retained := make(map[int]bool)
+	// Optional pins yield to unavoidable current/in-flight allocation pressure.
+	if *used > c.capacity {
+		for _, w := range c.windows {
+			clear(w.auxiliary)
+		}
+		return
+	}
+	remaining := c.auxiliaryBudgetLocked()
+	for _, id := range ids {
+		cost := c.pieceBytes(id)
+		if cost <= 0 || cost > remaining || (!kept[id] && cost > c.capacity-*used) {
+			continue
+		}
+		remaining -= cost
+		retained[id] = true
+		if !kept[id] {
+			kept[id] = true
+			*used += cost
+		}
+	}
+	for _, w := range c.windows {
+		for id := range w.auxiliary {
+			if !retained[id] {
+				delete(w.auxiliary, id)
+			}
+		}
+	}
+}
+
+func (c *Cache) auxiliaryPieceIDsLocked() []int {
+	unique := make(map[int]bool)
+	for _, w := range c.windows {
+		for id := range w.auxiliary {
+			unique[id] = true
+		}
+	}
+	ids := make([]int, 0, len(unique))
+	for id := range unique {
+		ids = append(ids, id)
+	}
+	sort.Ints(ids)
+	return ids
+}
+
+// An explicit stop removes the primary prefetch reader. Auxiliary retention
+// remains, but no background downloads may survive the last foreground/prefetch
+// reader. Normal playback pause keeps its prefetch reader and can keep warming.
+func (c *Cache) auxiliaryCompletionIDsLocked() []int {
+	active := make(map[string]bool)
+	for _, r := range c.readersSnapshot() {
+		r.mu.Lock()
+		w, ok := c.readerWindowLocked(r)
+		if ok && !w.Seeking && r.isUse && !r.isClosed && r.backgroundParent == "" {
+			active[r.consumer] = true
+		}
+		r.mu.Unlock()
+	}
+	if len(active) == 0 {
+		return nil
+	}
+	ids := make(map[int]bool)
+	for consumer, w := range c.windows {
+		if w.Seeking || !active[consumer] {
+			continue
+		}
+		for id, entry := range w.auxiliary {
+			if entry.epoch == w.auxiliaryEpoch {
+				ids[id] = true
+			}
+		}
+	}
+	result := make([]int, 0, len(ids))
+	for id := range ids {
+		result = append(result, id)
+	}
+	sort.Ints(result)
+	return result
+}
