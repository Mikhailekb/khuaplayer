+++ b/server/torr/storage/torrstor/cache_ranges_test.go
@@ -0,0 +1,120 @@
+package torrstor
+
+import (
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+)
+
+func TestFileCacheSnapshotUsesCompleteAllocatedPayloadAndPreservesHoles(t *testing.T) {
+	c := policyCache(t, 1000, 83, 16)
+	for _, id := range []int{0, 2, 4, 5} {
+		putPolicyPiece(c, id, true)
+	}
+	putPolicyPiece(c, 1, false)
+	c.pieces[3].Complete = true
+	c.pieces[3].Size = 16 // stale metadata, no actual allocation
+	snap, err := c.FileCacheSnapshot(2, 11, 72)
+	want := []CachedByteRange{{0, 5}, {21, 37}, {53, 72}}
+	if err != nil || !reflect.DeepEqual(snap.Ranges, want) || snap.ResidentBytes != 40 || snap.FileOffset != 11 || snap.PieceLength != 16 {
+		t.Fatalf("snapshot %+v %v", snap, err)
+	}
+	if c.Readers() != 0 || len(c.windows) != 0 {
+		t.Fatal("observation created ownership or a reader")
+	}
+	before := c.pieces[2].Accessed
+	c.FileCacheSnapshot(2, 11, 72)
+	if c.pieces[2].Accessed != before {
+		t.Fatal("observation refreshed payload access age")
+	}
+	c.pieces[2].Release()
+	snap, err = c.FileCacheSnapshot(2, 11, 72)
+	if err != nil || !reflect.DeepEqual(snap.Ranges, []CachedByteRange{{0, 5}, {53, 72}}) || snap.ResidentBytes != 24 {
+		t.Fatalf("eviction not visible %+v %v", snap, err)
+	}
+	// Other-file data and incomplete pieces alone must report an empty file.
+	empty, err := c.FileCacheSnapshot(9, 16, 16)
+	if err != nil || len(empty.Ranges) != 0 || empty.ResidentBytes != 0 || empty.Ranges == nil {
+		t.Fatalf("empty file %+v %v", empty, err)
+	}
+}
+
+func TestFileCacheSnapshotMergesOnlyAdjacentAndCountsShortLastPiece(t *testing.T) {
+	c := policyCache(t, 1000, 51, 16)
+	for _, id := range []int{0, 1, 2, 3} {
+		putPolicyPiece(c, id, true)
+	}
+	s, err := c.FileCacheSnapshot(1, 0, 51)
+	if err != nil || !reflect.DeepEqual(s.Ranges, []CachedByteRange{{0, 51}}) || s.ResidentBytes != 51 {
+		t.Fatalf("complete short tail %+v %v", s, err)
+	}
+	c.pieces[3].mu.Lock()
+	c.pieces[3].mPiece.buffer = c.pieces[3].mPiece.buffer[:2]
+	c.pieces[3].mu.Unlock()
+	s, err = c.FileCacheSnapshot(1, 0, 51)
+	if err != nil || !reflect.DeepEqual(s.Ranges, []CachedByteRange{{0, 48}}) || s.ResidentBytes != 48 {
+		t.Fatalf("short allocation treated as resident %+v %v", s, err)
+	}
+}
+
+func TestFileCacheSnapshotValidationAndBoundedFragmentation(t *testing.T) {
+	c := policyCache(t, 1000, 100, 10)
+	for _, bad := range [][3]int64{{0, 0, 10}, {1, -1, 1}, {1, 0, 0}, {1, 95, 10}, {1, 9223372036854775807, 1}} {
+		if _, err := c.FileCacheSnapshot(int(bad[0]), bad[1], bad[2]); !errors.Is(err, ErrInvalidPlaybackWindow) {
+			t.Fatalf("invalid geometry accepted %v %v", bad, err)
+		}
+	}
+	fragmented := policyCache(t, 1<<20, int64(MaxCachedFileRanges*2+1), 1)
+	for id := 0; id < fragmented.pieceCount; id += 2 {
+		putPolicyPiece(fragmented, id, true)
+	}
+	if _, err := fragmented.FileCacheSnapshot(1, 0, fragmented.totalLength); !errors.Is(err, ErrCacheSnapshotTooFragmented) {
+		t.Fatalf("unbounded or misleading fragmentation %v", err)
+	}
+	c.isClosed.Store(true)
+	if _, err := c.FileCacheSnapshot(1, 0, 100); !errors.Is(err, ErrPlaybackCacheClosed) {
+		t.Fatalf("closed snapshot %v", err)
+	}
+}
+
+func TestFileCacheSnapshotConcurrentPayloadCompletionAndEviction(t *testing.T) {
+	c := policyCache(t, 1<<20, 1<<10, 16)
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for n := 0; n < 200; n++ {
+			p := c.pieces[n%64]
+			p.mu.Lock()
+			p.Size = 16
+			p.Complete = n%3 != 0
+			p.mPiece.buffer = make([]byte, 16)
+			p.mu.Unlock()
+			if n%2 == 0 {
+				p.Release()
+			}
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for n := 0; n < 200; n++ {
+			s, err := c.FileCacheSnapshot(1, 3, 1000)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			var count int64
+			for _, r := range s.Ranges {
+				if r[0] < 0 || r[1] > 1000 || r[0] >= r[1] {
+					t.Error("bad extent")
+				}
+				count += r[1] - r[0]
+			}
+			if count != s.ResidentBytes {
+				t.Error("inconsistent byte count")
+			}
+		}
+	}()
+	wg.Wait()
+}
