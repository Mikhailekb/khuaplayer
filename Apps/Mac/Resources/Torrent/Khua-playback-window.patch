+package api
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	config "server/settings"
+	"server/torr/storage/torrstor"
+	"server/web/auth"
+)
+
+const playbackTestHash = "0123456789012345678901234567890123456789"
+
+func TestPlaybackWindowHTTPValidationAndResponses(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	tests := []struct {
+		name, body string
+		code       int
+	}{
+		{"seek without guessed offsets", fmt.Sprintf(`{"hash":%q,"file_index":1,"consumer":"a","revision":2,"seeking":true}`, playbackTestHash), 200},
+		{"seek cannot remove", fmt.Sprintf(`{"hash":%q,"file_index":1,"consumer":"a","revision":2,"seeking":true,"remove":true}`, playbackTestHash), 400},
+		{"seek needs file", fmt.Sprintf(`{"hash":%q,"consumer":"a","revision":2,"seeking":true}`, playbackTestHash), 400},
+		{"malformed", "{", 400},
+		{"missing", "{}", 400},
+		{"bad hash", `{"hash":"xyz","file_index":1,"consumer":"a","revision":1,"lower":0,"current":1,"upper":10}`, 400},
+		{"missing lower", fmt.Sprintf(`{"hash":%q,"file_index":1,"consumer":"a","revision":1,"current":1,"upper":10}`, playbackTestHash), 400},
+		{"negative lower", fmt.Sprintf(`{"hash":%q,"file_index":1,"consumer":"a","revision":1,"lower":-1,"current":1,"upper":10}`, playbackTestHash), 400},
+		{"unordered", fmt.Sprintf(`{"hash":%q,"file_index":1,"consumer":"a","revision":1,"lower":2,"current":1,"upper":10}`, playbackTestHash), 400},
+		{"empty window", fmt.Sprintf(`{"hash":%q,"file_index":1,"consumer":"a","revision":1,"lower":0,"current":10,"upper":10}`, playbackTestHash), 400},
+		{"missing revision", fmt.Sprintf(`{"hash":%q,"file_index":1,"consumer":"a","lower":0,"current":1,"upper":10}`, playbackTestHash), 400},
+		{"bad consumer", fmt.Sprintf(`{"hash":%q,"file_index":1,"consumer":"a/b","revision":1,"lower":0,"current":1,"upper":10}`, playbackTestHash), 400},
+		{"negative revision", fmt.Sprintf(`{"hash":%q,"file_index":1,"consumer":"a","revision":-1,"remove":true}`, playbackTestHash), 400},
+		{"zero file id", fmt.Sprintf(`{"hash":%q,"file_index":0,"consumer":"a","revision":1,"lower":0,"current":1,"upper":10}`, playbackTestHash), 400},
+		{"valid", fmt.Sprintf(`{"hash":%q,"file_index":1,"consumer":"a","revision":1,"lower":0,"current":1,"upper":10}`, playbackTestHash), 200},
+		{"exact remove payload", fmt.Sprintf(`{"hash":%q,"consumer":"a","revision":2,"remove":true}`, playbackTestHash), 200},
+		{"remove without offsets", fmt.Sprintf(`{"hash":%q,"file_index":1,"consumer":"a","revision":2,"remove":true}`, playbackTestHash), 200},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			calls := 0
+			r := gin.New()
+			r.POST("/playback/window", func(c *gin.Context) {
+				handlePlaybackWindow(c, func(req playbackWindowRequest) (torrstor.PlaybackWindow, error) {
+					calls++
+					return torrstor.PlaybackWindow{Lower: 0, Current: 1, Upper: 10, PieceLength: 10, Revision: req.Revision}, nil
+				})
+			})
+			req := httptest.NewRequest("POST", "/playback/window", strings.NewReader(tt.body))
+			req.Header.Set("Content-Type", "application/json")
+			w := httptest.NewRecorder()
+			r.ServeHTTP(w, req)
+			if w.Code != tt.code {
+				t.Fatalf("status %d body %s", w.Code, w.Body)
+			}
+			if tt.code == 200 {
+				var data map[string]any
+				if err := json.Unmarshal(w.Body.Bytes(), &data); err != nil {
+					t.Fatal(err)
+				}
+				if len(data) != 5 || data["piece_length"] != float64(10) {
+					t.Fatalf("unexpected JSON %v", data)
+				}
+			} else if calls != 0 {
+				t.Fatal("invalid request reached cache")
+			}
+		})
+	}
+	for _, tc := range []struct {
+		err    error
+		status int
+	}{{torrstor.ErrStalePlaybackRevision, 409}, {torrstor.ErrInvalidPlaybackWindow, 400}, {torrstor.ErrPlaybackCacheClosed, 404}, {errPlaybackNotFound, 404}} {
+		r := gin.New()
+		r.POST("/playback/window", func(c *gin.Context) {
+			handlePlaybackWindow(c, func(playbackWindowRequest) (torrstor.PlaybackWindow, error) { return torrstor.PlaybackWindow{}, tc.err })
+		})
+		req := httptest.NewRequest("POST", "/playback/window", strings.NewReader(fmt.Sprintf(`{"hash":%q,"file_index":1,"consumer":"a","revision":2,"remove":true}`, playbackTestHash)))
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, req)
+		if w.Code != tc.status {
+			t.Fatalf("%v status %d", tc.err, w.Code)
+		}
+	}
+}
+func TestPlaybackWindowProductionRouteRequiresAuthentication(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	previous := config.HttpAuth
+	config.HttpAuth = true
+	t.Cleanup(func() { config.HttpAuth = previous })
+	r := gin.New()
+	r.Use(auth.BasicAuth(gin.Accounts{"user": "secret"}))
+	SetupRoute(r)
+	req := httptest.NewRequest(http.MethodPost, "/playback/window", strings.NewReader("{}"))
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	if w.Code != 401 {
+		t.Fatalf("unauthenticated mutation status %d", w.Code)
+	}
+	req = httptest.NewRequest(http.MethodPost, "/playback/window", strings.NewReader("{}"))
+	req.SetBasicAuth("user", "secret")
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	if w.Code != 400 {
+		t.Fatalf("authenticated route status %d, want validation", w.Code)
+	}
+}
