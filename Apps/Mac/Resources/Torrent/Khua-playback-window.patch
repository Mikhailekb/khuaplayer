diff --git a/server/torr/storage/torrstor/auxiliary_local_peer_test.go b/server/torr/storage/torrstor/auxiliary_local_peer_test.go
new file mode 100644
--- /dev/null
+++ b/server/torr/storage/torrstor/auxiliary_local_peer_test.go
@@ -0,0 +1,261 @@
+package torrstor
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha1"
+	"io"
+	"os"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/anacrolix/torrent"
+	"github.com/anacrolix/torrent/bencode"
+	"github.com/anacrolix/torrent/metainfo"
+	torrentstorage "github.com/anacrolix/torrent/storage"
+	"golang.org/x/time/rate"
+)
+
+type auxiliaryPeerSeedStore struct {
+	file      *os.File
+	mu        sync.Mutex
+	pieces    map[int]*auxiliaryPeerSeedPiece
+	closeOnce sync.Once
+}
+type auxiliaryPeerSeedPiece struct {
+	file           *os.File
+	offset, length int64
+	complete       atomic.Bool
+}
+
+func (s *auxiliaryPeerSeedStore) OpenTorrent(*metainfo.Info, metainfo.Hash) (torrentstorage.TorrentImpl, error) {
+	return s, nil
+}
+func (s *auxiliaryPeerSeedStore) Close() error {
+	var err error
+	s.closeOnce.Do(func() { err = s.file.Close() })
+	return err
+}
+func (s *auxiliaryPeerSeedStore) Piece(p metainfo.Piece) torrentstorage.PieceImpl {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if old := s.pieces[p.Index()]; old != nil {
+		return old
+	}
+	next := &auxiliaryPeerSeedPiece{file: s.file, offset: p.Offset(), length: p.Length()}
+	s.pieces[p.Index()] = next
+	return next
+}
+func (p *auxiliaryPeerSeedPiece) ReadAt(b []byte, off int64) (int, error) {
+	return io.NewSectionReader(p.file, p.offset, p.length).ReadAt(b, off)
+}
+func (p *auxiliaryPeerSeedPiece) WriteAt([]byte, int64) (int, error) { return 0, io.ErrClosedPipe }
+func (p *auxiliaryPeerSeedPiece) MarkComplete() error                { p.complete.Store(true); return nil }
+func (p *auxiliaryPeerSeedPiece) MarkNotComplete() error             { p.complete.Store(false); return nil }
+func (p *auxiliaryPeerSeedPiece) Completion() torrentstorage.Completion {
+	return torrentstorage.Completion{Complete: p.complete.Load(), Ok: true}
+}
+
+// This is a real TCP BitTorrent transfer: only the seeder has the payload.
+// Neither auxiliary piece is injected into downloader storage. A continuously
+// advancing primary reader competes with completion of the sparse auxiliary
+// piece, reproducing the request-strategy-3 starvation regression.
+func TestAuxiliaryLocalPeerWarmsAheadOfContinuousPrefetch(t *testing.T) {
+	initTestSettings(t)
+	const piece = int64(1 << 20)
+	const length = int64(96) * piece
+	const primary = int64(64) * piece
+	const capacity = int64(32) * piece
+	seedDir := t.TempDir()
+	file, err := os.Create(filepath.Join(seedDir, "auxiliary-peer.mkv"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	info := metainfo.Info{Name: "auxiliary-peer.mkv", Length: length, PieceLength: piece}
+	for id := 0; id < int(length/piece); id++ {
+		payload := bytes.Repeat([]byte{byte(id + 1)}, int(piece))
+		if _, err := file.Write(payload); err != nil {
+			file.Close()
+			t.Fatal(err)
+		}
+		hash := sha1.Sum(payload)
+		info.Pieces = append(info.Pieces, hash[:]...)
+	}
+	if err := file.Close(); err != nil {
+		t.Fatal(err)
+	}
+	config := func(dir string, peerID byte) *torrent.ClientConfig {
+		cfg := torrent.NewDefaultClientConfig()
+		cfg.DataDir = dir
+		cfg.ListenHost = func(string) string { return "127.0.0.1" }
+		cfg.ListenPort = 0
+		cfg.DisableIPv6 = true
+		cfg.DisableUTP = true
+		cfg.DisableTrackers = true
+		cfg.DisablePEX = true
+		cfg.NoDHT = true
+		cfg.NoDefaultPortForwarding = true
+		cfg.PeerID = string(bytes.Repeat([]byte{peerID}, 20))
+		return cfg
+	}
+	seedConfig := config(seedDir, 's')
+	seedConfig.Seed = true
+	seedFile, err := os.Open(filepath.Join(seedDir, "auxiliary-peer.mkv"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	seedConfig.DefaultStorage = &auxiliaryPeerSeedStore{file: seedFile, pieces: make(map[int]*auxiliaryPeerSeedPiece)}
+	seed, err := torrent.NewClient(seedConfig)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { seed.Close() })
+	mi := metainfo.MetaInfo{InfoBytes: bencode.MustMarshal(info)}
+	spec := &torrent.TorrentSpec{InfoHash: mi.HashInfoBytes(), InfoBytes: mi.InfoBytes}
+	seedTorrent, _, err := seed.AddTorrentSpec(spec)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seedTorrent.VerifyData()
+	wait := func(timeout time.Duration, label string, ready func() bool) {
+		t.Helper()
+		deadline := time.Now().Add(timeout)
+		for !ready() {
+			if time.Now().After(deadline) {
+				t.Fatalf("timeout: %s", label)
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+	}
+	wait(5*time.Second, "seeder verifies real SHA-1 payload", func() bool {
+		return seedTorrent.BytesCompleted() == length && seedTorrent.Seeding()
+	})
+	store := NewStorage(capacity)
+	downloadConfig := config(t.TempDir(), 'd')
+	downloadConfig.DefaultStorage = store
+	downloadConfig.NoUpload = true
+	downloadConfig.DownloadRateLimiter = rate.NewLimiter(rate.Limit(2*piece), 64<<10)
+	downloader, err := torrent.NewClient(downloadConfig)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { downloader.Close() })
+	tor, _, err := downloader.AddTorrentSpec(spec)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cache := store.GetCache(mi.HashInfoBytes())
+	cache.SetTorrent(tor)
+	f := tor.Files()[0]
+	setWindow(t, cache, "main", primary, primary, length, 1)
+	main := cache.NewPrefetchReaderAt(f, "main", primary)
+	main.SetResponsive()
+	ctx, cancel := context.WithCancel(context.Background())
+	main.readContext = ctx
+	var advanced atomic.Int64
+	mainDone := make(chan struct{})
+	go func() {
+		defer close(mainDone)
+		buffer := make([]byte, 64<<10)
+		for {
+			n, err := main.Read(buffer)
+			advanced.Add(int64(n))
+			if err != nil {
+				return
+			}
+		}
+	}()
+	stopMain := func() {
+		cancel()
+		cache.CloseReader(main)
+		select {
+		case <-mainDone:
+		case <-time.After(2 * time.Second):
+			t.Error("primary reader did not stop")
+		}
+	}
+	defer stopMain()
+	tor.AddClientPeer(seed)
+	wait(5*time.Second, "actual primary transfer starts", func() bool { return advanced.Load() >= 64<<10 })
+	start := int64(4)*piece + 64<<10
+	aux := cache.NewPlaybackReaderAt(f, "main", start, start+(256<<10))
+	aux.SetResponsive()
+	auxContext, cancelAux := context.WithTimeout(context.Background(), 5*time.Second)
+	aux.readContext = auxContext
+	body := make([]byte, 256<<10)
+	n, readErr := io.ReadFull(aux, body)
+	cancelAux()
+	cache.CloseReader(aux)
+	if readErr != nil || n != len(body) || !bytes.Equal(body, bytes.Repeat([]byte{5}, len(body))) {
+		t.Fatalf("real finite auxiliary response n=%d error=%v", n, readErr)
+	}
+	warmAt := time.Now()
+	wait(6*time.Second, "future auxiliary piece transfers while main prefetch advances", func() bool {
+		return cache.pieces[5].snapshot().complete
+	})
+	select {
+	case <-mainDone:
+		t.Fatal("auxiliary completed only after primary prefetch ended")
+	default:
+	}
+	missingPrimary := 0
+	for id := 65; id < 80; id++ {
+		if !cache.pieces[id].snapshot().complete {
+			missingPrimary++
+		}
+	}
+	if missingPrimary == 0 {
+		t.Fatal("auxiliary was starved until every initial primary readahead piece completed")
+	}
+	cache.muPolicy.Lock()
+	allocated := int64(0)
+	for _, p := range cache.getPieces() {
+		p.mu.Lock()
+		allocated += int64(len(p.mPiece.buffer))
+		p.mu.Unlock()
+	}
+	cache.muPolicy.Unlock()
+	if allocated > capacity {
+		t.Fatalf("allocated cache %d exceeds global capacity %d", allocated, capacity)
+	}
+	t.Logf("REAL PEER PASS: future auxiliary piece verified in %s; primary advanced=%d, initial primary pieces still missing=%d, allocated=%d/%d", time.Since(warmAt), advanced.Load(), missingPrimary, allocated, capacity)
+	stopMain()
+	cache.cleanPiecesSync()
+	cache.muPolicy.Lock()
+	completion := cache.auxiliaryCompletionIDsLocked()
+	cache.muPolicy.Unlock()
+	if len(completion) != 0 {
+		t.Fatalf("stopped main still authorizes auxiliary background completion %v", completion)
+	}
+	seed.Close()
+	// This final read is an additional residency check, not the warming proof:
+	// piece 5 completed above solely through the real peer protocol.
+	next := cache.NewPlaybackReaderAt(f, "main", 5*piece+64, 5*piece+128)
+	next.readContext, cancelAux = context.WithTimeout(context.Background(), time.Second)
+	defer cancelAux()
+	defer cache.CloseReader(next)
+	verified := make([]byte, 64)
+	if n, err := io.ReadFull(next, verified); err != nil || n != 64 || !bytes.Equal(verified, bytes.Repeat([]byte{6}, 64)) {
+		t.Fatalf("verified future piece was not retained after peer disconnect: n=%d err=%v", n, err)
+	}
+	cache.CloseReader(next)
+	// Another consumer's active request must not authorize background work for
+	// this stopped owner. The cached read above also introduced a not-yet-read
+	// forward piece, so this checks more than an already-complete piece's zero
+	// effective priority.
+	setWindow(t, cache, "other", 80*piece, 80*piece, length, 1)
+	other := cache.NewPrefetchReaderAt(f, "other", 80*piece)
+	other.beginRead(64)
+	defer func() { other.endIO(); cache.CloseReader(other) }()
+	cache.setLoadPriority(nil)
+	cache.clearPriority()
+	cache.muPolicy.Lock()
+	completion = cache.auxiliaryCompletionIDsLocked()
+	cache.muPolicy.Unlock()
+	if len(completion) != 0 || tor.PieceState(6).Priority != torrent.PiecePriorityNone {
+		t.Fatalf("another consumer restarted stopped owner's future auxiliary piece: completion=%v priority=%v", completion, tor.PieceState(6).Priority)
+	}
+}
