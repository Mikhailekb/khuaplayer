+func TestPlaybackLateSeekRemovalAndHintCannotEraseNewerResidentWindow(t *testing.T) {
+	const mib = 1 << 20
+	_, c := playbackTestTorrent(t, 64*mib, 12*mib)
+	const current = 24*mib + 7*mib/8
+	setWindow(t, c, "paused", current-2*mib, current, 64*mib, 10)
+	retained := seedRetainedPayloads(t, c, 24, 25, 29)
+	next := setWindow(t, c, "paused", current-2*mib+mib/4, current+mib/4, 64*mib, 30)
+
+	// A delayed clear has a revision newer than the previous ACK, but older
+	// than the replacement. The HTTP removal path reaches Storage first.
+	if _, err := c.storage.RemovePlaybackWindow(c.hash, "paused", 20); !errors.Is(err, ErrStalePlaybackRevision) {
+		t.Fatalf("late clear affected replacement: %v", err)
+	}
+	if _, err := c.UpdatePlaybackWindow(1, 0, 64*mib, "paused", 0, 1, 16*mib, 29, false); !errors.Is(err, ErrStalePlaybackRevision) {
+		t.Fatalf("late distant hint replaced current window: %v", err)
+	}
+	c.cleanPiecesSync()
+	assertPausedWindow(t, c, "paused", 30)
+	assertRetainedPayloads(t, c, retained)
+	c.muPolicy.Lock()
+	after := c.windows["paused"].PlaybackWindow
+	c.muPolicy.Unlock()
+	if after != next {
+		t.Fatalf("stale operations changed authoritative window: before=%+v after=%+v", next, after)
+	}
+
+	setWindow(t, c, "paused", current-2*mib, current, 64*mib, 31)
+	if _, err := c.storage.RemovePlaybackWindow(c.hash, "paused", 30); !errors.Is(err, ErrStalePlaybackRevision) {
+		t.Fatalf("old forward-seek release erased backward replacement: %v", err)
+	}
+	assertPausedWindow(t, c, "paused", 31)
+	assertRetainedPayloads(t, c, retained)
+	assertNoMissingPiecePriority(t, c)
+}
