+
+// SetPrefetchRequest identifies the caller's finite HTTP range. Its UUID is
+// validated by the HTTP handler and is never reused across retries or sources.
+func (r *Reader) SetPrefetchRequest(requestID string, start, end int64) {
+	if r.cache != nil {
+		r.cache.muPolicy.Lock()
+		defer r.cache.muPolicy.Unlock()
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.capacityStop = nil
+	if requestID == "" || start < 0 || end <= start {
+		r.prefetchRequest = nil
+		return
+	}
+	r.prefetchRequest = &playbackPrefetchRequest{id: requestID, start: start, end: end}
+	if r.cache != nil && r.prefetch && r.managed && !r.isClosed {
+		if w, ok := r.cache.readerWindowLocked(r); ok && !w.Seeking && start >= w.Lower {
