+// Core reads finite ranges repeatedly. Keeping their TCP connection alive avoids
+// another connection handshake for bytes that are already available in RAM.
+// The torrent reader still closes when each individual response finishes.
+func keepPlaybackRangeAlive(req *http.Request) bool {
+	if req.Method != http.MethodGet || req.URL.Query().Get("playback_consumer") == "" || req.URL.Query().Get("playback_prefetch") == "1" {
+		return false
+	}
+	value, ok := strings.CutPrefix(req.Header.Get("Range"), "bytes=")
+	if !ok {
+		return false
+	}
+	first, last, ok := strings.Cut(value, "-")
+	if !ok || first == "" || last == "" || strings.Trim(first, "0123456789") != "" || strings.Trim(last, "0123456789") != "" {
+		return false
+	}
+	lower, err := strconv.ParseInt(first, 10, 64)
+	if err != nil {
+		return false
+	}
+	upper, err := strconv.ParseInt(last, 10, 64)
+	return err == nil && upper >= lower
+}
+
+// This wrapper is used only for nonce-tagged prefetch requests. It records the
+// actual successful HTTP prefix, independently of buffered source lookahead.
+type prefetchResponseWriter struct {
+	http.ResponseWriter
+	written int64
+	failed  bool
+	status  int
+}
+
+func (w *prefetchResponseWriter) WriteHeader(status int) {
+	w.status = status
+	w.ResponseWriter.WriteHeader(status)
+}
+func (w *prefetchResponseWriter) Write(p []byte) (int, error) {
+	n, err := w.ResponseWriter.Write(p)
+	w.written += int64(n)
+	if err != nil || n != len(p) {
+		w.failed = true
+	}
+	return n, err
+}
+
+func validPlaybackPrefetchRequestID(id string) bool {
+	if len(id) != 36 {
+		return false
+	}
+	for i, c := range id {
+		if i == 8 || i == 13 || i == 18 || i == 23 {
+			if c != '-' {
+				return false
+			}
+			continue
+		}
+		if !('0' <= c && c <= '9' || 'a' <= c && c <= 'f' || 'A' <= c && c <= 'F') {
+			return false
+		}
+	}
+	return true
+}
+func finitePrefetchRange(value string) (int64, int64, bool) {
+	value, ok := strings.CutPrefix(value, "bytes=")
+	if !ok {
+		return 0, 0, false
+	}
+	first, last, ok := strings.Cut(value, "-")
+	if !ok || first == "" || last == "" || strings.Trim(first, "0123456789") != "" || strings.Trim(last, "0123456789") != "" {
+		return 0, 0, false
+	}
+	start, err := strconv.ParseInt(first, 10, 64)
+	if err != nil {
+		return 0, 0, false
+	}
+	end, err := strconv.ParseInt(last, 10, 64)
+	if err != nil || end < start || end == 1<<63-1 {
+		return 0, 0, false
+	}
+	return start, end + 1, true
+}
+
+// A validated conditional range still has a finite body. Mismatched validators
+// retain ServeContent's full-response fallback and its unrestricted reader.
+func finiteForegroundValidatorMatches(req *http.Request, etag string, modified time.Time) bool {
+	value := strings.TrimSpace(req.Header.Get("If-Range"))
+	if value == "" || value == etag {
+		return true
+	}
+	stamp, err := http.ParseTime(value)
+	return err == nil && !modified.IsZero() && stamp.Unix() == modified.Unix()
+}
