+// residentPayload records the allocation as well as its contents: an empty
+// interval followed by downloading the same bytes is not successful retention.
+type residentPayload struct {
+	allocation *byte
+	bytes      []byte
+}
+
+func seedRetainedPayloads(t *testing.T, c *Cache, ids ...int) map[int]residentPayload {
+	t.Helper()
+	retained := make(map[int]residentPayload, len(ids))
+	for _, id := range ids {
+		putPolicyPiece(c, id, true)
+		c.torrent.Piece(id).UpdateCompletion()
+		p := c.pieces[id]
+		p.mu.Lock()
+		retained[id] = residentPayload{allocation: &p.mPiece.buffer[0], bytes: append([]byte(nil), p.mPiece.buffer...)}
+		p.mu.Unlock()
+	}
+	return retained
+}
+func retainedPayloadError(c *Cache, retained map[int]residentPayload) error {
+	for id, before := range retained {
+		p := c.pieces[id]
+		p.mu.Lock()
+		unchanged := p.Complete && p.Size == int64(len(before.bytes)) && len(p.mPiece.buffer) == len(before.bytes) && &p.mPiece.buffer[0] == before.allocation && bytes.Equal(p.mPiece.buffer, before.bytes)
+		p.mu.Unlock()
+		if !unchanged {
+			return fmt.Errorf("overlapping resident piece %d was removed, replaced, or changed", id)
+		}
+	}
+	return nil
+}
+func assertRetainedPayloads(t *testing.T, c *Cache, retained map[int]residentPayload) {
+	t.Helper()
+	if err := retainedPayloadError(c, retained); err != nil {
+		t.Fatal(err)
+	}
+}
+func assertNoMissingPiecePriority(t *testing.T, c *Cache) {
+	t.Helper()
+	for id, p := range c.getPieces() {
+		if p.snapshot().size == 0 {
+			if priority := c.torrent.PieceState(id).Priority; priority != torrent.PiecePriorityNone {
+				t.Fatalf("retention-only paused state scheduled missing piece %d at priority %v", id, priority)
+			}
+		}
+	}
+}
+func assertPausedWindow(t *testing.T, c *Cache, consumer string, revision uint64) {
+	t.Helper()
+	c.muPolicy.Lock()
+	w := c.windows[consumer]
+	present := w != nil && w.Revision == revision && w.Lower <= w.Current && w.Current < w.Upper
+	c.muPolicy.Unlock()
+	if !present {
+		t.Fatalf("paused consumer %q lost its nonempty revision %d window", consumer, revision)
+	}
+}
