+func TestPlaybackBackgroundCleanupValidation(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	valid := fmt.Sprintf(`{"hash":%q,"consumer":"background-job","parent":"primary","remove":true}`, playbackTestHash)
+	for _, tt := range []struct {
+		body   string
+		status int
+	}{
+		{"{", 400}, {"{}", 400},
+		{`{"hash":"bad","consumer":"job","parent":"main","remove":true}`, 400},
+		{fmt.Sprintf(`{"hash":%q,"consumer":"job","parent":"main"}`, playbackTestHash), 400},
+		{fmt.Sprintf(`{"hash":%q,"consumer":"main","parent":"main","remove":true}`, playbackTestHash), 400},
+		{fmt.Sprintf(`{"hash":%q,"consumer":"bad/consumer","parent":"main","remove":true}`, playbackTestHash), 400},
+		{fmt.Sprintf(`{"hash":%q,"consumer":"job","parent":"","remove":true}`, playbackTestHash), 400},
+		{valid, 200},
+	} {
+		calls := 0
+		r := gin.New()
+		r.POST("/playback/background", func(c *gin.Context) {
+			handlePlaybackBackground(c, func(req playbackBackgroundRequest) error {
+				calls++
+				if req.Consumer != "background-job" || req.Parent != "primary" {
+					t.Fatal("cleanup changed identity")
+				}
+				return nil
+			})
+		})
+		q := httptest.NewRequest("POST", "/playback/background", strings.NewReader(tt.body))
+		q.Header.Set("Content-Type", "application/json")
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, q)
+		if w.Code != tt.status || calls != map[bool]int{true: 1, false: 0}[tt.status == 200] {
+			t.Fatalf("status %d calls%d body%s", w.Code, calls, tt.body)
+		}
+	}
+	for _, err := range []error{torrstor.ErrInvalidBackgroundRequest, torrstor.ErrBackgroundLimit} {
+		r := gin.New()
+		r.POST("/playback/background", func(c *gin.Context) {
+			handlePlaybackBackground(c, func(playbackBackgroundRequest) error { return err })
+		})
+		q := httptest.NewRequest("POST", "/playback/background", strings.NewReader(valid))
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, q)
+		want := 400
+		if err == torrstor.ErrBackgroundLimit {
+			want = 429
+		}
+		if w.Code != want {
+			t.Fatalf("status%d for%v", w.Code, err)
+		}
+	}
+}
