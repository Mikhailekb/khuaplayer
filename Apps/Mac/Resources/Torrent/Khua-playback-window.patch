+	const piece = int64(64 << 10)
+	const pieces = 16
+	gin.SetMode(gin.TestMode)
+	// Background tracker/watchdog goroutines retain the process globals, so keep
+	// this isolated test package's configuration alive until process exit.
+	config.Args = &config.ExecArgs{}
+	config.BTsets = &config.BTSets{CacheSize: 8 * piece, TorrentDisconnectTimeout: 1, DisableTCP: true, DisableUTP: true, DisableDHT: true, DisablePEX: true, DisableUPNP: true, DisableUpload: true, ConnectionsLimit: 1}
+	config.PubIPv4 = "203.0.113.1"
+	config.HttpAuth = true
+	bt := torr.NewBTS()
+	if err := bt.Connect(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(bt.Disconnect)
+	info := metainfo.Info{Name: "paused.mkv", Length: pieces * piece, PieceLength: piece}
+	payloads := make([][]byte, pieces)
+	for id := range payloads {
+		payloads[id] = bytes.Repeat([]byte{byte(id + 1)}, int(piece))
+		sum := sha1.Sum(payloads[id])
+		info.Pieces = append(info.Pieces, sum[:]...)
+	}
+	mi := metainfo.MetaInfo{InfoBytes: bencode.MustMarshal(info)}
+	tor, err := torr.NewTorrent(&torrent.TorrentSpec{InfoHash: mi.HashInfoBytes(), InfoBytes: mi.InfoBytes}, bt)
+	if err != nil || !tor.GotInfo() {
+		t.Fatalf("new torrent: %v", err)
+	}
+	cache := tor.GetCache()
+	router := gin.New()
+	router.Use(auth.BasicAuth(gin.Accounts{"test": "private"}))
+	SetupRoute(router)
+	server := httptest.NewServer(router)
+	t.Cleanup(server.Close)
+	client := server.Client()
+	client.Timeout = 5 * time.Second
+	post := func(body string, status int) torrstor.PlaybackWindow {
+		t.Helper()
+		req, err := http.NewRequest(http.MethodPost, server.URL+"/playback/window", bytes.NewBufferString(body))
+		if err != nil {
+			t.Fatal(err)
+		}
+		req.Header.Set("Content-Type", "application/json")
+		req.SetBasicAuth("test", "private")
+		resp, err := client.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer resp.Body.Close()
+		var result torrstor.PlaybackWindow
+		if resp.StatusCode != status {
+			t.Fatalf("window status %d, want %d", resp.StatusCode, status)
+		}
+		if status == http.StatusOK {
+			if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
+				t.Fatal(err)
+			}
+		}
+		return result
+	}
+	update := func(revision int, current int64) torrstor.PlaybackWindow {
+		return post(fmt.Sprintf(`{"hash":%q,"file_index":1,"consumer":"paused","revision":%d,"lower":%d,"current":%d,"upper":%d}`, mi.HashInfoBytes().HexString(), revision, 4*piece, current, info.Length), http.StatusOK)
+	}
+	initial := update(1, 6*piece+32)
+	if initial.Lower != 4*piece || initial.Upper != 12*piece {
+		t.Fatalf("initial window %+v", initial)
+	}
+	for id := 4; id < 12; id++ {
+		backing := cache.Piece(info.Piece(id))
+		if n, err := backing.WriteAt(payloads[id], 0); err != nil || n != int(piece) {
+			t.Fatalf("seed piece %d: %d %v", id, n, err)
+		}
+		if err := backing.MarkComplete(); err != nil {
+			t.Fatal(err)
+		}
+		tor.Torrent.Piece(id).VerifyData()
+	}
+	check := func() {
+		t.Helper()
+		state := cache.GetState()
+		if state.Filled != 8*piece || cache.Readers() != 0 {
+			t.Fatalf("paused filled=%d readers=%d", state.Filled, cache.Readers())
+		}
+		for id := 4; id < 12; id++ {
+			if state.Pieces[id].Size != piece || !state.Pieces[id].Completed {
+				t.Fatalf("resident piece %d lost: %+v", id, state.Pieces[id])
+			}
+			data := make([]byte, piece)
+			if n, err := cache.Piece(info.Piece(id)).ReadAt(data, 0); err != nil || n != int(piece) || !bytes.Equal(data, payloads[id]) {
+				t.Fatalf("piece %d payload changed: %d %v", id, n, err)
+			}
+		}
+	}
+	check()
+	// Longer than both the configured deadline and the watchdog tick, without
+	// any request that could extend Torrent.expiredTime.
+	time.Sleep(2200 * time.Millisecond)
+	check()
+	for _, step := range []struct {
+		revision int
+		current  int64
+	}{{2, 6*piece + 64}, {3, 6*piece + 16}, {4, 6*piece + 33}} {
+		got := update(step.revision, step.current)
+		if got.Lower != initial.Lower || got.Upper != initial.Upper {
+			t.Fatalf("tiny seek changed coverage: %+v", got)
+		}
+		check()
+	}
+	// A delayed older release/update cannot remove the replacement window.
+	post(fmt.Sprintf(`{"hash":%q,"consumer":"paused","revision":2,"remove":true}`, mi.HashInfoBytes().HexString()), http.StatusConflict)
+	check()
+	post(fmt.Sprintf(`{"hash":%q,"consumer":"paused","revision":5,"remove":true}`, mi.HashInfoBytes().HexString()), http.StatusOK)
+	if filled := cache.GetState().Filled; filled != 0 {
+		t.Fatalf("explicit final release retained %d bytes", filled)
+	}
+}
diff --git a/server/web/api/playback_window.go b/server/web/api/playback_window.go
new file mode 100644
--- /dev/null
+++ b/server/web/api/playback_window.go
@@ -0,0 +1,94 @@
+package api
+
+import (
+	"encoding/hex"
+	"errors"
+	"net/http"
+	"regexp"
+
+	"github.com/anacrolix/torrent/metainfo"
+	"github.com/gin-gonic/gin"
+	"server/torr"
+	"server/torr/storage/torrstor"
+)
+
+type playbackWindowRequest struct {
+	Hash      string `json:"hash"`
+	FileIndex int    `json:"file_index"`
+	Consumer  string `json:"consumer"`
+	Lower     *int64 `json:"lower"`
+	Current   *int64 `json:"current"`
+	Upper     *int64 `json:"upper"`
+	Revision  uint64 `json:"revision"`
+	Remove    bool   `json:"remove"`
+}
+
+var playbackConsumerPattern = regexp.MustCompile(`^[A-Za-z0-9_-]{1,128}$`)
+
+// playbackWindow manages retention only; it never requests missing pieces.
+// Offsets are file-relative bytes, with exclusive upper. File indices are the
+// sorted, 1-based IDs used by /play. Managed stream URLs carry
+// ?playback_consumer=<consumer>; ordinary/save URLs keep independent protection.
+func playbackWindow(c *gin.Context) { handlePlaybackWindow(c, applyPlaybackWindow) }
+
+func handlePlaybackWindow(c *gin.Context, apply func(playbackWindowRequest) (torrstor.PlaybackWindow, error)) {
+	var req playbackWindowRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid playback window JSON"})
+		return
+	}
+	hash, err := hex.DecodeString(req.Hash)
+	if err != nil || len(hash) != 20 || (!req.Remove && req.FileIndex <= 0) || !playbackConsumerPattern.MatchString(req.Consumer) || req.Revision == 0 || (!req.Remove && (req.Lower == nil || req.Current == nil || req.Upper == nil || *req.Lower < 0 || *req.Lower > *req.Current || *req.Current < 0 || *req.Upper <= *req.Current)) {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid playback window"})
+		return
+	}
+	result, err := apply(req)
+	if err != nil {
+		status := http.StatusBadRequest
+		if errors.Is(err, torrstor.ErrStalePlaybackRevision) {
+			status = http.StatusConflict
+		}
+		if errors.Is(err, torrstor.ErrPlaybackCacheClosed) || errors.Is(err, errPlaybackNotFound) {
+			status = http.StatusNotFound
+		}
+		c.JSON(status, gin.H{"error": err.Error()})
+		return
+	}
+	c.JSON(http.StatusOK, result)
+}
+
+func applyPlaybackWindow(req playbackWindowRequest) (torrstor.PlaybackWindow, error) {
+	if req.Remove {
+		return torr.RemovePlaybackWindow(metainfo.NewHashFromHex(req.Hash), req.Consumer, req.Revision)
+	}
+	tor := torr.GetTorrent(req.Hash)
+	if tor == nil || tor.Torrent == nil || tor.Info() == nil || tor.GetCache() == nil {
+		return torrstor.PlaybackWindow{}, errPlaybackNotFound
+	}
+	fileOffset, fileLength := int64(0), int64(0)
+	found := false
+	for _, st := range tor.Status().FileStats {
+		if st.Id != req.FileIndex {
+			continue
+		}
+		for _, file := range tor.Files() {
+			if file.Path() == st.Path {
+				fileOffset = file.Offset()
+				fileLength = file.Length()
+				found = true
+				break
+			}
+		}
+		break
+	}
+	if !found {
+		return torrstor.PlaybackWindow{}, errPlaybackNotFound
+	}
+	lower, current, upper := int64(0), int64(0), int64(0)
+	if !req.Remove {
+		lower, current, upper = *req.Lower, *req.Current, *req.Upper
+	}
+	return tor.GetCache().UpdatePlaybackWindow(req.FileIndex, fileOffset, fileLength, req.Consumer, lower, current, upper, req.Revision, req.Remove)
+}
+
+var errPlaybackNotFound = errors.New("torrent cache or file not found")
