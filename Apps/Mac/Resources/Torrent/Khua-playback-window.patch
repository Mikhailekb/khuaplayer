diff --git a/server/web/api/cache_ranges.go b/server/web/api/cache_ranges.go
new file mode 100644
--- /dev/null
+++ b/server/web/api/cache_ranges.go
@@ -0,0 +1,49 @@
+package api
+
+import (
+	"encoding/hex"
+	"errors"
+	"net/http"
+	"server/torr"
+	"server/torr/storage/torrstor"
+)
+
+import "github.com/gin-gonic/gin"
+
+type fileCacheRequest struct {
+	Hash      string `json:"hash"`
+	FileIndex int    `json:"file_index"`
+}
+
+func playbackCache(c *gin.Context) { handlePlaybackCache(c, applyPlaybackCache) }
+
+func handlePlaybackCache(c *gin.Context, apply func(fileCacheRequest) (torrstor.FileCacheSnapshot, error)) {
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 2048)
+	var req fileCacheRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid cache snapshot JSON"})
+		return
+	}
+	hash, err := hex.DecodeString(req.Hash)
+	if err != nil || len(hash) != 20 || req.FileIndex <= 0 {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid cache snapshot file"})
+		return
+	}
+	result, err := apply(req)
+	if err != nil {
+		status := http.StatusBadRequest
+		if errors.Is(err, torrstor.ErrPlaybackCacheClosed) || errors.Is(err, errPlaybackNotFound) || errors.Is(err, torr.ErrCachedTorrentNotFound) {
+			status = http.StatusNotFound
+		}
+		if errors.Is(err, torrstor.ErrCacheSnapshotTooFragmented) {
+			status = http.StatusRequestEntityTooLarge
+		}
+		c.JSON(status, gin.H{"error": err.Error()})
+		return
+	}
+	c.JSON(http.StatusOK, result)
+}
+
+func applyPlaybackCache(req fileCacheRequest) (torrstor.FileCacheSnapshot, error) {
+	return torr.SnapshotFileCache(req.Hash, req.FileIndex)
+}
