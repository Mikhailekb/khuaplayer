# Build products (the root-level .app remains available locally but is not committed)
.build/
build/
# Numbered copies created by Finder's "Keep Both" action (for example,
# Khua 2.app). Unregister them with lsregister before deletion to avoid
# duplicate entries in the Finder "Open With" menu.
Khua*.app/
Khua*.dmg
Khua*.zip
Kinolet*.app/
Kinolet*.dmg
Kinolet*.zip
Кинолёт*.app/
*.dSYM/
*.xcarchive/
/dist/

# Apps/Mac/KhuaPlayer.xcodeproj is generated from Apps/Mac/project.yml.
# Future generated product projects are ignored by the same rule.
*.xcodeproj/

# Header generated at build time by Scripts/gen_shader_header.py.
BuildGenerated/

# Self-built FFmpeg sources and artifacts; Scripts/build_ffmpeg_min.sh rebuilds them.
ThirdParty/FFmpeg-n*/
ThirdParty/ffmpeg-n*.tar.gz
ThirdParty/ffmpeg-min/
ThirdParty/dav1d-*/
ThirdParty/speex-min/
ThirdParty/downloads/

# Regenerable or downloadable test media.
TestMedia/

# Compiled benchmark probes; their runner builds them on first use.
Scripts/bench/winquery
Scripts/bench/session
Scripts/bench/avbaseline
Scripts/bench/AVBaseline.app/
__pycache__/

# System and temporary files.
.DS_Store
.claude/
.wrangler/
*.log
/tmp/
BenchResults/
ThirdParty/subtitles-build/
ThirdParty/subtitles-min/
# Self-built Sparkle artifacts; Scripts/build_sparkle.sh recreates them.
ThirdParty/sparkle-min/
