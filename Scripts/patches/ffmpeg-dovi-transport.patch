+
+/* Preserve EL configuration independently of the BL extradata, using the
+ * public dictionary side-data format (no AVCodecParameters ABI extension).
+ * A small, versioned key is consumed by the player's DV decoder. */
+int ff_isom_parse_hvce(AVStream *st, const uint8_t *data, size_t size)
+{
+    static const char hex[] = "0123456789abcdef";
+    AVDictionary *dict = NULL;
+    const AVPacketSideData *old;
+    uint8_t *packed;
+    char *value;
+    size_t packed_size;
+    int ret;
+    if (size < 23 || size > 65536 || data[0] != 1)
+        return 0; /* invalid optional EL configuration leaves the BL usable */
+    value = av_malloc(size * 2 + 1);
+    if (!value)
+        return AVERROR(ENOMEM);
+    for (size_t i = 0; i < size; i++) {
+        value[2*i] = hex[data[i] >> 4];
+        value[2*i+1] = hex[data[i] & 15];
+    }
+    value[size * 2] = 0;
+    old = av_packet_side_data_get(st->codecpar->coded_side_data,
+                                  st->codecpar->nb_coded_side_data, AV_PKT_DATA_STRINGS_METADATA);
+    if (old && (ret = av_packet_unpack_dictionary(old->data, old->size, &dict)) < 0) {
+        av_free(value);
+        av_dict_free(&dict);
+        return ret;
+    }
+    ret = av_dict_set(&dict, "sp.dovi.el_config.v1", value, AV_DICT_DONT_STRDUP_VAL);
+    if (ret < 0) {
+        av_dict_free(&dict);
+        return ret;
+    }
+    packed = av_packet_pack_dictionary(dict, &packed_size);
+    av_dict_free(&dict);
+    if (!packed)
+        return AVERROR(ENOMEM);
+    if (!av_packet_side_data_add(&st->codecpar->coded_side_data, &st->codecpar->nb_coded_side_data,
+                                 AV_PKT_DATA_STRINGS_METADATA, packed, packed_size, 0)) {
+        av_free(packed);
+        return AVERROR(ENOMEM);
+    }
+    return 0;
+}
 
