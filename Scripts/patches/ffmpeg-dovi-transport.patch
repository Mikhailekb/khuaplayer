+/* DV enhancement track explicitly references its base track through vdep. */
+static int mov_read_vdep(MOVContext *c, AVIOContext *pb, MOVAtom atom)
+{
+    AVStream *st;
+    if (c->fc->nb_streams < 1 || atom.size != 4)
+        return 0;
+    st = c->fc->streams[c->fc->nb_streams - 1];
+    return av_dict_set_int(&st->metadata, "sp.dovi.base_id", avio_rb32(pb), 0);
+}
+
+static int mov_read_hvce(MOVContext *c, AVIOContext *pb, MOVAtom atom)
+{
+    uint8_t *buf;
+    int ret;
+    if (c->fc->nb_streams < 1 || atom.size < 23 || atom.size > 65536)
+        return 0;
+    buf = av_malloc(atom.size);
+    if (!buf)
+        return AVERROR(ENOMEM);
+    ret = ffio_read_size(pb, buf, atom.size);
+    if (ret >= 0)
+        ret = ff_isom_parse_hvce(c->fc->streams[c->fc->nb_streams - 1], buf, atom.size);
+    av_free(buf);
+    return ret;
+}
